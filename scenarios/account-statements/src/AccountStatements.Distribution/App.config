<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <connectionStrings>
    <add name="AccountStatements" connectionString="Data Source=sql01.corp.local;Initial Catalog=AccountStatements;Integrated Security=SSPI;Application Name=Statement Distribution" providerName="System.Data.SqlClient" />
  </connectionStrings>
  <appSettings>
    <add key="PollSeconds" value="60" />
    <add key="LeaseMinutes" value="90" />
    <add key="MaxSubscriptionsPerPoll" value="3" />
    <!-- Every distributed document is copied here: <ArchiveRoot>\yyyy\MM\<file>. Retries resend from the archive copy. -->
    <add key="ArchiveRoot" value="\\files01.corp.local\StatementArchive$" />
    <!-- Default share for statement runs when the subscription has no share path: Customers\<drop folder> and Print\yyyyMM below it. -->
    <add key="StatementShareRoot" value="\\files01.corp.local\Statements$" />
    <add key="SmtpHost" value="smtp.corp.local" />
    <add key="SmtpPort" value="25" />
    <add key="SmtpEnableSsl" value="false" />
    <add key="MailFrom" value="Woodgrove Leasing &lt;receivables@woodgrove-leasing.fi&gt;" />
    <add key="ReplyTo" value="receivables@woodgrove-leasing.fi" />
    <!-- Test systems: send every customer e-mail to this address instead of the customer. Leave empty in production. -->
    <add key="RedirectCustomerMailTo" value="" />
    <add key="PrintRoomNotify" value="printroom@woodgrove-leasing.fi" />
    <add key="PrintDuplex" value="true" />
    <add key="LogFolder" value="D:\AccountStatements\Logs" />
    <add key="TempFolder" value="D:\AccountStatements\Work" />
  </appSettings>
  <system.net>
    <mailSettings>
      <smtp deliveryMethod="Network">
        <network host="smtp.corp.local" port="25" defaultCredentials="true" />
      </smtp>
    </mailSettings>
  </system.net>
  <system.diagnostics>
    <trace autoflush="true" />
  </system.diagnostics>
</configuration>
