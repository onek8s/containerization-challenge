  <Code>' Woodgrove Leasing document texts. Language codes: fi-FI, sv-SE / sv-FI, anything else is English.
Public Function LangIndex(ByVal lang As String) As Integer
    If lang Is Nothing Then Return 0
    If lang.StartsWith("fi", StringComparison.OrdinalIgnoreCase) Then Return 1
    If lang.StartsWith("sv", StringComparison.OrdinalIgnoreCase) Then Return 2
    Return 0
End Function
Public Function Pick(ByVal lang As String, ByVal en As String, ByVal fi As String, ByVal sv As String) As String
    Select Case LangIndex(lang)
        Case 1
            Return fi
        Case 2
            Return sv
        Case Else
            Return en
    End Select
End Function
Public Function T(ByVal key As String, ByVal lang As String) As String
    Select Case key
        Case "Title"
            Return Pick(lang, "Account statement", "Tiliote", "Kontoutdrag")
        Case "StatementNo"
            Return Pick(lang, "Statement no.", "Tiliotteen nro", "Kontoutdrag nr")
        Case "StatementDate"
            Return Pick(lang, "Statement date", "Tiliotteen päivä", "Datum")
        Case "Period"
            Return Pick(lang, "Period", "Jakso", "Period")
        Case "CustomerNo"
            Return Pick(lang, "Customer no.", "Asiakasnumero", "Kundnummer")
        Case "Currency"
            Return Pick(lang, "Currency", "Valuutta", "Valuta")
        Case "Date"
            Return Pick(lang, "Date", "Päivä", "Datum")
        Case "Type"
            Return Pick(lang, "Type", "Laji", "Typ")
        Case "Document"
            Return Pick(lang, "Document", "Tosite", "Dokument")
        Case "Contract"
            Return Pick(lang, "Contract", "Sopimus", "Avtal")
        Case "Description"
            Return Pick(lang, "Description", "Selite", "Beskrivning")
        Case "Due"
            Return Pick(lang, "Due date", "Eräpäivä", "Förfallodag")
        Case "Debit"
            Return Pick(lang, "Debit", "Veloitus", "Debet")
        Case "Credit"
            Return Pick(lang, "Credit", "Hyvitys", "Kredit")
        Case "Balance"
            Return Pick(lang, "Balance", "Saldo", "Saldo")
        Case "Opening"
            Return Pick(lang, "Opening balance", "Alkusaldo", "Ingående saldo")
        Case "Closing"
            Return Pick(lang, "Closing balance", "Loppusaldo", "Utgående saldo")
        Case "Totals"
            Return Pick(lang, "Period totals", "Jakson summat", "Periodens summa")
        Case "OpenItems"
            Return Pick(lang, "Open items on the statement date", "Avoimet erät tiliotteen päivänä", "Öppna poster per kontoutdragsdatum")
        Case "DaysOverdue"
            Return Pick(lang, "Days overdue", "Päiviä myöhässä", "Dagar förfallna")
        Case "Original"
            Return Pick(lang, "Original amount", "Alkuperäinen", "Ursprungligt belopp")
        Case "Open"
            Return Pick(lang, "Open amount", "Avoinna", "Öppet belopp")
        Case "Aging"
            Return Pick(lang, "Aging", "Ikäjakauma", "Åldersfördelning")
        Case "NotDue"
            Return Pick(lang, "Not due", "Ei erääntynyt", "Ej förfallet")
        Case "Unallocated"
            Return Pick(lang, "Unallocated", "Kohdistamaton", "Ej avräknat")
        Case "Total"
            Return Pick(lang, "Total", "Yhteensä", "Totalt")
        Case "PayTitle"
            Return Pick(lang, "Payment instructions", "Maksuohje", "Betalningsinstruktioner")
        Case "AmountDue"
            Return Pick(lang, "Amount due", "Maksettava", "Att betala")
        Case "Reference"
            Return Pick(lang, "Reference", "Viitenumero", "Referensnummer")
        Case "Recipient"
            Return Pick(lang, "Recipient", "Saaja", "Mottagare")
        Case "Account"
            Return Pick(lang, "Account (IBAN)", "Tilinumero (IBAN)", "Konto (IBAN)")
        Case "Barcode"
            Return Pick(lang, "Bank barcode", "Virtuaaliviivakoodi", "Virtuell streckkod")
        Case "Page"
            Return Pick(lang, "Page", "Sivu", "Sida")
        Case "NoOpenItems"
            Return Pick(lang, "No open items.", "Ei avoimia eriä.", "Inga öppna poster.")
        Case "NoLines"
            Return Pick(lang, "No transactions in the period.", "Jaksolla ei tapahtumia.", "Inga transaktioner under perioden.")
        Case "InvoiceTitle"
            Return Pick(lang, "Invoice", "Lasku", "Faktura")
        Case "Copy"
            Return Pick(lang, "COPY", "KOPIO", "KOPIA")
        Case "InvoiceNo"
            Return Pick(lang, "Invoice no.", "Laskun numero", "Fakturanummer")
        Case "InvoiceDate"
            Return Pick(lang, "Invoice date", "Laskun päivä", "Fakturadatum")
        Case "YourRef"
            Return Pick(lang, "Your reference", "Viitteenne", "Er referens")
        Case "Qty"
            Return Pick(lang, "Qty", "Määrä", "Antal")
        Case "UnitPrice"
            Return Pick(lang, "Unit price", "À-hinta", "À-pris")
        Case "VatPct"
            Return Pick(lang, "VAT %", "ALV %", "Moms %")
        Case "Net"
            Return Pick(lang, "Net", "Veroton", "Netto")
        Case "Vat"
            Return Pick(lang, "VAT", "ALV", "Moms")
        Case "TotalInc"
            Return Pick(lang, "Total incl. VAT", "Yhteensä sis. ALV", "Totalt inkl. moms")
        Case "ReverseCharge"
            Return Pick(lang, "VAT 0 %, reverse charge (Art. 196 VAT Directive)", "ALV 0 %, käännetty verovelvollisuus", "Moms 0 %, omvänd skattskyldighet")
        Case "PenaltyInterest"
            Return Pick(lang, "Late payment interest according to the Interest Act.", "Viivästyskorko korkolain mukaan.", "Dröjsmålsränta enligt räntelagen.")
        Case "BusinessId"
            Return Pick(lang, "Business ID", "Y-tunnus", "FO-nummer")
        Case "VatNo"
            Return Pick(lang, "VAT no.", "ALV-tunniste", "Momsnummer")
        Case Else
            Return key
    End Select
End Function
Public Function EntryTypeText(ByVal entryType As String, ByVal lang As String) As String
    Select Case entryType
        Case "INV"
            Return Pick(lang, "Invoice", "Lasku", "Faktura")
        Case "CRN"
            Return Pick(lang, "Credit note", "Hyvityslasku", "Kreditnota")
        Case "PAY"
            Return Pick(lang, "Payment", "Suoritus", "Betalning")
        Case "ADJ"
            Return Pick(lang, "Adjustment", "Oikaisu", "Justering")
        Case "INT"
            Return Pick(lang, "Interest", "Viivästyskorko", "Dröjsmålsränta")
        Case Else
            Return entryType
    End Select
End Function
Public Function BucketText(ByVal bucket As String, ByVal lang As String) As String
    Select Case bucket
        Case "NOTDUE"
            Return Pick(lang, "Not due", "Ei erääntynyt", "Ej förfallet")
        Case "1-30"
            Return Pick(lang, "1-30 days", "1-30 pv", "1-30 dagar")
        Case "31-60"
            Return Pick(lang, "31-60 days", "31-60 pv", "31-60 dagar")
        Case "61-90"
            Return Pick(lang, "61-90 days", "61-90 pv", "61-90 dagar")
        Case "90+"
            Return Pick(lang, "Over 90 days", "Yli 90 pv", "Över 90 dagar")
        Case "UNALLOC"
            Return Pick(lang, "Unallocated", "Kohdistamaton", "Ej avräknat")
        Case Else
            Return bucket
    End Select
End Function
Public Function DunningText(ByVal level As Integer, ByVal lang As String) As String
    Select Case level
        Case 1
            Return Pick(lang, "Our records show overdue items on your account. If you have already paid, please disregard this notice.", "Tilillänne on erääntyneitä eriä. Jos olette jo maksaneet, tämä ilmoitus on aiheeton.", "Enligt våra uppgifter har ert konto förfallna poster. Om ni redan har betalat kan ni bortse från detta meddelande.")
        Case 2
            Return Pick(lang, "Payment reminder: please pay the overdue amount within 7 days. Late payment interest is charged on overdue items.", "Maksumuistutus: pyydämme maksamaan erääntyneen summan 7 päivän kuluessa. Erääntyneistä eristä peritään viivästyskorkoa.", "Betalningspåminnelse: vänligen betala det förfallna beloppet inom 7 dagar. Dröjsmålsränta debiteras på förfallna poster.")
        Case 3
            Return Pick(lang, "Final reminder: the overdue amount will be transferred to debt collection unless paid within 7 days. New contracts are on hold.", "Viimeinen muistutus: erääntynyt summa siirretään perintään, ellei sitä makseta 7 päivän kuluessa. Uudet sopimukset ovat pidossa.", "Sista påminnelse: det förfallna beloppet överlämnas till inkasso om det inte betalas inom 7 dagar. Nya avtal är spärrade.")
        Case Else
            Return ""
    End Select
End Function
Public Function DunningColor(ByVal level As Integer) As String
    Select Case level
        Case 3
            Return "#C00000"
        Case 2
            Return "#C55A11"
        Case Else
            Return "#1F3864"
    End Select
End Function
Public Function FormatReference(ByVal reference As String) As String
    If String.IsNullOrEmpty(reference) Then Return ""
    Dim r As String = reference.Replace(" ", "")
    If r.StartsWith("RF") Then Return r
    Dim sb As New System.Text.StringBuilder()
    Dim first As Integer = r.Length Mod 5
    If first &gt; 0 Then sb.Append(r.Substring(0, first))
    Dim i As Integer = first
    While i &lt; r.Length
        If sb.Length &gt; 0 Then sb.Append(" ")
        sb.Append(r.Substring(i, 5))
        i += 5
    End While
    Return sb.ToString()
End Function
</Code>
