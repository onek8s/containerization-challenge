  <ReportSections>
    <ReportSection>
      <Body>
        <ReportItems>
          <Textbox Name="Title">
            <CanGrow>true</CanGrow>
            <KeepTogether>true</KeepTogether>
            <Paragraphs>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>Lease portfolio summary</Value>
                    <Style>
                      <FontFamily>Segoe UI</FontFamily>
                      <FontSize>14pt</FontSize>
                      <FontWeight>Bold</FontWeight>
                      <Color>#1F3864</Color>
                    </Style>
                  </TextRun>
                </TextRuns>
                <Style/>
              </Paragraph>
            </Paragraphs>
            <rd:DefaultName>Title</rd:DefaultName>
            <Top>0cm</Top>
            <Left>0cm</Left>
            <Height>0.8cm</Height>
            <Width>12cm</Width>
            <Style>
              <Border>
                <Style>None</Style>
              </Border>
              <PaddingLeft>2pt</PaddingLeft>
              <PaddingRight>2pt</PaddingRight>
              <PaddingTop>2pt</PaddingTop>
              <PaddingBottom>2pt</PaddingBottom>
            </Style>
          </Textbox>
          <Textbox Name="SubTitle">
            <CanGrow>true</CanGrow>
            <KeepTogether>true</KeepTogether>
            <Paragraphs>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>="Active contracts as of " &amp; Format(Parameters!AsOf.Value, "d")</Value>
                    <Style>
                      <FontFamily>Segoe UI</FontFamily>
                      <Color>#595959</Color>
                      <FontSize>8pt</FontSize>
                    </Style>
                  </TextRun>
                </TextRuns>
                <Style/>
              </Paragraph>
            </Paragraphs>
            <rd:DefaultName>SubTitle</rd:DefaultName>
            <Top>0.8cm</Top>
            <Left>0cm</Left>
            <Height>0.5cm</Height>
            <Width>12cm</Width>
            <Style>
              <Border>
                <Style>None</Style>
              </Border>
              <PaddingLeft>2pt</PaddingLeft>
              <PaddingRight>2pt</PaddingRight>
              <PaddingTop>2pt</PaddingTop>
              <PaddingBottom>2pt</PaddingBottom>
            </Style>
          </Textbox>
          <Chart Name="RentByCategory">
            <ChartCategoryHierarchy>
              <ChartMembers>
                <ChartMember>
                  <Group Name="ChartCategory">
                    <GroupExpressions>
                      <GroupExpression>=Fields!AssetCategory.Value</GroupExpression>
                    </GroupExpressions>
                  </Group>
                  <SortExpressions>
                    <SortExpression>
                      <Value>=Sum(Fields!RemainingRent.Value)</Value>
                      <Direction>Descending</Direction>
                    </SortExpression>
                  </SortExpressions>
                  <Label>=Fields!AssetCategory.Value</Label>
                </ChartMember>
              </ChartMembers>
            </ChartCategoryHierarchy>
            <ChartSeriesHierarchy>
              <ChartMembers>
                <ChartMember>
                  <Label>Remaining rent</Label>
                </ChartMember>
                <ChartMember>
                  <Label>Monthly rent x 12</Label>
                </ChartMember>
              </ChartMembers>
            </ChartSeriesHierarchy>
            <ChartData>
              <ChartSeriesCollection>
                <ChartSeries Name="RemainingRent">
                  <ChartDataPoints>
                    <ChartDataPoint>
                      <ChartDataPointValues>
                        <Y>=Sum(Fields!RemainingRent.Value)</Y>
                      </ChartDataPointValues>
                      <ChartDataLabel>
                        <Style>
                          <FontFamily>Segoe UI</FontFamily>
                          <FontSize>7pt</FontSize>
                          <Format>#,0,"k"</Format>
                        </Style>
                        <UseValueAsLabel>true</UseValueAsLabel>
                        <Visible>true</Visible>
                      </ChartDataLabel>
                      <Style>
                        <Color>#2E75B6</Color>
                      </Style>
                      <ChartMarker>
                        <Style/>
                      </ChartMarker>
                      <DataElementOutput>Output</DataElementOutput>
                    </ChartDataPoint>
                  </ChartDataPoints>
                  <Type>Bar</Type>
                  <Style/>
                  <ChartEmptyPoints>
                    <Style/>
                    <ChartMarker>
                      <Style/>
                    </ChartMarker>
                    <ChartDataLabel>
                      <Style/>
                    </ChartDataLabel>
                  </ChartEmptyPoints>
                  <ValueAxisName>Primary</ValueAxisName>
                  <CategoryAxisName>Primary</CategoryAxisName>
                  <ChartSmartLabel>
                    <CalloutLineColor>Black</CalloutLineColor>
                    <MinMovingDistance>0pt</MinMovingDistance>
                  </ChartSmartLabel>
                </ChartSeries>
                <ChartSeries Name="AnnualRent">
                  <ChartDataPoints>
                    <ChartDataPoint>
                      <ChartDataPointValues>
                        <Y>=Sum(Fields!MonthlyRent.Value) * 12</Y>
                      </ChartDataPointValues>
                      <ChartDataLabel>
                        <Style/>
                      </ChartDataLabel>
                      <Style>
                        <Color>#A5A5A5</Color>
                      </Style>
                      <ChartMarker>
                        <Style/>
                      </ChartMarker>
                      <DataElementOutput>Output</DataElementOutput>
                    </ChartDataPoint>
                  </ChartDataPoints>
                  <Type>Bar</Type>
                  <Style/>
                  <ChartEmptyPoints>
                    <Style/>
                    <ChartMarker>
                      <Style/>
                    </ChartMarker>
                    <ChartDataLabel>
                      <Style/>
                    </ChartDataLabel>
                  </ChartEmptyPoints>
                  <ValueAxisName>Primary</ValueAxisName>
                  <CategoryAxisName>Primary</CategoryAxisName>
                  <ChartSmartLabel>
                    <CalloutLineColor>Black</CalloutLineColor>
                    <MinMovingDistance>0pt</MinMovingDistance>
                  </ChartSmartLabel>
                </ChartSeries>
              </ChartSeriesCollection>
            </ChartData>
            <ChartAreas>
              <ChartArea Name="Default">
                <ChartCategoryAxes>
                  <ChartAxis Name="Primary">
