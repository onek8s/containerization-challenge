{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "ConnectionStrings": {
    "PolicyChanges": "Server=sql01.corp.local;Database=PolicyChanges;Integrated Security=true;TrustServerCertificate=true"
  },
  "Database": {
    "Provider": "SqlServer",
    "SeedSampleData": false
  },
  "Queue": {
    "LeaseMinutes": 10,
    "MaxAttempts": 4,
    "RetryDelayMinutes": [ 5, 15, 60 ]
  },
  "Desk": {
    "PollSeconds": 10,
    "DesktopWaitSeconds": 30,
    "FlowsPath": "flows",
    "EvidenceRoot": "\\\\files01.corp.local\\PolicyChanges$\\Evidence",
    "LogPath": "%LOCALAPPDATA%\\PolicyChanges\\logs"
  },
  "PolicyDesk": {
    "ExecutablePath": "C:\\Program Files (x86)\\Halcyon\\PolicyDesk 6\\HPDESK.EXE",
    "Arguments": "/env:{Environment} /nosplash",
    "Environment": "PROD",
    "CredentialTarget": "PolicyDesk/PROD",
    "SignInTitle": "PolicyDesk - Sign in",
    "MainWindowTitle": "PolicyDesk 6.* - *",
    "StartupTimeoutSeconds": 90,
    "RestartAfterChanges": 150
  }
}
