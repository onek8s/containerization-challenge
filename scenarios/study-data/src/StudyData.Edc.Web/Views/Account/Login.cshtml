@model LoginModel
@{ ViewData["Title"] = "Sign in"; }
<div class="narrow">
    <h1>Sign in</h1>
    <form method="post">
        <div asp-validation-summary="All" class="validation"></div>
        <input type="hidden" asp-for="ReturnUrl" />
        <label>E-mail <input asp-for="Email" autocomplete="username" /></label>
        <label>Password <input asp-for="Password" autocomplete="current-password" /></label>
        <button type="submit">Sign in</button>
    </form>
    <p class="muted">Accounts are created by Fabrikam after GCP and system training. Forgotten passwords are reset by the study helpdesk.</p>
</div>
