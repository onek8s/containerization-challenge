{
  "ConnectionStrings": {
    "StudyData": "Server=sql01.corp.local;Database=StudyData;Integrated Security=true;TrustServerCertificate=true;Application Name=StudyData.Edc"
  },
  "Edc": {
    "RequireTwoFactor": true,
    "SourceDocumentVault": "\\\\corp.local\\dfs\\StudyData\\SourceDocuments",
    "MaxUploadMegabytes": 40,
    "SessionMinutes": 30
  },
  "Calculation": {
    "Provider": "Excel",
    "WorkbookRoot": "\\\\corp.local\\dfs\\StudyData\\Studies",
    "LocalCache": "C:\\StudyData\\Workbooks",
    "PoolSize": 2
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": { "Microsoft": "Warning", "Microsoft.Hosting.Lifetime": "Information" }
    }
  },
  "Logging": {
    "LogFile": "C:\\StudyData\\Logs\\edc-.log"
  },
  "AllowedHosts": "*"
}
