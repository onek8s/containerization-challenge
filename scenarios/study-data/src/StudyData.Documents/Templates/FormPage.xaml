<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Width="793.7" Height="1122.5" Background="White">
  <Grid.Resources>
    <Style TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Segoe UI" />
      <Setter Property="FontSize" Value="10.5" />
      <Setter Property="Foreground" Value="#202020" />
    </Style>
  </Grid.Resources>
  <Grid.RowDefinitions>
    <RowDefinition Height="Auto" />
    <RowDefinition Height="Auto" />
    <RowDefinition Height="*" />
    <RowDefinition Height="Auto" />
  </Grid.RowDefinitions>

  <!-- Header band -->
  <Border Grid.Row="0" Margin="48,40,48,0" BorderBrush="#1F4E79" BorderThickness="0,0,0,2" Padding="0,0,0,6">
    <Grid>
      <StackPanel>
        <TextBlock Text="{Binding StudyCode}" FontSize="15" FontWeight="SemiBold" Foreground="#1F4E79" />
        <TextBlock Text="{Binding Sponsor}" FontSize="9" Foreground="#606060" />
      </StackPanel>
      <StackPanel HorizontalAlignment="Right">
        <TextBlock Text="{Binding SubjectLine}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" />
        <TextBlock Text="{Binding SiteLine}" FontSize="9" Foreground="#606060" HorizontalAlignment="Right" />
      </StackPanel>
    </Grid>
  </Border>

  <!-- Form title -->
  <Grid Grid.Row="1" Margin="48,18,48,8">
    <StackPanel>
      <TextBlock Text="{Binding FormTitle}" FontSize="14" FontWeight="SemiBold" />
      <TextBlock Text="{Binding VisitTitle}" FontSize="10" Foreground="#606060" />
    </StackPanel>
    <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="#EAF1F8" CornerRadius="3" Padding="8,3">
      <TextBlock Text="{Binding Status}" FontSize="9.5" Foreground="#1F4E79" />
    </Border>
  </Grid>

  <!-- Fields -->
  <Border Grid.Row="2" Margin="48,0,48,0" BorderBrush="#C8D3DE" BorderThickness="1" VerticalAlignment="Top">
    <ItemsControl ItemsSource="{Binding Rows}">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Border BorderBrush="#E3E8EE" BorderThickness="0,0,0,1" Background="{Binding Shade}">
            <Grid Margin="8,5">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80" />
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="44" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="{Binding Code}" FontFamily="Consolas" FontSize="9" Foreground="#707070" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="{Binding Label}" TextWrapping="Wrap" VerticalAlignment="Center" />
              <TextBlock Grid.Column="2" Text="{Binding ValueText}" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
              <TextBlock Grid.Column="3" Text="{Binding Marks}" FontSize="9" Foreground="#9C2B23" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </Border>

  <!-- Footer -->
  <Grid Grid.Row="3" Margin="48,8,48,36">
    <StackPanel>
      <TextBlock Text="{Binding SignatureLine}" FontSize="9" />
      <TextBlock Text="✓ verified against source   ƒ derived from the validated study workbook   ? open query" FontSize="8" Foreground="#808080" />
      <TextBlock Text="{Binding Footer}" FontSize="8" Foreground="#808080" />
    </StackPanel>
    <TextBlock Text="{Binding PageLabel}" FontSize="9" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
  </Grid>
</Grid>
