<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Width="793.7" Height="1122.5" Background="White">
  <Grid.Resources>
    <Style TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Segoe UI" />
      <Setter Property="FontSize" Value="8.5" />
      <Setter Property="Foreground" Value="#202020" />
    </Style>
  </Grid.Resources>
  <Grid.RowDefinitions>
    <RowDefinition Height="Auto" />
    <RowDefinition Height="*" />
    <RowDefinition Height="Auto" />
  </Grid.RowDefinitions>
  <StackPanel Grid.Row="0" Margin="48,40,48,10">
    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" Foreground="#1F4E79" />
    <TextBlock Text="{Binding SubjectLine}" FontSize="10" Foreground="#606060" />
  </StackPanel>
  <ItemsControl Grid.Row="1" Margin="48,0" ItemsSource="{Binding Rows}" VerticalAlignment="Top">
    <ItemsControl.ItemTemplate>
      <DataTemplate>
        <Border BorderBrush="#E3E8EE" BorderThickness="0,0,0,1" Padding="0,3">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="112" />
              <ColumnDefinition Width="140" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding At}" FontFamily="Consolas" />
            <TextBlock Grid.Column="1" Text="{Binding User}" TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Column="2" Text="{Binding Text}" TextWrapping="Wrap" />
          </Grid>
        </Border>
      </DataTemplate>
    </ItemsControl.ItemTemplate>
  </ItemsControl>
  <TextBlock Grid.Row="2" Margin="48,8,48,36" Text="{Binding PageLabel}" HorizontalAlignment="Right" FontSize="9" />
</Grid>
