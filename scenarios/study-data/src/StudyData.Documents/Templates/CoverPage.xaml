<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Width="793.7" Height="1122.5" Background="White">
  <Grid.Resources>
    <Style TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Segoe UI" />
      <Setter Property="Foreground" Value="#202020" />
    </Style>
  </Grid.Resources>
  <StackPanel Margin="72,160,72,0">
    <TextBlock Text="Subject Casebook" FontSize="30" FontWeight="Light" Foreground="#1F4E79" />
    <Rectangle Height="3" Fill="#1F4E79" Margin="0,8,0,24" Width="120" HorizontalAlignment="Left" />
    <TextBlock Text="{Binding StudyCode}" FontSize="18" FontWeight="SemiBold" />
    <TextBlock Text="{Binding StudyTitle}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,32" Foreground="#404040" />
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="170" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="26" />
        <RowDefinition Height="26" />
        <RowDefinition Height="26" />
        <RowDefinition Height="26" />
        <RowDefinition Height="26" />
        <RowDefinition Height="26" />
        <RowDefinition Height="26" />
      </Grid.RowDefinitions>
      <TextBlock Grid.Row="0" Text="Subject" Foreground="#606060" />
      <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SubjectNumber}" FontWeight="SemiBold" />
      <TextBlock Grid.Row="1" Text="Site" Foreground="#606060" />
      <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Site}" />
      <TextBlock Grid.Row="2" Text="Principal investigator" Foreground="#606060" />
      <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Investigator}" />
      <TextBlock Grid.Row="3" Text="Sponsor" Foreground="#606060" />
      <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Sponsor}" />
      <TextBlock Grid.Row="4" Text="Subject status" Foreground="#606060" />
      <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Status}" />
      <TextBlock Grid.Row="5" Text="Randomisation number" Foreground="#606060" />
      <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding RandomisationNumber}" />
      <TextBlock Grid.Row="6" Text="Forms" Foreground="#606060" />
      <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding FormCount}" />
    </Grid>
  </StackPanel>
  <StackPanel VerticalAlignment="Bottom" Margin="72,0,72,56">
    <TextBlock Text="{Binding Generated}" FontSize="9" Foreground="#808080" />
    <TextBlock Text="Confidential. Contains coded subject data only. Arm assignment is not shown." FontSize="9" Foreground="#808080" />
  </StackPanel>
</Grid>
