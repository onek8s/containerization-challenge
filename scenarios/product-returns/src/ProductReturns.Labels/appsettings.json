{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    },
    "EventLog": {
      "LogLevel": {
        "Default": "Information",
        "Microsoft": "Warning"
      }
    }
  },
  "ConnectionStrings": {
    "Returns": "Server=sql01.corp.local;Database=ProductReturns;Integrated Security=true;Application Name=ProductReturns.Labels"
  },
  "Database": {
    "Provider": "SqlServer"
  },
  "Labels": {
    "SharePath": "\\\\files01.corp.local\\Returns$\\Labels",
    "StateFolder": "D:\\ReturnsData\\Labels",
    "PollSeconds": 60,
    "BatchSize": 20,
    "MaxAttempts": 5,
    "DailyQuota": 400
  },
  "Carrier": {
    "Provider": "ParcelLink",
    "BaseUrl": "https://api.parcellink.example/",
    "AccountNumber": "",
    "ApiKeyProtected": "",
    "Proxy": "http://proxy.corp.local:8080",
    "TimeoutSeconds": 30
  },
  "Mail": {
    "SmtpHost": "smtp.corp.local",
    "SmtpPort": 25,
    "UseDefaultCredentials": true,
    "From": "returns@wideworldimporters.example",
    "FromName": "Wide World Importers Returns",
    "TemplateFolder": "Templates",
    "LabelTemplate": "ReturnLabel.html"
  }
}
