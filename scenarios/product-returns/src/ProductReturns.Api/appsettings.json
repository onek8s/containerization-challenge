{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    },
    "EventLog": {
      "LogLevel": {
        "Default": "Information",
        "Microsoft": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Returns": "Server=sql01.corp.local;Database=ProductReturns;Integrated Security=true;Application Name=ProductReturns.Api"
  },
  "Database": {
    "Provider": "SqlServer"
  },
  "Business": {
    "TimeZone": "W. Europe Standard Time"
  },
  "Security": {
    "PortalAccounts": [ "CORP\\svc-returns-web" ],
    "PortalKeyHashes": []
  },
  "CatalogCache": {
    "Folder": "D:\\ReturnsData\\Api\\Cache",
    "RefreshMinutes": 360
  },
  "ReturnPolicy": {
    "DefaultWindowDays": 30,
    "CategoryWindowDays": {
      "Electronics": 14,
      "Furniture": 60
    },
    "NonReturnableCategories": [ "Food", "GiftCards", "Hygiene" ],
    "HolidayFrom": "11-15",
    "HolidayTo": "12-24",
    "HolidayReturnUntil": "01-31",
    "LabelFee": 5.95,
    "UsedRefundShare": 0.5
  }
}
