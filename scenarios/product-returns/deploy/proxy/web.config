<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS site "returns" on returns.corp.local. No application code runs here: requests are forwarded
  with URL Rewrite + ARR to the portal (returns-web) and, for the warehouse scanners, to the API (returns-api).
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="Maintenance" stopProcessing="true">
          <match url=".*" />
          <conditions>
            <add input="{DOCUMENT_ROOT}\maintenance.on" matchType="IsFile" />
            <add input="{URL}" pattern="^/maintenance\.htm$" negate="true" />
          </conditions>
          <action type="Rewrite" url="maintenance.htm" />
        </rule>
        <rule name="HTTPS" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="off" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
        </rule>
        <rule name="Old return form" stopProcessing="true">
          <match url="^returns/(start|new)(\.aspx)?$" ignoreCase="true" />
          <action type="Redirect" url="/" redirectType="Permanent" />
        </rule>
        <rule name="Old status page" stopProcessing="true">
          <match url="^(rma|returns/status)(\.aspx)?$" ignoreCase="true" />
          <action type="Redirect" url="/Return/Status" redirectType="Permanent" />
        </rule>
        <rule name="Scanner API" stopProcessing="true">
          <match url="^api/receiving/(.*)" />
          <serverVariables>
            <set name="HTTP_X_FORWARDED_PROTO" value="https" />
            <set name="HTTP_X_FORWARDED_HOST" value="{HTTP_HOST}" />
          </serverVariables>
          <action type="Rewrite" url="https://returns-api.corp.local:5021/api/receiving/{R:1}" />
        </rule>
        <rule name="Block other API calls" stopProcessing="true">
          <match url="^api/" />
          <action type="CustomResponse" statusCode="404" statusReason="Not Found" statusDescription="Not Found" />
        </rule>
        <rule name="Portal" stopProcessing="true">
          <match url="(.*)" />
          <serverVariables>
            <set name="HTTP_X_FORWARDED_PROTO" value="https" />
            <set name="HTTP_X_FORWARDED_HOST" value="{HTTP_HOST}" />
          </serverVariables>
          <action type="Rewrite" url="https://returns-web.corp.local:5011/{R:1}" />
        </rule>
      </rules>
      <outboundRules>
        <rule name="Portal redirects">
          <match serverVariable="RESPONSE_Location" pattern="^https?://returns-web\.corp\.local:5011/(.*)" />
          <action type="Rewrite" value="https://{HTTP_HOST}/{R:1}" />
        </rule>
      </outboundRules>
    </rewrite>
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="Strict-Transport-Security" value="max-age=31536000" />
      </customHeaders>
    </httpProtocol>
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="10485760" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
