<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="OrderHub">
      <DataSourceReference>OrderHub</DataSourceReference>
      <rd:DataSourceID>5b1c8b0e-2f4d-4c55-9a51-7f0e4b8f2d11</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="InvoiceLines">
      <Query>
        <DataSourceName>OrderHub</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@OrderNumber">
            <Value>=Parameters!OrderNumber.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT OrderId, OrderNumber, InvoiceNumber, InvoicedUtc, ShippedUtc, Channel, CustomerReference, CustomerName, CustomerEmail,
       ShipName, ShipStreet, ShipStreet2, ShipPostalCode, ShipCity, ShipCountry, Currency, ShippingAmount, Carrier, TrackingNumber,
       LineNumber, Sku, Description, Quantity, UnitPrice, LineAmount
FROM hub.InvoiceLines
WHERE OrderNumber = @OrderNumber
ORDER BY LineNumber</CommandText>
      </Query>
      <Fields>
        <Field Name="OrderId">
          <DataField>OrderId</DataField>
        </Field>
        <Field Name="OrderNumber">
          <DataField>OrderNumber</DataField>
        </Field>
        <Field Name="InvoiceNumber">
          <DataField>InvoiceNumber</DataField>
        </Field>
        <Field Name="InvoicedUtc">
          <DataField>InvoicedUtc</DataField>
        </Field>
        <Field Name="ShippedUtc">
