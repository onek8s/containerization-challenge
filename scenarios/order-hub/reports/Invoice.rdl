          <Textbox Name="Delivery">
            <CanGrow>true</CanGrow>
            <KeepTogether>true</KeepTogether>
            <Paragraphs>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>=First(Fields!ShipName.Value) &amp; vbCrLf &amp; First(Fields!ShipStreet.Value) &amp; IIf(IsNothing(First(Fields!ShipStreet2.Value)), "", vbCrLf &amp; First(Fields!ShipStreet2.Value)) &amp; vbCrLf &amp; First(Fields!ShipPostalCode.Value) &amp; " " &amp; First(Fields!ShipCity.Value) &amp; vbCrLf &amp; First(Fields!ShipCountry.Value)</Value>
                    <Style>
