<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
  </startup>
  <appSettings>
    <add key="RabbitMq.Host" value="rabbitmq://mq.corp.local/orderhub" />
    <add key="RabbitMq.Username" value="orderhub-intake" />
    <add key="RabbitMq.Password" value="" />

    <add key="Intake.ListenUrl" value="http://+:8085/" />
    <add key="Webshop.WebhookSecret" value="" />

    <add key="Marketplace.Enabled" value="true" />
    <add key="Marketplace.Sftp.Host" value="sftp.corp.local" />
    <add key="Marketplace.Sftp.Port" value="22" />
    <add key="Marketplace.Sftp.Username" value="trailmarket" />
    <add key="Marketplace.Sftp.Password" value="" />
    <add key="Marketplace.Sftp.PrivateKeyFile" value="" />
    <add key="Marketplace.Sftp.HostKeyFingerprint" value="" />
    <add key="Marketplace.ExportDirectory" value="/orders" />
    <add key="Marketplace.PollInterval" value="00:02:00" />

    <add key="serilog:minimum-level" value="Information" />
    <add key="serilog:using:Console" value="Serilog.Sinks.Console" />
    <add key="serilog:write-to:Console" />
    <add key="serilog:using:File" value="Serilog.Sinks.File" />
    <add key="serilog:write-to:File.path" value="C:\OrderHub\Logs\intake-.log" />
    <add key="serilog:write-to:File.rollingInterval" value="Day" />
    <add key="serilog:write-to:File.retainedFileCountLimit" value="30" />
    <add key="serilog:write-to:File.outputTemplate" value="{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}" />
  </appSettings>
</configuration>
