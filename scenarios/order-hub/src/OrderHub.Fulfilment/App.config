<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
  </startup>
  <connectionStrings>
    <add name="OrderHub" connectionString="Server=sql01.corp.local;Database=OrderHub;User ID=orderhub_svc;Password=;Application Name=OrderHub.Fulfilment" providerName="System.Data.SqlClient" />
  </connectionStrings>
  <appSettings>
    <add key="RabbitMq.Host" value="rabbitmq://mq.corp.local/orderhub" />
    <add key="RabbitMq.Username" value="orderhub-fulfilment" />
    <add key="RabbitMq.Password" value="" />

    <add key="Orders.ShipToCountries" value="FI,SE,NO,DK,EE,DE" />
    <add key="Orders.Currencies" value="EUR,SEK,NOK,DKK" />

    <add key="Warehouse.ClientCode" value="LITWARE" />
    <add key="Warehouse.Sftp.Host" value="sftp.corp.local" />
    <add key="Warehouse.Sftp.Port" value="22" />
    <add key="Warehouse.Sftp.Username" value="adatum-wms" />
    <add key="Warehouse.Sftp.Password" value="" />
    <add key="Warehouse.Sftp.PrivateKeyFile" value="C:\OrderHub\Keys\adatum-wms.key" />
    <add key="Warehouse.Sftp.HostKeyFingerprint" value="" />
    <add key="Warehouse.InDirectory" value="/in" />
    <add key="Warehouse.OutDirectory" value="/out" />
    <add key="Warehouse.PollInterval" value="00:05:00" />

    <add key="serilog:minimum-level" value="Information" />
    <add key="serilog:using:Console" value="Serilog.Sinks.Console" />
    <add key="serilog:write-to:Console" />
    <add key="serilog:using:File" value="Serilog.Sinks.File" />
    <add key="serilog:write-to:File.path" value="C:\OrderHub\Logs\fulfilment-.log" />
    <add key="serilog:write-to:File.rollingInterval" value="Day" />
    <add key="serilog:write-to:File.retainedFileCountLimit" value="30" />
    <add key="serilog:write-to:File.outputTemplate" value="{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}" />
  </appSettings>
</configuration>
