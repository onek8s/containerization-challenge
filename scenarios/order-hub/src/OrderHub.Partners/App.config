<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
  </startup>
  <connectionStrings>
    <add name="OrderHub" connectionString="Server=sql01.corp.local;Database=OrderHub;User ID=orderhub_svc;Password=;Application Name=OrderHub.Partners" providerName="System.Data.SqlClient" />
  </connectionStrings>
  <appSettings>
    <add key="RabbitMq.Host" value="rabbitmq://mq.corp.local/orderhub" />
    <add key="RabbitMq.Username" value="orderhub-partners" />
    <add key="RabbitMq.Password" value="" />

    <!-- ServiceBus or Folder -->
    <add key="Partner.Transport" value="ServiceBus" />
    <add key="Partner.ServiceBus.ConnectionString" value="Endpoint=sb://contoso-retail-b2b.servicebus.windows.net/;SharedAccessKeyName=litware;SharedAccessKey=" />
    <add key="Partner.ServiceBus.OrderQueue" value="litware-orders" />
    <add key="Partner.ServiceBus.DispatchQueue" value="litware-dispatch" />
    <add key="Partner.Folder.Inbound" value="C:\OrderHub\Partner\Inbound" />
    <add key="Partner.Folder.Outbound" value="C:\OrderHub\Partner\Outbound" />

    <add key="Reports.InvoicePdf" value="true" />
    <add key="Reports.ServerUrl" value="http://reports.corp.local/ReportServer" />
    <add key="Reports.InvoiceReport" value="/Order Hub/Invoice" />
    <add key="Reports.Username" value="REPORTS\svc-orderhub-rs" />
    <add key="Reports.Password" value="" />
    <add key="Reports.DailySalesAt" value="02:00" />

    <add key="serilog:minimum-level" value="Information" />
    <add key="serilog:using:Console" value="Serilog.Sinks.Console" />
    <add key="serilog:write-to:Console" />
    <add key="serilog:using:File" value="Serilog.Sinks.File" />
    <add key="serilog:write-to:File.path" value="C:\OrderHub\Logs\partners-.log" />
    <add key="serilog:write-to:File.rollingInterval" value="Day" />
    <add key="serilog:write-to:File.retainedFileCountLimit" value="30" />
    <add key="serilog:write-to:File.outputTemplate" value="{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}" />
  </appSettings>
</configuration>
