<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
  </startup>
  <connectionStrings>
    <add name="OrderHub" connectionString="Server=sql01.corp.local;Database=OrderHub;User ID=orderhub_svc;Password=;Application Name=OrderHub.ShopSync" providerName="System.Data.SqlClient" />
  </connectionStrings>
  <appSettings>
    <add key="RabbitMq.Host" value="rabbitmq://mq.corp.local/orderhub" />
    <add key="RabbitMq.Username" value="orderhub-shopsync" />
    <add key="RabbitMq.Password" value="" />

    <add key="Webshop.ApiUrl" value="https://shop.litware-outdoor.example/wp-json/wc/v3/" />
    <add key="Webshop.ConsumerKey" value="" />
    <add key="Webshop.ConsumerSecret" value="" />

    <add key="Mail.SmtpHost" value="smtp.corp.local" />
    <add key="Mail.SmtpPort" value="25" />
    <add key="Mail.StartTls" value="false" />
    <add key="Mail.From" value="Litware Outdoor &lt;noreply@litware-outdoor.example&gt;" />
    <add key="Mail.Bcc" value="" />

    <add key="Marketplace.Enabled" value="true" />
    <add key="Marketplace.Sftp.Host" value="sftp.corp.local" />
    <add key="Marketplace.Sftp.Port" value="22" />
    <add key="Marketplace.Sftp.Username" value="trailmarket" />
    <add key="Marketplace.Sftp.Password" value="" />
    <add key="Marketplace.Sftp.PrivateKeyFile" value="" />
    <add key="Marketplace.Sftp.HostKeyFingerprint" value="" />
    <add key="Marketplace.ConfirmationDirectory" value="/confirmations" />
    <add key="Marketplace.StockDirectory" value="/stock" />

    <add key="Stock.Enabled" value="true" />
    <add key="Stock.PollInterval" value="00:10:00" />
    <add key="Stock.SafetyStock" value="2" />
    <add key="Warehouse.Sftp.Host" value="sftp.corp.local" />
    <add key="Warehouse.Sftp.Port" value="22" />
    <add key="Warehouse.Sftp.Username" value="adatum-wms" />
    <add key="Warehouse.Sftp.Password" value="" />
    <add key="Warehouse.Sftp.PrivateKeyFile" value="C:\OrderHub\Keys\adatum-wms.key" />
    <add key="Warehouse.Sftp.HostKeyFingerprint" value="" />
    <add key="Warehouse.StockDirectory" value="/out/stock" />

    <add key="serilog:minimum-level" value="Information" />
    <add key="serilog:using:Console" value="Serilog.Sinks.Console" />
    <add key="serilog:write-to:Console" />
    <add key="serilog:using:File" value="Serilog.Sinks.File" />
    <add key="serilog:write-to:File.path" value="C:\OrderHub\Logs\shopsync-.log" />
    <add key="serilog:write-to:File.rollingInterval" value="Day" />
    <add key="serilog:write-to:File.retainedFileCountLimit" value="30" />
    <add key="serilog:write-to:File.outputTemplate" value="{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}" />
  </appSettings>
</configuration>
