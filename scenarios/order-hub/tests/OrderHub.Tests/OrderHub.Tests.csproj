  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\OrderHub.Contracts\OrderHub.Contracts.csproj" />
    <ProjectReference Include="..\..\src\OrderHub.Core\OrderHub.Core.csproj" />
