<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>

  <connectionStrings>
    <add name="Invoices" connectionString="Data Source=sql01.corp.local;Initial Catalog=SupplierInvoices;Integrated Security=SSPI;Application Name=InvoiceErpLink" providerName="System.Data.SqlClient" />
    <add name="Erp" connectionString="Data Source=erp01.corp.local;Initial Catalog=WingtipErp;Integrated Security=SSPI;ApplicationIntent=ReadOnly;Application Name=InvoiceErpLink" providerName="System.Data.SqlClient" />
  </connectionStrings>

  <appSettings>
    <add key="Company" value="WT01" />
    <add key="PostingQueue" value=".\private$\invoices-posting" />
    <add key="LookupCallers" value="CORP\svc-inv-proc" />
    <add key="ErpImportFolder" value="\\erp01.corp.local\Import\AP" />
    <add key="ErpExportFolder" value="\\erp01.corp.local\Export\AP" />
    <add key="ErpCodePage" value="850" />
    <add key="BatchIntervalMinutes" value="15" />
    <add key="MaxBatchSize" value="200" />
    <add key="AckPollSeconds" value="120" />
  </appSettings>

  <system.runtime.remoting>
    <application>
      <service>
        <wellknown mode="Singleton" type="Wingtip.Invoices.ErpLink.ErpLookupService, Invoices.ErpLink" objectUri="ErpLookup.rem" />
      </service>
      <channels>
        <channel ref="tcp" port="8095" secure="true" impersonate="false" protectionLevel="EncryptAndSign"
                 authorizationModule="Wingtip.Invoices.ErpLink.LookupAuthorization, Invoices.ErpLink">
          <serverProviders>
            <formatter ref="binary" typeFilterLevel="Low" />
          </serverProviders>
        </channel>
      </channels>
    </application>
  </system.runtime.remoting>

  <system.diagnostics>
    <sources>
      <source name="Wingtip.Invoices" switchValue="Information">
        <listeners>
          <add name="file" />
        </listeners>
      </source>
    </sources>
    <sharedListeners>
      <add name="file" type="System.Diagnostics.TextWriterTraceListener" initializeData="D:\InvoiceHub\Logs\ErpLink.log" traceOutputOptions="DateTime, ThreadId" />
    </sharedListeners>
    <trace autoflush="true" />
  </system.diagnostics>
</configuration>
