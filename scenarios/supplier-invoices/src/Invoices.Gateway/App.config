<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>

  <connectionStrings>
    <add name="Invoices" connectionString="Data Source=sql01.corp.local;Initial Catalog=SupplierInvoices;Integrated Security=SSPI;Application Name=InvoiceGateway" providerName="System.Data.SqlClient" />
  </connectionStrings>

  <appSettings>
    <add key="PollIntervalSeconds" value="60" />
    <add key="SettleSeconds" value="30" />
    <add key="MaxFileSizeMB" value="20" />
    <add key="FtpHost" value="ftp.corp.local" />
    <add key="FtpUser" value="CORP\svc-inv-ftp" />
    <add key="FtpPassword" value="" />
    <add key="FtpUseTls" value="true" />
    <add key="DropRoot" value="\\files01.corp.local\InvoiceDrop$" />
    <add key="ArchiveRoot" value="\\files01.corp.local\InvoiceArchive$" />
    <add key="InboundQueue" value="FormatName:DIRECT=OS:invoices-proc.corp.local\private$\invoices-inbound" />
  </appSettings>

  <system.diagnostics>
    <sources>
      <source name="Wingtip.Invoices" switchValue="Information">
        <listeners>
          <add name="file" />
        </listeners>
      </source>
    </sources>
    <sharedListeners>
      <add name="file" type="System.Diagnostics.TextWriterTraceListener" initializeData="D:\InvoiceHub\Logs\Gateway.log" traceOutputOptions="DateTime, ThreadId" />
    </sharedListeners>
    <trace autoflush="true" />
  </system.diagnostics>

  <system.net>
    <settings>
      <servicePointManager checkCertificateName="true" checkCertificateRevocationList="false" />
    </settings>
  </system.net>
</configuration>
