    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Wingtip.Invoices.Admin</RootNamespace>
    <AssemblyName>Invoices.Admin</AssemblyName>
