<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>

  <connectionStrings>
    <add name="Invoices" connectionString="Data Source=sql01.corp.local;Initial Catalog=SupplierInvoices;Integrated Security=SSPI;Application Name=InvoiceProcessor" providerName="System.Data.SqlClient" />
  </connectionStrings>

  <appSettings>
    <add key="Workers" value="2" />
    <add key="MaxAttempts" value="5" />
    <add key="Company" value="WT01" />
    <add key="InboundQueue" value=".\private$\invoices-inbound" />
    <add key="PoisonQueue" value=".\private$\invoices-poison" />
    <add key="PostingQueue" value="FormatName:DIRECT=OS:invoices-erp.corp.local\private$\invoices-posting" />
    <add key="ErpLookupUrl" value="tcp://invoices-erp.corp.local:8095/ErpLookup.rem" />
    <add key="ArchiveRoot" value="\\files01.corp.local\InvoiceArchive$" />
    <add key="PriceTolerancePercent" value="2" />
    <add key="TotalToleranceAmount" value="5" />
    <add key="AutoApproveLimit" value="25000" />
    <add key="MaxInvoiceAgeDays" value="365" />
    <add key="DefaultExpenseAccount" value="40000" />
    <add key="ControlCallers" value="CORP\svc-inv-web,CORP\AP-Hub-Admins" />
  </appSettings>

  <system.runtime.remoting>
    <application>
      <channels>
        <channel ref="tcp" secure="true" tokenImpersonationLevel="Identification" protectionLevel="EncryptAndSign" />
      </channels>
    </application>
  </system.runtime.remoting>

  <system.serviceModel>
    <services>
      <service name="Wingtip.Invoices.Processor.Control.ProcessorControl" behaviorConfiguration="control">
        <host>
          <baseAddresses>
            <add baseAddress="net.tcp://invoices-proc.corp.local:8096/InvoiceProcessor" />
          </baseAddresses>
        </host>
        <endpoint address="Control" binding="netTcpBinding" bindingConfiguration="windows" contract="Wingtip.Invoices.Contracts.Control.IProcessorControl" />
      </service>
    </services>
    <bindings>
      <netTcpBinding>
        <binding name="windows" portSharingEnabled="false" maxReceivedMessageSize="1048576">
          <security mode="Transport">
            <transport clientCredentialType="Windows" protectionLevel="EncryptAndSign" />
          </security>
        </binding>
      </netTcpBinding>
    </bindings>
    <behaviors>
      <serviceBehaviors>
        <behavior name="control">
          <serviceAuthorization serviceAuthorizationManagerType="Wingtip.Invoices.Processor.Control.ControlAuthorization, Invoices.Processor" />
          <serviceThrottling maxConcurrentCalls="16" maxConcurrentSessions="16" />
          <serviceDebug includeExceptionDetailInFaults="false" />
        </behavior>
      </serviceBehaviors>
    </behaviors>
  </system.serviceModel>

  <system.diagnostics>
    <sources>
      <source name="Wingtip.Invoices" switchValue="Information">
        <listeners>
          <add name="file" />
        </listeners>
      </source>
    </sources>
    <sharedListeners>
      <add name="file" type="System.Diagnostics.TextWriterTraceListener" initializeData="D:\InvoiceHub\Logs\Processor.log" traceOutputOptions="DateTime, ThreadId" />
    </sharedListeners>
    <trace autoflush="true" />
  </system.diagnostics>
</configuration>
