{
  "ConnectionStrings": {
    "ExpenseClaims": "Server=expenses-sql.corp.local;Database=ExpenseClaims;User Id=expenses_jobs;Password=;Encrypt=True;TrustServerCertificate=False;Application Name=Expense Claims Jobs"
  },
  "Database": {
    "Provider": "SqlServer"
  },
  "Quartz": {
    "SchedulerName": "ExpenseClaims",
    "JobStore": "SqlServer",
    "TimeZone": "FLE Standard Time"
  },
  "Jobs": {
    "ExchangeRates": {
      "Cron": "0 30 17 ? * MON-FRI"
    },
    "HrEmployeeImport": {
      "Cron": "0 15 5 * * ?"
    },
    "ApproverReminders": {
      "Cron": "0 0 8 ? * MON-FRI"
    },
    "PaymentRun": {
      "Cron": "0 0 13 ? * MON-FRI"
    },
    "PaymentStatus": {
      "Cron": "0 0/15 7-20 ? * MON-FRI"
    },
    "CardTransactionImport": {
      "Cron": "0 0 6 * * ?"
    },
    "AccountingExport": {
      "Cron": "0 30 18 ? * MON-FRI"
    }
  },
  "ExchangeRates": {
    "Url": "https://www.ecb.europa.eu/stats/eurofxref/eurofxref-hist-90d.xml"
  },
  "Proxy": {
    "Address": "http://proxy.corp.local:8080",
    "UseDefaultCredentials": true,
    "Bypass": [
      "\\.corp\\.local$"
    ]
  },
  "HrImport": {
    "InboundFolder": "D:\\Interfaces\\HR\\Inbound",
    "FilePattern": "employees_*.csv",
    "MaxDeactivationShare": 0.1
  },
  "CardImport": {
    "InboundFolder": "D:\\Interfaces\\Cards\\Inbound",
    "FilePattern": "TRX_*.csv",
    "Culture": "fi-FI"
  },
  "Reminders": {
    "AfterDays": 3
  },
  "Smtp": {
    "Host": "smtp.corp.local",
    "Port": 25,
    "From": "Expense Claims <expenses-noreply@lamnahealthcare.com>",
    "PortalUrl": "https://expenses.corp.local/"
  },
  "Bank": {
    "Mode": "Gateway",
    "GatewayUrl": "https://corporate-gateway.nordbank.example/api/v2/",
    "ClientCertificateThumbprint": "",
    "CustomerId": "",
    "OutboundFolder": "D:\\Interfaces\\Bank\\Outbound",
    "DebtorName": "Lamna Healthcare Oy",
    "DebtorIban": "",
    "DebtorBic": "",
    "DebtorOrganisationId": "",
    "CutOffTime": "14:00:00"
  },
  "Erp": {
    "ODataUrl": "http://nav01.corp.local:7048/DynamicsNAV110/ODataV4/",
    "Company": "Lamna Healthcare Oy",
    "JournalService": "ExpenseJournal",
    "JournalTemplate": "GENERAL",
    "JournalBatch": "EXPCLAIMS"
  },
  "Accounting": {
    "HomeCountry": "FI",
    "VatReceivableAccount": "2930",
    "EmployeePayableAccount": "2870",
    "CardClearingAccount": "2875"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Quartz": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "D:\\Logs\\ExpenseClaims\\jobs-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 60,
          "shared": true,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff} [{Level:u3}] {SourceContext} {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
