{
  "ConnectionStrings": {
    "ExpenseClaims": "Server=expenses-sql.corp.local;Database=ExpenseClaims;User Id=expenses_app;Password=;Encrypt=True;TrustServerCertificate=False;Application Name=Expense Claims API"
  },
  "Database": {
    "Provider": "SqlServer",
    "MigrateOnStartup": false,
    "SeedTestData": false
  },
  "Authentication": {
    "Mode": "Adfs",
    "Adfs": {
      "Authority": "https://adfs.corp.local/adfs",
      "Audience": "https://expenses-api.corp.local",
      "ValidIssuers": [
        "http://adfs.corp.local/adfs/services/trust",
        "https://adfs.corp.local/adfs"
      ]
    }
  },
  "Cors": {
    "Origins": [
      "https://expenses.corp.local"
    ]
  },
  "Receipts": {
    "RootPath": "D:\\ExpenseReceipts",
    "MaxFileBytes": 10485760
  },
  "Approval": {
    "FallbackApprover": "100001"
  },
  "Policy": {
    "BaseCurrency": "EUR",
    "ReceiptRequiredFrom": 25.0,
    "MileageRatePerKm": 0.46,
    "MaxKilometresPerLine": 2000,
    "PerDiemFull": 48.0,
    "PerDiemPartial": 22.0,
    "PerDiemAbroadDefault": 60.0,
    "PerDiemAbroad": {
      "SE": 64.0,
      "NO": 70.0,
      "DK": 69.0,
      "EE": 52.0,
      "DE": 58.0,
      "GB": 68.0,
      "US": 72.0
    },
    "AccommodationPerNight": 180.0,
    "MealsPerPersonLimit": 60.0,
    "RepresentationPerPersonLimit": 90.0,
    "EquipmentLimit": 300.0,
    "MaxAgeDays": 90,
    "SecondApprovalFrom": 2500.0
  },
  "Accounting": {
    "HomeCountry": "FI",
    "VatRates": {
      "Travel": 10.0,
      "Accommodation": 10.0,
      "Training": 24.0,
      "Equipment": 24.0,
      "Other": 24.0
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "D:\\Logs\\ExpenseClaims\\api-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 60,
          "fileSizeLimitBytes": 104857600,
          "rollOnFileSizeLimit": true,
          "shared": true,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff} [{Level:u3}] {SourceContext} {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
