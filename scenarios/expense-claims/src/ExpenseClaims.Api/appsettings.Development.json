{
  "ConnectionStrings": {
    "ExpenseClaims": "Data Source=App_Data/expenseclaims-dev.db"
  },
  "Database": {
    "Provider": "Sqlite",
    "MigrateOnStartup": true,
    "SeedTestData": true
  },
  "Authentication": {
    "Mode": "Development",
    "Development": {
      "SigningKey": "local-development-signing-key-not-for-servers",
      "Roles": {
        "mikko.salonen@lamnahealthcare.com": [ "Finance" ],
        "laura.niemi@lamnahealthcare.com": [ "Finance", "Administrator" ]
      }
    }
  },
  "Cors": {
    "Origins": [ "http://localhost:4200" ]
  },
  "Receipts": {
    "RootPath": "App_Data/receipts"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "App_Data/logs/api-.log",
          "rollingInterval": "Day"
        }
      }
    ]
  }
}
