<?xml version="1.0" encoding="utf-8"?>
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <connectionStrings>
    <add name="Purchasing" connectionString="Data Source=sql01.corp.local;Initial Catalog=Purchasing;Integrated Security=SSPI;Application Name=Purchasing.Api"
         xdt:Transform="SetAttributes" xdt:Locator="Match(name)" />
  </connectionStrings>
  <appSettings>
    <add key="Purchasing.DirectoryDomain" value="corp.local" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
    <add key="Purchasing.AttachmentRoot" value="\\files01.corp.local\Purchasing$\Attachments" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
  </appSettings>
  <system.diagnostics>
    <trace>
      <listeners>
        <add name="file" initializeData="D:\Logs\Purchasing\api.log" xdt:Transform="SetAttributes" xdt:Locator="Match(name)" />
      </listeners>
    </trace>
  </system.diagnostics>
  <system.web>
    <compilation xdt:Transform="RemoveAttributes(debug)" />
    <customErrors mode="RemoteOnly" xdt:Transform="SetAttributes" />
  </system.web>
</configuration>
