<Project Sdk="MSBuild.SDK.SystemWeb">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <RootNamespace>Contoso.Purchasing.Api</RootNamespace>
    <AssemblyName>Purchasing.Api</AssemblyName>
    <AppConfig>Web.config</AppConfig>
    <Version>2.4.1</Version>
    <Company>Contoso Manufacturing</Company>
    <Product>Purchase Requests</Product>
    <GeneratedBindingRedirectsAction>None</GeneratedBindingRedirectsAction>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="Microsoft.AspNet.WebApi" Version="5.3.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Configuration" />
    <Reference Include="System.DirectoryServices.AccountManagement" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Runtime.Caching" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Purchasing.Core\Purchasing.Core.csproj" />
    <ProjectReference Include="..\Purchasing.Data\Purchasing.Data.csproj" />
  </ItemGroup>

</Project>
