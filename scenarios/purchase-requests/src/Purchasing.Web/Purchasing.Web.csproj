<Project Sdk="MSBuild.SDK.SystemWeb">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <RootNamespace>Contoso.Purchasing.Web</RootNamespace>
    <AssemblyName>Purchasing.Web</AssemblyName>
    <AppConfig>Web.config</AppConfig>
    <Version>2.4.1</Version>
    <Company>Contoso Manufacturing</Company>
    <Product>Purchase Requests</Product>
    <GeneratedBindingRedirectsAction>None</GeneratedBindingRedirectsAction>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="Microsoft.AspNet.Mvc" Version="5.3.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.ComponentModel.DataAnnotations" />
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.Configuration" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Views\**\*.cshtml" />
    <Content Include="Views\Web.config" />
    <Content Include="Content\**\*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Purchasing.Core\Purchasing.Core.csproj" />
  </ItemGroup>

</Project>
