<?xml version="1.0" encoding="utf-8"?>
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <appSettings>
    <add key="Purchasing.ApiBaseUrl" value="http://purchasing-api.corp.local/" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
  </appSettings>
  <system.diagnostics>
    <trace>
      <listeners>
        <add name="file" initializeData="D:\Logs\Purchasing\web.log" xdt:Transform="SetAttributes" xdt:Locator="Match(name)" />
      </listeners>
    </trace>
  </system.diagnostics>
  <system.web>
    <compilation xdt:Transform="RemoveAttributes(debug)" />
    <customErrors mode="RemoteOnly" defaultRedirect="~/Views/Shared/Error.cshtml" xdt:Transform="SetAttributes" />
    <httpCookies httpOnlyCookies="true" requireSSL="false" xdt:Transform="Insert" />
  </system.web>
</configuration>
