<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <connectionStrings>
    <add name="Purchasing" connectionString="Data Source=sql01.corp.local;Initial Catalog=Purchasing;Integrated Security=SSPI;Application Name=Purchasing.Jobs" providerName="System.Data.SqlClient" />
  </connectionStrings>
  <appSettings>
    <add key="PortalUrl" value="http://purchasing.corp.local/" />
    <add key="Mail.From" value="Purchase Requests &lt;purchasing@contoso.com&gt;" />
    <add key="Mail.FinanceMailbox" value="purchasing-finance@contoso.com" />
    <add key="Mail.DirectorsMailbox" value="purchasing-directors@contoso.com" />
    <add key="Mail.Enabled" value="true" />
    <add key="Reminders.FirstAfterBusinessDays" value="2" />
    <add key="Reminders.RepeatAfterBusinessDays" value="1" />
    <add key="Export.Folder" value="\\erp01.corp.local\Inbound\PURCH01" />
    <add key="Export.ArchiveFolder" value="\\files01.corp.local\Purchasing$\ErpExport" />
    <add key="LogFolder" value="D:\Logs\Purchasing" />
  </appSettings>
  <system.net>
    <mailSettings>
      <smtp deliveryMethod="Network">
        <network host="smtp.corp.local" port="25" defaultCredentials="true" />
      </smtp>
    </mailSettings>
  </system.net>
</configuration>
