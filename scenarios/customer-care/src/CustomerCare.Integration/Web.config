<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="entityFramework" type="System.Data.Entity.Internal.ConfigFile.EntityFrameworkSection, EntityFramework, Version=6.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
  </configSections>
  <connectionStrings>
    <add name="CustomerCare" connectionString="Data Source=sql01.corp.local;Initial Catalog=CustomerCare;Integrated Security=SSPI;Application Name=Customer Care Integration" providerName="System.Data.SqlClient" />
  </connectionStrings>
  <appSettings>
    <add key="CustomerCare:IntegrationGroups" value="CORP\CC-Integration" />
    <add key="CustomerCare:TimeZone" value="FLE Standard Time" />
    <add key="CustomerCare:OfficeOpens" value="08:00" />
    <add key="CustomerCare:OfficeCloses" value="17:00" />
    <add key="CustomerCare:DefaultQueue" value="GENERAL" />
    <add key="CustomerCare:PortalNotifyUrl" value="https://care.corp.local/internal/notify.ashx" />
    <!-- Shared with the portal; set by deploy\Install-IisSites.ps1. -->
    <add key="CustomerCare:NotifyKey" value="" />
  </appSettings>
  <system.diagnostics>
    <trace autoflush="true">
      <listeners>
        <add name="file" type="System.Diagnostics.TextWriterTraceListener" initializeData="C:\ProgramData\Tailspin\CustomerCare\Logs\integration.log" />
      </listeners>
    </trace>
    <sources>
      <source name="System.ServiceModel" switchValue="Warning, ActivityTracing" propagateActivity="true">
        <listeners>
          <add name="wcf" type="System.Diagnostics.XmlWriterTraceListener" initializeData="C:\ProgramData\Tailspin\CustomerCare\Logs\integration-wcf.svclog" />
        </listeners>
      </source>
    </sources>
  </system.diagnostics>
  <system.web>
    <compilation debug="false" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" maxRequestLength="4096" enableVersionHeader="false" />
    <authentication mode="Windows" />
  </system.web>
  <system.serviceModel>
    <serviceHostingEnvironment aspNetCompatibilityEnabled="false" multipleSiteBindingsEnabled="true" />
    <bindings>
      <basicHttpBinding>
        <binding name="windows" maxReceivedMessageSize="1048576">
          <security mode="TransportCredentialOnly">
            <transport clientCredentialType="Windows" />
          </security>
        </binding>
      </basicHttpBinding>
    </bindings>
    <services>
      <service name="Tailspin.CustomerCare.Integration.CaseIntegrationService" behaviorConfiguration="integration">
        <endpoint address="" binding="basicHttpBinding" bindingConfiguration="windows" bindingNamespace="urn:tailspin-energy:customercare:integration:2019"
                  contract="Tailspin.CustomerCare.Integration.ICaseIntegrationService" />
        <endpoint address="mex" binding="mexHttpBinding" contract="IMetadataExchange" />
      </service>
    </services>
    <behaviors>
      <serviceBehaviors>
        <behavior name="integration">
          <serviceMetadata httpGetEnabled="true" />
          <serviceDebug includeExceptionDetailInFaults="false" />
          <serviceAuthorization serviceAuthorizationManagerType="Tailspin.CustomerCare.Integration.IntegrationAuthorizationManager, CustomerCare.Integration" principalPermissionMode="UseWindowsGroups" />
          <serviceThrottling maxConcurrentCalls="64" maxConcurrentSessions="200" maxConcurrentInstances="264" />
        </behavior>
      </serviceBehaviors>
    </behaviors>
  </system.serviceModel>
  <system.webServer>
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
  <entityFramework>
    <providers>
      <provider invariantName="System.Data.SqlClient" type="System.Data.Entity.SqlServer.SqlProviderServices, EntityFramework.SqlServer" />
    </providers>
  </entityFramework>
</configuration>
