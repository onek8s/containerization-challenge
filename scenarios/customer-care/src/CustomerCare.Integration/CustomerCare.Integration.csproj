<Project Sdk="MSBuild.SDK.SystemWeb">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <RootNamespace>Tailspin.CustomerCare.Integration</RootNamespace>
    <AssemblyName>CustomerCare.Integration</AssemblyName>
    <AppConfig>Web.config</AppConfig>
    <Version>5.4.0</Version>
    <Company>Tailspin Energy</Company>
    <Product>Customer Care</Product>
    <GeneratedBindingRedirectsAction>None</GeneratedBindingRedirectsAction>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="EntityFramework" Version="6.5.1" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Configuration" />
    <Reference Include="System.Runtime.Caching" />
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="System.ServiceModel" />
    <Reference Include="System.ServiceModel.Activation" />
    <Reference Include="System.IdentityModel" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="*.svc" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CustomerCare.Domain\CustomerCare.Domain.csproj" />
    <ProjectReference Include="..\CustomerCare.Data\CustomerCare.Data.csproj" />
  </ItemGroup>

</Project>
