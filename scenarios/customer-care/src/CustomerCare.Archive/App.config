<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="entityFramework" type="System.Data.Entity.Internal.ConfigFile.EntityFrameworkSection, EntityFramework, Version=6.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
  </configSections>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <connectionStrings>
    <add name="CustomerCare" connectionString="Data Source=sql01.corp.local;Initial Catalog=CustomerCare;Integrated Security=SSPI;Application Name=Customer Care Archive" providerName="System.Data.SqlClient" />
  </connectionStrings>
  <appSettings>
    <add key="Archive:Folder" value="D:\CustomerCare\Archive" />
    <!-- Closed cases are kept in the database for this many months. -->
    <add key="Archive:KeepMonths" value="24" />
    <add key="Archive:BatchSize" value="500" />
    <add key="Archive:LogFolder" value="D:\CustomerCare\Logs" />
  </appSettings>
  <entityFramework>
    <providers>
      <provider invariantName="System.Data.SqlClient" type="System.Data.Entity.SqlServer.SqlProviderServices, EntityFramework.SqlServer" />
    </providers>
  </entityFramework>
</configuration>
