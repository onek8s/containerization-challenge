<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="entityFramework" type="System.Data.Entity.Internal.ConfigFile.EntityFrameworkSection, EntityFramework, Version=6.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
  </configSections>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <connectionStrings>
    <add name="CustomerCare" connectionString="Data Source=sql01.corp.local;Initial Catalog=CustomerCare;Integrated Security=SSPI;Application Name=Customer Care Import" providerName="System.Data.SqlClient" />
  </connectionStrings>
  <appSettings>
    <!-- The billing system drops customer_YYYYMMDD.csv into Inbox every night. -->
    <add key="Import:Folder" value="D:\CustomerCare\Import" />
    <add key="Import:FilePattern" value="customer_*.csv" />
    <!-- Refuse the file when more than this share of rows is rejected. -->
    <add key="Import:MaxRejectedPercent" value="5" />
    <add key="Import:LogFolder" value="D:\CustomerCare\Logs" />
  </appSettings>
  <entityFramework>
    <providers>
      <provider invariantName="System.Data.SqlClient" type="System.Data.Entity.SqlServer.SqlProviderServices, EntityFramework.SqlServer" />
    </providers>
  </entityFramework>
</configuration>
