@model Part
<div asp-validation-summary="ModelOnly" class="errors"></div>
<label asp-for="PartNumber"></label>
<input asp-for="PartNumber" />
<span asp-validation-for="PartNumber" class="errors"></span>
<label asp-for="Description"></label>
<input asp-for="Description" />
<span asp-validation-for="Description" class="errors"></span>
<label asp-for="Category"></label>
<input asp-for="Category" />
<label asp-for="BinLocation"></label>
<input asp-for="BinLocation" />
<label asp-for="QuantityOnHand"></label>
<input asp-for="QuantityOnHand" />
<span asp-validation-for="QuantityOnHand" class="errors"></span>
<label asp-for="ReorderLevel"></label>
<input asp-for="ReorderLevel" />
<span asp-validation-for="ReorderLevel" class="errors"></span>
<label asp-for="UnitPrice"></label>
<input asp-for="UnitPrice" type="number" step="0.01" />
<span asp-validation-for="UnitPrice" class="errors"></span>
