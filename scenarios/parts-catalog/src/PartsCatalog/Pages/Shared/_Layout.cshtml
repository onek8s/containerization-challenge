@inject Microsoft.Extensions.Configuration.IConfiguration Config
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Parts Catalog</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav>
            <a class="brand" asp-page="/Index">Parts Catalog</a>
            <a asp-page="/Parts/Index">Parts</a>
            <a asp-page="/Parts/Index" asp-route-reorder="true">Reorder list</a>
            <a asp-page="/Parts/Create">Add part</a>
        </nav>
    </header>
    <main>
        @RenderBody()
    </main>
    <footer>&copy; @DateTime.Now.Year @Config["Catalog:CompanyName"]</footer>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
