{
  "ConnectionStrings": {
    "Identity": "Data Source=App_Data/identity.db"
  },
  "Database": {
    "Provider": "Sqlite",
    "EnsureCreated": true,
    "SeedSampleUsers": true
  },
  "Identity": {
    "Issuer": "http://localhost:5300/",
    "RequireHttps": false
  },
  "Clients": [
    {
      "ClientId": "broker-portal",
      "DisplayName": "Broker portal",
      "ClientSecret": "dev-portal-secret",
      "RedirectUris": [ "http://localhost:5320/signin-oidc" ],
      "PostLogoutRedirectUris": [ "http://localhost:5320/signout-callback-oidc" ]
    },
    {
      "ClientId": "workbench",
      "DisplayName": "Underwriting workbench",
      "ClientSecret": "dev-workbench-secret",
      "RedirectUris": [ "http://localhost:5330/signin-oidc" ],
      "PostLogoutRedirectUris": [ "http://localhost:5330/signout-callback-oidc" ]
    }
  ],
  "Serilog": {
    "WriteTo": [ { "Name": "Console" } ]
  }
}
