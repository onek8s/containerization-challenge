{
  "ConnectionStrings": {
    "Identity": "Server=sql01.corp.local;Database=HumongousIdentity;User Id=hq_identity;Password=__set_in_deploy__;Encrypt=True;TrustServerCertificate=False"
  },
  "Database": {
    "Provider": "SqlServer",
    "EnsureCreated": false,
    "SeedSampleUsers": false
  },
  "Identity": {
    "Issuer": "https://login.corp.local/",
    "RequireHttps": true,
    "AccessTokenMinutes": 30,
    "RefreshTokenHours": 10,
    "SigningCertificateThumbprint": "",
    "EncryptionCertificateThumbprint": ""
  },
  "Clients": [
    {
      "ClientId": "broker-portal",
      "DisplayName": "Broker portal",
      "ClientSecret": "__set_in_deploy__",
      "RedirectUris": [ "https://brokers.corp.local/signin-oidc" ],
      "PostLogoutRedirectUris": [ "https://brokers.corp.local/signout-callback-oidc" ]
    },
    {
      "ClientId": "workbench",
      "DisplayName": "Underwriting workbench",
      "ClientSecret": "__set_in_deploy__",
      "RedirectUris": [ "https://workbench.corp.local/signin-oidc" ],
      "PostLogoutRedirectUris": [ "https://workbench.corp.local/signout-callback-oidc" ]
    }
  ],
  "Serilog": {
    "MinimumLevel": { "Default": "Information", "Override": { "Microsoft": "Warning", "Microsoft.Hosting.Lifetime": "Information", "OpenIddict": "Warning" } },
    "WriteTo": [
      { "Name": "File", "Args": { "path": "D:\\Logs\\Humongous\\Identity\\identity-.log", "rollingInterval": "Day", "retainedFileCountLimit": 30 } }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*"
}
