@inherits LayoutComponentBase

<header class="top">
    <span class="brand">Underwriting workbench</span>
    <nav>
        <NavLink href="" Match="NavLinkMatch.All">Referrals</NavLink>
        <NavLink href="quotes">Quotes</NavLink>
        <NavLink href="policies">Policies</NavLink>
        <NavLink href="agencies">Agencies</NavLink>
        <NavLink href="bordereaux">Bordereaux</NavLink>
        <NavLink href="rating">Rating engine</NavLink>
    </nav>
    <AuthorizeView>
        <span class="who">@context.User.FindFirst("name")?.Value</span>
        <form method="post" action="signout"><AntiforgeryToken /><button type="submit" class="link">Sign out</button></form>
    </AuthorizeView>
</header>
<main>
    @Body
</main>

<div id="blazor-error-ui">
    The workbench lost its connection. <a href="" class="reload">Reload</a>
</div>
