{
  "Oidc": {
    "Authority": "https://login.corp.local/",
    "ClientId": "workbench",
    "ClientSecret": "__set_in_deploy__",
    "RequireHttpsMetadata": true
  },
  "QuoteApi": {
    "BaseAddress": "https://quote-api.corp.local/"
  },
  "Serilog": {
    "MinimumLevel": { "Default": "Information", "Override": { "Microsoft": "Warning", "Microsoft.Hosting.Lifetime": "Information" } },
    "WriteTo": [
      { "Name": "File", "Args": { "path": "D:\\Logs\\Humongous\\Workbench\\workbench-.log", "rollingInterval": "Day", "retainedFileCountLimit": 30 } }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*"
}
