{
  "ConnectionStrings": {
    "Quoting": "Server=sql01.corp.local;Database=HumongousQuoting;User Id=hq_policy;Password=__set_in_deploy__;Encrypt=True;TrustServerCertificate=False;Application Name=Policy Service"
  },
  "Database": {
    "Provider": "SqlServer"
  },
  "Rating": {
    "Provider": "RateCore",
    "ProgId": "RateCore.Engine",
    "TablesPath": "D:\\RateCore\\Tables",
    "Workers": 2,
    "RecycleAfterCalls": 500,
    "CallTimeoutSeconds": 60
  },
  "Bus": {
    "Transport": "RabbitMq",
    "Host": "mq01.corp.local",
    "VirtualHost": "humongous",
    "Username": "policy-service",
    "Password": "__set_in_deploy__",
    "EndpointPrefix": "policy-service"
  },
  "Jobs": {
    "TimeZone": "GMT Standard Time",
    "Schedules": {
      "renewals": "0 2 * * *",
      "quote-expiry": "15 * * * *",
      "lapse": "30 0 * * *",
      "bordereau": "0 6 1 * *"
    }
  },
  "Renewals": {
    "DaysBeforeExpiry": 45
  },
  "Bordereau": {
    "Umr": "B1234HUM2024BC",
    "Delivery": "Sftp",
    "Sftp": {
      "Host": "sftp.lucernecapacity.example",
      "Port": 22,
      "Username": "humongous_bdx",
      "PrivateKeyPath": "D:\\Humongous\\Keys\\lucerne_bdx.key",
      "HostKeyFingerprint": "",
      "RemoteFolder": "/inbound/humongous/premium"
    }
  },
  "Serilog": {
    "MinimumLevel": { "Default": "Information", "Override": { "Microsoft": "Warning", "Microsoft.Hosting.Lifetime": "Information", "MassTransit": "Warning" } },
    "WriteTo": [
      { "Name": "File", "Args": { "path": "D:\\Logs\\Humongous\\PolicyService\\policy-service-.log", "rollingInterval": "Day", "retainedFileCountLimit": 60 } }
    ],
    "Enrich": [ "FromLogContext" ]
  }
}
