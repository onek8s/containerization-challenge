{
  "ConnectionStrings": {
    "Quoting": "Server=sql01.corp.local;Database=HumongousQuoting;User Id=hq_quoting;Password=__set_in_deploy__;Encrypt=True;TrustServerCertificate=False;Application Name=Broker Quotes API"
  },
  "Database": {
    "Provider": "SqlServer",
    "EnsureCreated": false,
    "SeedSampleData": false
  },
  "Rating": {
    "Provider": "RateCore",
    "ProgId": "RateCore.Engine",
    "TablesPath": "D:\\RateCore\\Tables",
    "Workers": 4,
    "RecycleAfterCalls": 500,
    "CallTimeoutSeconds": 30
  },
  "Bus": {
    "Transport": "RabbitMq",
    "Host": "mq01.corp.local",
    "VirtualHost": "humongous",
    "Username": "quote-api",
    "Password": "__set_in_deploy__",
    "EndpointPrefix": "quote-api"
  },
  "Authentication": {
    "Authority": "https://login.corp.local/",
    "Audience": "quote-api",
    "RequireHttpsMetadata": true
  },
  "Serilog": {
    "MinimumLevel": { "Default": "Information", "Override": { "Microsoft": "Warning", "Microsoft.Hosting.Lifetime": "Information", "MassTransit": "Warning" } },
    "WriteTo": [
      { "Name": "File", "Args": { "path": "D:\\Logs\\Humongous\\QuoteApi\\quote-api-.log", "rollingInterval": "Day", "retainedFileCountLimit": 30 } }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*"
}
