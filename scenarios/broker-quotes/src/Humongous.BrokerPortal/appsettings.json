{
  "Oidc": {
    "Authority": "https://login.corp.local/",
    "ClientId": "broker-portal",
    "ClientSecret": "__set_in_deploy__",
    "RequireHttpsMetadata": true
  },
  "ReverseProxy": {
    "Routes": {
      "api": { "ClusterId": "quote-api", "Match": { "Path": "/api/{**rest}" } },
      "hubs": { "ClusterId": "quote-api", "Match": { "Path": "/hubs/{**rest}" } }
    },
    "Clusters": {
      "quote-api": {
        "Destinations": { "primary": { "Address": "https://quote-api.corp.local/" } },
        "HttpRequest": { "ActivityTimeout": "00:02:00" }
      }
    }
  },
  "Serilog": {
    "MinimumLevel": { "Default": "Information", "Override": { "Microsoft": "Warning", "Microsoft.Hosting.Lifetime": "Information", "Yarp": "Warning" } },
    "WriteTo": [
      { "Name": "File", "Args": { "path": "D:\\Logs\\Humongous\\BrokerPortal\\portal-.log", "rollingInterval": "Day", "retainedFileCountLimit": 30 } }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*"
}
