{
  "ConnectionStrings": {
    "Quoting": "Server=sql01.corp.local;Database=HumongousQuoting;User Id=hq_documents;Password=__set_in_deploy__;Encrypt=True;TrustServerCertificate=False;Application Name=Documents"
  },
  "Database": {
    "Provider": "SqlServer"
  },
  "Bus": {
    "Transport": "RabbitMq",
    "Host": "mq01.corp.local",
    "VirtualHost": "humongous",
    "Username": "documents",
    "Password": "__set_in_deploy__",
    "EndpointPrefix": "documents"
  },
  "Documents": {
    "FontFamily": "Arial"
  },
  "Mail": {
    "Mode": "Smtp",
    "Host": "smtp.corp.local",
    "Port": 25,
    "From": "Humongous Broker Documents <documents@humongousinsurance.example>"
  },
  "Serilog": {
    "MinimumLevel": { "Default": "Information", "Override": { "Microsoft": "Warning", "Microsoft.Hosting.Lifetime": "Information", "MassTransit": "Warning" } },
    "WriteTo": [
      { "Name": "File", "Args": { "path": "D:\\Logs\\Humongous\\Documents\\documents-.log", "rollingInterval": "Day", "retainedFileCountLimit": 60 } }
    ],
    "Enrich": [ "FromLogContext" ]
  }
}
