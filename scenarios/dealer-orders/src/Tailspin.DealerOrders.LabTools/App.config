<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="log4net" type="log4net.Config.Log4NetConfigurationSectionHandler, log4net" />
    <section name="entityFramework" type="System.Data.Entity.Internal.ConfigFile.EntityFrameworkSection, EntityFramework, Version=6.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
  </configSections>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
  </startup>
  <connectionStrings>
    <add name="DealerOrders" connectionString="Data Source=localhost;Initial Catalog=DealerOrders;Integrated Security=true;Application Name=DealerOrders.LabTools" providerName="System.Data.SqlClient" />
  </connectionStrings>
  <appSettings>
    <add key="Ax.Mode" value="Simulator" />
    <add key="Ax.Company" value="TSM" />
    <add key="Ax.Simulator.StateFile" value="" />
    <add key="Orders.FactoryTimeZone" value="FLE Standard Time" />
    <add key="Logging.Folder" value="C:\DealerOrders\Logs" />
  </appSettings>
  <log4net>
    <appender name="File" type="log4net.Appender.FileAppender">
      <file type="log4net.Util.PatternString" value="%property{LogDir}\labtools.log" />
      <appendToFile value="true" />
      <layout type="log4net.Layout.PatternLayout">
        <conversionPattern value="%date %-5level %logger - %message%newline%exception" />
      </layout>
    </appender>
    <root>
      <level value="INFO" />
      <appender-ref ref="File" />
    </root>
  </log4net>
  <entityFramework>
    <providers>
      <provider invariantName="System.Data.SqlClient" type="System.Data.Entity.SqlServer.SqlProviderServices, EntityFramework.SqlServer" />
    </providers>
  </entityFramework>
</configuration>
