<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="log4net" type="log4net.Config.Log4NetConfigurationSectionHandler, log4net" />
    <sectionGroup name="common">
      <section name="logging" type="Common.Logging.ConfigurationSectionHandler, Common.Logging" />
    </sectionGroup>
    <section name="entityFramework" type="System.Data.Entity.Internal.ConfigFile.EntityFrameworkSection, EntityFramework, Version=6.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
  </configSections>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
  </startup>
  <connectionStrings>
    <add name="DealerOrders" connectionString="Data Source=sql01.corp.local;Initial Catalog=DealerOrders;User ID=dlr_pricesync;Password=;Application Name=DealerOrders.PriceSync" providerName="System.Data.SqlClient" />
  </connectionStrings>
  <appSettings>
    <!-- BusinessConnector (production) or Simulator (test environments without AX). -->
    <add key="Ax.Mode" value="BusinessConnector" />
    <add key="Ax.ObjectServer" value="aos01.corp.local:2712" />
    <add key="Ax.Company" value="TSM" />
    <add key="Ax.Language" value="en-us" />
    <add key="Ax.Configuration" value="C:\DealerOrders\Ax\TailspinAX-BC.axc" />
    <add key="Ax.BusinessConnectorPath" value="" />
    <add key="Ax.BusinessConnectorProxy" value="CORP\svc-ax-bcproxy" />
    <add key="Ax.SessionPoolSize" value="2" />
    <add key="Ax.SessionMaxCalls" value="500" />
    <add key="Ax.AifBaseAddress" value="net.tcp://aos01.corp.local:8201/DynamicsAx/Services/" />
    <add key="Ax.AifPort" value="TSDealerServices" />
    <add key="Ax.AosServiceUpn" value="svc-ax-aos@corp.local" />
    <add key="Ax.Simulator.StateFile" value="C:\DealerOrders\Ax\simulator-state.json" />


    <add key="Documents.PurgeAfterDays" value="90" />
    <add key="Orders.FactoryTimeZone" value="FLE Standard Time" />
    <add key="Orders.SalesDeskEmail" value="salesdesk@tailspin-machinery.example" />
    <add key="Orders.PortalBaseUrl" value="https://dealers.corp.local/" />
    <add key="Orders.SalesDeskBaseUrl" value="https://salesdesk.corp.local/" />
    <add key="Catalog.Folder" value="" />
    <add key="Edi.InterchangeQualifier" value="ZZ" />
    <add key="Edi.InterchangeId" value="TAILSPINMACH" />
    <add key="Edi.ApplicationCode" value="TAILSPIN" />
    <add key="Edi.Test" value="false" />
    <add key="Logging.Folder" value="C:\DealerOrders\Logs" />
  </appSettings>
  <common>
    <logging>
      <!-- Quartz logs through Common.Logging; forward it to the log4net configuration below. -->
      <factoryAdapter type="Common.Logging.Log4Net.Log4NetLoggerFactoryAdapter, Common.Logging.Log4Net208">
        <arg key="configType" value="EXTERNAL" />
      </factoryAdapter>
    </logging>
  </common>
  <log4net>
    <appender name="File" type="log4net.Appender.RollingFileAppender">
      <file type="log4net.Util.PatternString" value="%property{LogDir}\pricesync.log" />
      <appendToFile value="true" />
      <rollingStyle value="Composite" />
      <datePattern value="yyyyMMdd" />
      <maxSizeRollBackups value="30" />
      <maximumFileSize value="20MB" />
      <staticLogFileName value="true" />
      <layout type="log4net.Layout.PatternLayout">
        <conversionPattern value="%date [%thread] %-5level %logger - %message%newline%exception" />
      </layout>
    </appender>
    <appender name="Console" type="log4net.Appender.ConsoleAppender">
      <layout type="log4net.Layout.PatternLayout">
        <conversionPattern value="%date{HH:mm:ss} %-5level %logger{1} - %message%newline%exception" />
      </layout>
    </appender>
    <appender name="EventLog" type="log4net.Appender.EventLogAppender">
      <applicationName value="Tailspin Dealer Price Sync" />
      <threshold value="ERROR" />
      <layout type="log4net.Layout.PatternLayout">
        <conversionPattern value="%logger - %message%newline%exception" />
      </layout>
    </appender>
    <root>
      <level value="INFO" />
      <appender-ref ref="File" />
      <appender-ref ref="Console" />
      <appender-ref ref="EventLog" />
    </root>
  </log4net>
  <entityFramework>
    <providers>
      <provider invariantName="System.Data.SqlClient" type="System.Data.Entity.SqlServer.SqlProviderServices, EntityFramework.SqlServer" />
    </providers>
  </entityFramework>
  <system.net>
    <defaultProxy enabled="false" />
  </system.net>
</configuration>
