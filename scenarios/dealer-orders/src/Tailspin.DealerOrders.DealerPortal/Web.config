<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="log4net" type="log4net.Config.Log4NetConfigurationSectionHandler, log4net" />
    <section name="entityFramework" type="System.Data.Entity.Internal.ConfigFile.EntityFrameworkSection, EntityFramework, Version=6.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
  </configSections>
  <connectionStrings>
    <add name="DealerOrders" connectionString="Data Source=sql01.corp.local;Initial Catalog=DealerOrders;User ID=dlr_portal;Password=;Application Name=DealerOrders.Portal" providerName="System.Data.SqlClient" />
  </connectionStrings>
  <appSettings>
    <add key="webpages:Version" value="3.0.0.0" />
    <add key="webpages:Enabled" value="false" />
    <add key="ClientValidationEnabled" value="true" />
    <add key="UnobtrusiveJavaScriptEnabled" value="true" />
    <add key="owin:AppStartup" value="Tailspin.DealerOrders.DealerPortal.Startup" />
    <add key="Portal.RequireSsl" value="true" />
    <add key="Portal.SessionHours" value="8" />
    <add key="Portal.LockoutMinutes" value="15" />
    <add key="Portal.MaxFailedLogins" value="5" />
    <add key="Push.ServiceKey" value="" />
    <add key="DocumentService.ClientKey" value="" />
    <add key="Orders.FactoryTimeZone" value="FLE Standard Time" />
    <add key="Orders.QuoteValidityDays" value="30" />
    <add key="Orders.SalesDeskEmail" value="salesdesk@tailspin-machinery.example" />
    <add key="Orders.PortalBaseUrl" value="https://dealers.corp.local/" />
    <add key="Orders.SalesDeskBaseUrl" value="https://salesdesk.corp.local/" />
    <add key="Ax.Company" value="TSM" />
    <add key="Catalog.Folder" value="" />
    <add key="Logging.Folder" value="C:\DealerOrders\Logs" />
  </appSettings>
  <system.web>
    <compilation debug="false" targetFramework="4.6.1">
      <assemblies>
        <add assembly="netstandard, Version=2.0.0.0, Culture=neutral, PublicKeyToken=cc7b13ffcd2ddd51" />
      </assemblies>
    </compilation>
    <httpRuntime targetFramework="4.6.1" maxRequestLength="4096" enableVersionHeader="false" />
    <authentication mode="None" />
    <globalization culture="auto:en-GB" uiCulture="auto:en" />
    <customErrors mode="RemoteOnly" defaultRedirect="~/error.html" />
    <httpCookies httpOnlyCookies="true" requireSSL="false" />
    <sessionState mode="Off" />
    <machineKey validationKey="9E2A6C0B1F7D4E3A8C5B2D9F0E1A7C4B6D3F8E2A5C9B1D7F4E0A3C6B8D2F5E9A1C7B4D0F3E6A8C2B5D9F1E7A4C0B6D3F8E2A5C9B1D7F4E0A3C6B8D2F5E9A1C7B" decryptionKey="4B8E2A6D0F3C7B1E5A9D2F6C0B4E8A3D7F1C5B9E2A6D0F3C7B1E5A9D2F6C0B4E" validation="HMACSHA256" decryption="AES" />
  </system.web>
  <system.webServer>
    <modules>
      <remove name="FormsAuthentication" />
    </modules>
    <handlers>
      <remove name="ExtensionlessUrlHandler-Integrated-4.0" />
      <remove name="OPTIONSVerbHandler" />
      <remove name="TRACEVerbHandler" />
      <add name="ExtensionlessUrlHandler-Integrated-4.0" path="*." verb="*" type="System.Web.Handlers.TransferRequestHandler" preCondition="integratedMode,runtimeVersionv4.0" />
    </handlers>
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="X-Content-Type-Options" value="nosniff" />
      </customHeaders>
    </httpProtocol>
    <staticContent>
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="7.00:00:00" />
    </staticContent>
  </system.webServer>
  <system.serviceModel>
    <bindings>
      <basicHttpBinding>
        <binding name="documents" maxReceivedMessageSize="16777216" sendTimeout="00:02:00">
          <readerQuotas maxArrayLength="16777216" />
          <security mode="Transport" />
        </binding>
      </basicHttpBinding>
    </bindings>
    <client>
      <endpoint name="DocumentService" address="https://docs.corp.local/DocumentService.svc" binding="basicHttpBinding" bindingConfiguration="documents" contract="Tailspin.DealerOrders.Infrastructure.DocumentService.IDocumentService" />
    </client>
  </system.serviceModel>
  <log4net>
    <appender name="File" type="log4net.Appender.RollingFileAppender">
      <file type="log4net.Util.PatternString" value="%property{LogDir}\dealerportal.log" />
      <appendToFile value="true" />
      <rollingStyle value="Composite" />
      <datePattern value="yyyyMMdd" />
      <maxSizeRollBackups value="30" />
      <maximumFileSize value="20MB" />
      <staticLogFileName value="true" />
      <layout type="log4net.Layout.PatternLayout">
        <conversionPattern value="%date [%thread] %-5level %logger - %message%newline%exception" />
      </layout>
    </appender>
    <root>
      <level value="INFO" />
      <appender-ref ref="File" />
    </root>
  </log4net>
  <entityFramework>
    <providers>
      <provider invariantName="System.Data.SqlClient" type="System.Data.Entity.SqlServer.SqlProviderServices, EntityFramework.SqlServer" />
    </providers>
  </entityFramework>
