@model PagedResult<OrderListItem>
@{
    ViewBag.Title = "Orders";
}
<h2>Orders <small>@Model.Total</small></h2>
<form class="form-inline" method="get">
    <input name="text" value="@ViewBag.Text" class="form-control" placeholder="Order, PO, AX order, dealer or item" />
    @Html.DropDownList("status", EnumHelper.GetSelectList(typeof(OrderStatus)), "Any status", new { @class = "form-control" })
    @Html.DropDownList("source", EnumHelper.GetSelectList(typeof(OrderSource)), "Any source", new { @class = "form-control" })
    <label class="checkbox-inline"><input type="checkbox" name="openOnly" value="true" @(ViewBag.OpenOnly ? "checked" : "") /> Open only</label>
    <button class="btn btn-default">Search</button>
</form>
<table class="table table-striped table-condensed">
    <thead><tr><th>Order</th><th>AX</th><th>Dealer</th><th>PO</th><th>Item</th><th>Source</th><th>Status</th><th class="text-right">Value</th><th>Created</th><th>Delivery</th></tr></thead>
    <tbody>
        @foreach (var o in Model.Items)
        {
            <tr class="@(o.Status == OrderStatus.Error ? "danger" : "")">
                <td>@Html.ActionLink(o.OrderNumber, "Details", new { id = o.Id })</td>
                <td>@o.AxSalesId</td>
                <td>@o.DealerAccount @o.DealerName</td>
                <td>@o.DealerPoNumber</td>
                <td>@o.FirstItem</td>
                <td>@o.Source</td>
                <td>@o.Status</td>
                <td class="text-right">@o.NetValue.ToString("N2") @o.Currency</td>
                <td>@o.CreatedUtc.ToLocalTime().ToString("g")</td>
                <td>@((o.ConfirmedDeliveryDate ?? o.RequestedDeliveryDate)?.ToString("d"))</td>
            </tr>
        }
    </tbody>
</table>
<ul class="pagination">
    @for (var p = 1; p <= Model.Pages; p++)
    {
        <li class="@(p == Model.Page ? "active" : "")"><a href="@Url.Action("Index", new { text = ViewBag.Text, status = ViewBag.Status, source = ViewBag.Source, openOnly = ViewBag.OpenOnly, page = p })">@p</a></li>
    }
</ul>
