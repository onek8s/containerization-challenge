@model ProductModel
@{
    ViewBag.Title = Model.ModelCode;
}
<h2>@Model.Name <small>@Model.ModelCode @Model.ItemId</small></h2>
@if (ViewBag.RuleError != null)
{
    <div class="alert alert-danger">Rule error: @ViewBag.RuleError</div>
}
<div class="row">
    <div class="col-md-6">
        @foreach (var g in Model.OptionGroups.OrderBy(x => x.SortOrder))
        {
            <h4>@g.Name <small>@g.Code, @g.Kind</small></h4>
            <ul>@foreach (var o in g.Options) { <li><code>@o.Code</code> @o.Name <small class="text-muted">@o.ItemId @(o.IsDefault ? "default" : "") @(o.Markets != null && o.Markets.Count > 0 ? string.Join(",", o.Markets) : "")</small></li> }</ul>
        }
    </div>
    <div class="col-md-6">
        <h4>Rules</h4>
        <table class="table table-condensed">
            @foreach (var r in Model.Rules)
            {
                <tr><td><code>@r.Expression</code></td><td>@r.Message</td></tr>
            }
        </table>
    </div>
</div>
