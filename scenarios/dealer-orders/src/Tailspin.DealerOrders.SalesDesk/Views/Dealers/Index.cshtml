@model IList<Dealer>
@{
    ViewBag.Title = "Dealers";
}
<h2>Dealers</h2>
<form class="form-inline" method="get"><input name="search" value="@ViewBag.Search" class="form-control" placeholder="Name or account" /> <button class="btn btn-default">Search</button></form>
<table class="table table-striped table-condensed">
    <thead><tr><th>Account</th><th>Name</th><th>Country</th><th>Tier</th><th>Price group</th><th class="text-right">Credit limit</th><th class="text-right">Open balance</th><th>Status</th><th>Synced</th></tr></thead>
    @foreach (var d in Model)
    {
        <tr class="@(d.CreditHold ? "warning" : "")">
            <td>@Html.ActionLink(d.AccountNumber, "Details", new { id = d.Id })</td><td>@d.Name</td><td>@d.CountryCode</td><td>@d.DiscountTier</td><td>@d.PriceGroup</td>
            <td class="text-right">@d.CreditLimit.ToString("N0") @d.Currency</td><td class="text-right">@d.OpenBalance.ToString("N0")</td>
            <td>@d.Status @(d.CreditHold ? "(credit hold)" : "")</td><td>@d.LastSyncedUtc?.ToLocalTime().ToString("g")</td>
        </tr>
    }
</table>
