<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="log4net" type="log4net.Config.Log4NetConfigurationSectionHandler, log4net" />
    <section name="entityFramework" type="System.Data.Entity.Internal.ConfigFile.EntityFrameworkSection, EntityFramework, Version=6.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
  </configSections>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
  </startup>
  <connectionStrings>
    <add name="DealerOrders" connectionString="Data Source=sql01.corp.local;Initial Catalog=DealerOrders;User ID=dlr_notify;Password=;Application Name=DealerOrders.Notifications" providerName="System.Data.SqlClient" />
  </connectionStrings>
  <appSettings>
    <add key="Orders.FactoryTimeZone" value="FLE Standard Time" />
    <add key="Orders.SalesDeskEmail" value="salesdesk@tailspin-machinery.example" />
    <add key="Orders.PortalBaseUrl" value="https://dealers.corp.local/" />
    <add key="Orders.SalesDeskBaseUrl" value="https://salesdesk.corp.local/" />
    <add key="Catalog.Folder" value="" />
    <add key="Notifications.Interval" value="00:00:10" />
    <add key="Notifications.BatchSize" value="50" />
    <add key="Mail.Host" value="smtp.corp.local" />
    <add key="Mail.Port" value="25" />
    <add key="Mail.EnableSsl" value="false" />
    <add key="Mail.From" value="Tailspin Machinery Dealer Orders &lt;dealer-orders@tailspin-machinery.example&gt;" />
    <add key="Mail.PickupDirectory" value="" />
    <add key="Push.Enabled" value="true" />
    <add key="Push.PortalUrl" value="https://dealers.corp.local/" />
    <add key="Push.ServiceKey" value="" />
    <add key="Logging.Folder" value="C:\DealerOrders\Logs" />
  </appSettings>
  <log4net>
    <appender name="File" type="log4net.Appender.RollingFileAppender">
      <file type="log4net.Util.PatternString" value="%property{LogDir}\notifications.log" />
      <appendToFile value="true" />
      <rollingStyle value="Composite" />
      <datePattern value="yyyyMMdd" />
      <maxSizeRollBackups value="30" />
      <maximumFileSize value="20MB" />
      <staticLogFileName value="true" />
      <layout type="log4net.Layout.PatternLayout">
        <conversionPattern value="%date [%thread] %-5level %logger - %message%newline%exception" />
      </layout>
    </appender>
    <appender name="Console" type="log4net.Appender.ConsoleAppender">
      <layout type="log4net.Layout.PatternLayout">
        <conversionPattern value="%date{HH:mm:ss} %-5level %logger{1} - %message%newline%exception" />
      </layout>
    </appender>
    <root>
      <level value="INFO" />
      <appender-ref ref="File" />
      <appender-ref ref="Console" />
    </root>
  </log4net>
  <entityFramework>
    <providers>
      <provider invariantName="System.Data.SqlClient" type="System.Data.Entity.SqlServer.SqlProviderServices, EntityFramework.SqlServer" />
    </providers>
  </entityFramework>
  <system.net>
    <defaultProxy enabled="false" />
  </system.net>
</configuration>
