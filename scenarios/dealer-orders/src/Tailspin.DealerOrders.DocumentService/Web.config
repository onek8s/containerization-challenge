<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="log4net" type="log4net.Config.Log4NetConfigurationSectionHandler, log4net" />
    <section name="entityFramework" type="System.Data.Entity.Internal.ConfigFile.EntityFrameworkSection, EntityFramework, Version=6.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
  </configSections>
  <connectionStrings>
    <add name="DealerOrders" connectionString="Data Source=sql01.corp.local;Initial Catalog=DealerOrders;User ID=dlr_docs;Password=;Application Name=DealerOrders.DocumentService" providerName="System.Data.SqlClient" />
  </connectionStrings>
  <appSettings>
    <add key="DocumentService.ClientKeys" value="portal=;salesdesk=" />
    <add key="Documents.TemplateFolder" value="" />
    <add key="Documents.SignatoryName" value="Kari Lehtonen" />
    <add key="Documents.SignatoryTitle" value="Sales Director, Dealer Network" />
    <add key="Orders.FactoryTimeZone" value="FLE Standard Time" />
    <add key="Catalog.Folder" value="" />
    <add key="Logging.Folder" value="C:\DealerOrders\Logs" />
  </appSettings>
  <system.web>
    <compilation debug="false" targetFramework="4.7.2">
      <assemblies>
        <add assembly="netstandard, Version=2.0.0.0, Culture=neutral, PublicKeyToken=cc7b13ffcd2ddd51" />
      </assemblies>
    </compilation>
    <httpRuntime targetFramework="4.7.2" maxRequestLength="16384" enableVersionHeader="false" />
    <customErrors mode="RemoteOnly" />
  </system.web>
  <system.webServer>
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
  <system.serviceModel>
    <serviceHostingEnvironment aspNetCompatibilityEnabled="true" multipleSiteBindingsEnabled="true" />
    <bindings>
      <basicHttpBinding>
        <binding name="documents" maxReceivedMessageSize="16777216" sendTimeout="00:02:00">
          <readerQuotas maxArrayLength="16777216" maxStringContentLength="1048576" />
        </binding>
      </basicHttpBinding>
    </bindings>
    <behaviors>
      <serviceBehaviors>
        <behavior name="documents">
          <serviceMetadata httpGetEnabled="true" />
          <serviceDebug includeExceptionDetailInFaults="false" />
          <serviceThrottling maxConcurrentCalls="16" maxConcurrentInstances="16" />
        </behavior>
      </serviceBehaviors>
    </behaviors>
    <services>
      <service name="Tailspin.DealerOrders.DocumentService.DocumentService" behaviorConfiguration="documents">
        <endpoint address="" binding="basicHttpBinding" bindingConfiguration="documents" contract="Tailspin.DealerOrders.Infrastructure.DocumentService.IDocumentService"
                  bindingNamespace="http://schemas.tailspin-machinery.example/dealerorders/documents/2016/04" />
        <endpoint address="mex" binding="mexHttpBinding" contract="IMetadataExchange" />
      </service>
    </services>
  </system.serviceModel>
  <log4net>
    <appender name="File" type="log4net.Appender.RollingFileAppender">
      <file type="log4net.Util.PatternString" value="%property{LogDir}\documentservice.log" />
      <appendToFile value="true" />
      <rollingStyle value="Composite" />
      <datePattern value="yyyyMMdd" />
      <maxSizeRollBackups value="30" />
      <maximumFileSize value="20MB" />
      <staticLogFileName value="true" />
      <layout type="log4net.Layout.PatternLayout">
        <conversionPattern value="%date [%thread] %-5level %logger - %message%newline%exception" />
      </layout>
    </appender>
    <root>
      <level value="INFO" />
      <appender-ref ref="File" />
    </root>
  </log4net>
  <entityFramework>
    <providers>
      <provider invariantName="System.Data.SqlClient" type="System.Data.Entity.SqlServer.SqlProviderServices, EntityFramework.SqlServer" />
    </providers>
  </entityFramework>
</configuration>
