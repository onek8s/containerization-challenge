<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>

  <connectionStrings>
    <add name="MeterBilling" connectionString="Data Source=sql01.corp.local;Initial Catalog=MeterBilling;Integrated Security=SSPI;Application Name=Billing Monitor" providerName="System.Data.SqlClient" />
  </connectionStrings>

  <appSettings>
    <add key="EngineUrl" value="http://billing-engine.corp.local:8441/" />
    <add key="EngineLogShare" value="\\billing-engine.corp.local\BillingLogs$" />
    <add key="RefreshSeconds" value="15" />
  </appSettings>
</configuration>
