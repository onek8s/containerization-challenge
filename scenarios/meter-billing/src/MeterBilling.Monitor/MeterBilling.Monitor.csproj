<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <RootNamespace>Coho.Billing.Monitor</RootNamespace>
    <AssemblyName>BillingMonitor</AssemblyName>
    <Version>3.2.0</Version>
    <Company>Coho Water</Company>
    <Product>Meter Billing</Product>
    <AssemblyTitle>Billing Monitor</AssemblyTitle>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Configuration" />
    <Reference Include="System.Data" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="MainForm.cs" SubType="Form" />
    <Compile Update="MainForm.Designer.cs" DependentUpon="MainForm.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MeterBilling.Core\MeterBilling.Core.csproj" />
    <ProjectReference Include="..\MeterBilling.Data\MeterBilling.Data.csproj" />
  </ItemGroup>

</Project>
