<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>

  <connectionStrings>
    <add name="MeterBilling" connectionString="Data Source=sql01.corp.local;Initial Catalog=MeterBilling;Integrated Security=SSPI;Application Name=MeterBilling.Engine" providerName="System.Data.SqlClient" />
  </connectionStrings>

  <appSettings>
    <!-- Meter read files from the handheld docking stations and the AMR collection system -->
    <add key="ReadInbox" value="\\files01.corp.local\MeterReads$\Inbox" />
    <add key="ReadArchive" value="\\files01.corp.local\MeterReads$\Processed" />
    <add key="ReadRejected" value="\\files01.corp.local\MeterReads$\Rejected" />
    <add key="FileSettleSeconds" value="30" />

    <!-- Output: print vendor pickup and bank transfer folders -->
    <add key="PrintOutput" value="\\files01.corp.local\BillingOut$\Print" />
    <add key="BankOutput" value="\\files01.corp.local\BillingOut$\Bank" />

    <add key="WorkIntervalSeconds" value="60" />
    <add key="LogFolder" value="D:\MeterBilling\Logs" />

    <!-- Control endpoint used by Billing Monitor and the bill lookup site -->
    <add key="ControlUrl" value="http://+:8441/" />
    <add key="OperatorsGroup" value="CORP\Billing-Operators" />
    <add key="ReprintCallers" value="CORP\svc-billing-web" />

    <!-- Read checks -->
    <add key="HighFactor" value="3.0" />
    <add key="LowFactor" value="0.2" />
    <add key="MinimumCheckedConsumption" value="5" />

    <!-- Runs with no open exceptions and a total up to this amount (EUR) are released without operator approval -->
    <add key="AutoReleaseLimit" value="250000" />
    <add key="BillDateOffsetDays" value="3" />

    <!-- SEPA direct debit -->
    <add key="CreditorName" value="Coho Water Ltd" />
    <add key="CreditorIban" value="FI7944052020036082" />
    <add key="CreditorBic" value="NDEAFIHH" />
    <add key="CreditorId" value="FI22ZZZ12345678" />
  </appSettings>

  <system.diagnostics>
    <trace autoflush="true" />
  </system.diagnostics>

  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="Newtonsoft.Json" publicKeyToken="30ad4fe6b2a6aeed" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-13.0.0.0" newVersion="13.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Microsoft.Owin" publicKeyToken="31bf3856ad364e35" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-4.2.2.0" newVersion="4.2.2.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Web.Http" publicKeyToken="31bf3856ad364e35" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-5.3.0.0" newVersion="5.3.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Net.Http.Formatting" publicKeyToken="31bf3856ad364e35" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-5.3.0.0" newVersion="5.3.0.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
</configuration>
