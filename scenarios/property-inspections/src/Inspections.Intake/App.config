<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <appSettings>
    <!-- Relative to the PhotoShare registry value. -->
    <add key="IntakeFolder" value="Intake" />
    <add key="PollSeconds" value="60" />
    <add key="SettleSeconds" value="20" />
  </appSettings>
  <system.diagnostics>
    <trace autoflush="true">
      <listeners>
        <add name="file" type="System.Diagnostics.TextWriterTraceListener" initializeData="C:\ProgramData\Northwind\Inspections\Logs\intake.log" />
      </listeners>
    </trace>
  </system.diagnostics>
</configuration>
