<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.diagnostics>
    <trace autoflush="true">
      <listeners>
        <add name="file" type="System.Diagnostics.TextWriterTraceListener" initializeData="C:\ProgramData\Northwind\Inspections\Logs\service.log" />
      </listeners>
    </trace>
  </system.diagnostics>
  <system.web>
    <compilation debug="true" targetFramework="4.8">
      <assemblies>
        <add assembly="netstandard, Version=2.0.0.0, Culture=neutral, PublicKeyToken=cc7b13ffcd2ddd51" />
      </assemblies>
    </compilation>
    <httpRuntime targetFramework="4.8" maxRequestLength="20480" enableVersionHeader="false" />
    <globalization culture="en-IE" uiCulture="en-IE" />
    <!-- Media requests arrive through the portal with its sign-in cookie. -->
    <authentication mode="Forms">
      <forms name=".NWINSPECT" loginUrl="https://inspections.corp.local/account/login" protection="All" path="/" timeout="480" slidingExpiration="true" requireSSL="false" />
    </authentication>
    <machineKey validationKey="2274DDCAFB8E9ED05E6937D6484D10497693D5F82D8743D96E3A8149E28D68C48FC69920E261D1190A1A00D74001813341D461A8D973A4DC5B8B49505AC59B18" decryptionKey="3BB4CC28B6410F76B777756503F0298A7FE2353D9F89889D2840595A092FC6E3" validation="HMACSHA256" decryption="AES" />
    <customErrors mode="RemoteOnly" />
  </system.web>
  <system.webServer>
    <modules runAllManagedModulesForAllRequests="false">
      <remove name="FormsAuthentication" />
      <add name="FormsAuthentication" type="System.Web.Security.FormsAuthenticationModule" preCondition="" />
    </modules>
    <handlers>
      <add name="InspectionMedia" path="media/*" verb="GET,HEAD" type="Northwind.Inspections.Service.MediaHandler, Inspections.Service" preCondition="integratedMode" />
    </handlers>
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="20971520" />
      </requestFiltering>
    </security>
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
  <location path="PhotoService.svc">
    <system.webServer>
      <!-- Only the portal servers call the photo service. Addresses are set by deploy\Install-IisSites.ps1. -->
      <security>
        <ipSecurity allowUnlisted="false">
          <add ipAddress="127.0.0.1" allowed="true" />
          <add ipAddress="::1" allowed="true" />
        </ipSecurity>
      </security>
    </system.webServer>
  </location>
  <system.serviceModel>
    <serviceHostingEnvironment aspNetCompatibilityEnabled="true" multipleSiteBindingsEnabled="true" />
    <bindings>
      <basicHttpBinding>
        <binding name="photoUpload" messageEncoding="Mtom" maxReceivedMessageSize="20971520" maxBufferPoolSize="20971520"
                 sendTimeout="00:02:00" receiveTimeout="00:05:00">
          <readerQuotas maxArrayLength="20971520" maxStringContentLength="1048576" />
        </binding>
      </basicHttpBinding>
      <wsHttpBinding>
        <binding name="partner" maxReceivedMessageSize="8388608">
          <readerQuotas maxArrayLength="8388608" />
          <security mode="TransportWithMessageCredential">
            <message clientCredentialType="UserName" establishSecurityContext="false" negotiateServiceCredential="false" />
          </security>
        </binding>
      </wsHttpBinding>
    </bindings>
    <behaviors>
      <serviceBehaviors>
        <behavior name="photo">
          <serviceMetadata httpGetEnabled="true" />
          <serviceDebug includeExceptionDetailInFaults="false" />
          <serviceThrottling maxConcurrentCalls="32" maxConcurrentInstances="32" maxConcurrentSessions="100" />
        </behavior>
        <behavior name="partner">
          <serviceMetadata httpsGetEnabled="true" />
          <serviceDebug includeExceptionDetailInFaults="false" />
          <serviceCredentials>
            <userNameAuthentication userNamePasswordValidationMode="Custom"
                                    customUserNamePasswordValidatorType="Northwind.Inspections.Service.PartnerPasswordValidator, Inspections.Service" />
          </serviceCredentials>
        </behavior>
      </serviceBehaviors>
    </behaviors>
    <services>
      <service name="Northwind.Inspections.Service.PhotoService" behaviorConfiguration="photo">
        <endpoint address="" binding="basicHttpBinding" bindingConfiguration="photoUpload"
                  contract="Northwind.Inspections.Contracts.IPhotoService" bindingNamespace="http://schemas.northwind-insurance.example/inspections/2019/03" />
        <endpoint address="mex" binding="mexHttpBinding" contract="IMetadataExchange" />
      </service>
      <service name="Northwind.Inspections.Service.ClaimStatusService" behaviorConfiguration="partner">
        <endpoint address="" binding="wsHttpBinding" bindingConfiguration="partner"
                  contract="Northwind.Inspections.Contracts.IClaimStatusService" bindingNamespace="http://schemas.northwind-insurance.example/inspections/partner/2020/11" />
        <endpoint address="mex" binding="mexHttpsBinding" contract="IMetadataExchange" />
      </service>
    </services>
    <diagnostics>
      <messageLogging logMessagesAtServiceLevel="false" logMalformedMessages="true" />
    </diagnostics>
  </system.serviceModel>
</configuration>
