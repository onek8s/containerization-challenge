<Project Sdk="MSBuild.SDK.SystemWeb">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <RootNamespace>Northwind.Inspections.Web</RootNamespace>
    <AssemblyName>Inspections.Web</AssemblyName>
    <AppConfig>Web.config</AppConfig>
    <Version>3.2.0</Version>
    <Company>Northwind Insurance</Company>
    <Product>Property Inspections</Product>
    <GeneratedBindingRedirectsAction>None</GeneratedBindingRedirectsAction>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="Microsoft.AspNet.Mvc" Version="5.3.0" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.ComponentModel.DataAnnotations" />
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.Configuration" />
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="System.ServiceModel" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Views\**\*.cshtml" />
    <Content Include="Views\Web.config" />
    <Content Include="Content\**\*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Inspections.Core\Inspections.Core.csproj" />
    <ProjectReference Include="..\Inspections.Contracts\Inspections.Contracts.csproj" />
    <ProjectReference Include="..\Inspections.Infrastructure\Inspections.Infrastructure.csproj" />
  </ItemGroup>

</Project>
