{
  "Database": { "Provider": "SqlServer" },
  "ConnectionStrings": { "Permits": "Server=permits-sql.corp.local;Database=CityPermits;Integrated Security=True;Encrypt=True;Application Name=Permits Back Office" },
  "Archive": { "Provider": "FileTable" },
  "Authentication": {
    "Mode": "WsFederation",
    "MetadataAddress": "https://adfs.corp.local/FederationMetadata/2007-06/FederationMetadata.xml",
    "Realm": "https://permits-office.corp.local/"
  },
  "Gis": {
    "Provider": "Geomatix",
    "InstallDir": "C:\\Program Files\\Geomatix\\Pro",
    "LicenceLevel": "Standard",
    "ReplicaPath": "D:\\Gis\\Replica\\Ashford.ggdb",
    "MapDocument": "D:\\Gis\\Maps\\Permits.gmapx",
    "LayoutFolder": "D:\\Gis\\Layouts"
  },
