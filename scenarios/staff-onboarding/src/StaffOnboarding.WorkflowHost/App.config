<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>

  <connectionStrings>
    <add name="Onboarding" connectionString="Data Source=sql01.corp.local;Initial Catalog=StaffOnboarding;Integrated Security=SSPI;Application Name=StaffOnboarding.WorkflowHost" providerName="System.Data.SqlClient" />
    <add name="InstanceStore" connectionString="Data Source=sql01.corp.local;Initial Catalog=StaffOnboardingInstances;Integrated Security=SSPI;Asynchronous Processing=True;Application Name=StaffOnboarding.WorkflowHost" providerName="System.Data.SqlClient" />
  </connectionStrings>

  <appSettings>
    <add key="BaseAddress" value="http://onboarding-flow.corp.local:8085/StaffOnboarding/" />
    <add key="ProvisioningUrl" value="http://idm01.corp.local:8090/" />
    <add key="ProvisioningTimeout" value="00:01:40" />
    <add key="PortalUrl" value="http://onboarding.corp.local" />

    <!-- Templates, welcome packs and IT owned configuration live on the onboarding share. -->
    <add key="OnboardingShare" value="\\files01.corp.local\Onboarding$" />
    <add key="AccessMapPath" value="\\files01.corp.local\Onboarding$\Config\access-map.xml" />
    <add key="HolidaysPath" value="\\files01.corp.local\Onboarding$\Config\holidays.txt" />
    <add key="OfficeTimeZone" value="FLE Standard Time" />

    <add key="SmtpHost" value="smtp.corp.local" />
    <add key="SmtpPort" value="25" />
    <add key="MailFrom" value="onboarding@litware.com" />
    <add key="MailDomain" value="litware.com" />

    <add key="ITApprovers" value="group:APP-Onboarding-IT" />
    <add key="ITEscalation" value="group:APP-Onboarding-IT-Leads" />
    <add key="HRTeam" value="group:APP-Onboarding-HR" />
    <add key="ServiceDesk" value="group:APP-ServiceDesk-Agents" />

    <!-- Accounts or groups allowed to call the workflow endpoints (the portal app pool account). -->
    <add key="AllowedCallers" value="CORP\svc-onbweb$" />

    <add key="Schedule.ProvisioningLeadBusinessDays" value="3" />
    <add key="Schedule.ProvisioningTimeOfDay" value="06:00:00" />
    <add key="Schedule.ApprovalReminderInterval" value="2.00:00:00" />
    <add key="Schedule.RemindersBeforeEscalation" value="2" />
    <add key="Schedule.EscalationsBeforeExpiry" value="1" />
    <add key="Schedule.LeaverDisableTimeOfDay" value="18:00:00" />
    <add key="Schedule.CleanupDelay" value="30.00:00:00" />
    <add key="Schedule.ProvisioningRetryDelay" value="00:15:00" />
    <add key="Schedule.ProvisioningMaxAttempts" value="8" />
  </appSettings>

  <system.net>
    <defaultProxy enabled="false" />
    <mailSettings>
      <smtp deliveryMethod="Network">
        <network host="smtp.corp.local" port="25" defaultCredentials="true" />
      </smtp>
    </mailSettings>
  </system.net>

  <system.serviceModel>
    <serviceHostingEnvironment multipleSiteBindingsEnabled="false" />
    <diagnostics>
      <messageLogging logMalformedMessages="true" logMessagesAtServiceLevel="false" logMessagesAtTransportLevel="false" />
    </diagnostics>
  </system.serviceModel>

  <system.diagnostics>
    <sources>
      <source name="System.ServiceModel" switchValue="Warning, ActivityTracing" propagateActivity="true">
        <listeners>
          <add name="svclog" />
        </listeners>
      </source>
    </sources>
    <sharedListeners>
      <add name="svclog" type="System.Diagnostics.XmlWriterTraceListener" initializeData="D:\Logs\StaffOnboarding\WorkflowHost.svclog" />
    </sharedListeners>
    <trace autoflush="true" />
  </system.diagnostics>
</configuration>
