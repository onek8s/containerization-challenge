@model IList<DocumentViewModel>
@{ ViewData["Title"] = "Letters and documents"; }
<h1 class="h3">Letters and documents</h1>
@if (Model.Count == 0)
{
    <p class="text-muted">There are no documents to show yet.</p>
}
else
{
    <table class="table table-sm bg-white">
        <thead><tr><th>Date</th><th>Document</th><th>Type</th><th></th></tr></thead>
        <tbody>
        @foreach (var d in Model)
        {
            <tr>
                <td>@d.UploadedAt.ToString("d MMM yyyy")</td>
                <td>@d.Title</td>
                <td>@d.Category</td>
                <td><a asp-action="Download" asp-route-id="@d.DocumentKey">Download (@(Math.Max(1, d.SizeBytes / 1024)) KB)</a></td>
            </tr>
        }
        </tbody>
    </table>
}
