@model DirectDebitViewModel
@{ ViewData["Title"] = "Direct debit"; }
<h1 class="h3">Direct debit</h1>
@if (Model.Current != null)
{
    <div class="tile mb-4">
        <h2>Your direct debit</h2>
        <p>@Money.Format(Model.Current.Amount), @Model.Current.Schedule, from @Model.Current.AccountHolderName (account ending @Model.Current.AccountNumberEnding).</p>
        <p>Status: @Model.Current.Status@(Model.Current.NextCollectionDate.HasValue ? ". Next collection " + Model.Current.NextCollectionDate.Value.ToString("d MMMM yyyy") : "")</p>
        <form asp-action="Cancel" method="post" onsubmit="return confirm('Cancel your direct debit?');">
            <button type="submit" class="btn btn-outline-danger btn-sm">Cancel direct debit</button>
        </form>
    </div>
    <h2 class="h5">Change your direct debit</h2>
    <p>You will be asked to confirm your bank details again. Your current direct debit is cancelled when the new one is set up.</p>
}
else
{
    <p>Set up a direct debit to pay your rent automatically. Your weekly charge is @Money.Format(Model.WeeklyCharge).</p>
}
<form asp-action="Index" method="post" class="col-md-6 px-0">
    <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>
    <div class="form-group">
        <label asp-for="Frequency">How often?</label>
        <select asp-for="Frequency" asp-items="Html.GetEnumSelectList<CollectionFrequency>()" class="form-control"></select>
    </div>
    <div class="form-group">
        <label asp-for="CollectionDay">Collection day</label>
        <input asp-for="CollectionDay" class="form-control" type="number" min="1" max="28" />
        <small class="form-text text-muted">Monthly: day of the month 1 to 28. Weekly, fortnightly or four-weekly: 1 = Monday to 5 = Friday.</small>
        <span asp-validation-for="CollectionDay" class="field-validation-error"></span>
    </div>
    <div class="form-group">
        <label asp-for="Amount">Amount (£)</label>
        <input asp-for="Amount" class="form-control" type="number" step="0.01" />
        <small class="form-text text-muted">To cover your rent: weekly @Model.SuggestedWeekly.ToString("N2"), fortnightly @Model.SuggestedFortnightly.ToString("N2"), every four weeks @Model.SuggestedFourWeekly.ToString("N2"), monthly @Model.SuggestedMonthly.ToString("N2").</small>
        <span asp-validation-for="Amount" class="field-validation-error"></span>
    </div>
    <div class="form-group form-check">
        <input asp-for="ConfirmAccountHolder" class="form-check-input" />
        <label asp-for="ConfirmAccountHolder" class="form-check-label">I am the account holder and the only person needed to authorise debits from this account</label>
        <span asp-validation-for="ConfirmAccountHolder" class="field-validation-error d-block"></span>
    </div>
    <button type="submit" class="btn btn-primary">Continue to enter bank details</button>
</form>
