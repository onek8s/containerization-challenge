@model IList<EnquiryViewModel>
@{ ViewData["Title"] = "Messages"; }
<div class="d-flex justify-content-between align-items-center">
    <h1 class="h3">Messages</h1>
    <a class="btn btn-primary" asp-action="New">Send us a message</a>
</div>
@if (Model.Count == 0) { <p class="text-muted mt-3">You have not sent us any messages.</p> }
@foreach (var e in Model)
{
    <div class="tile my-3">
        <div class="small text-muted">@e.CreatedAt.ToString("d MMM yyyy HH:mm") &middot; @e.Topic</div>
        <strong>@e.Subject</strong>
        <p class="mb-1">@e.Message</p>
        @if (e.Response != null)
        {
            <div class="border-left pl-3 mt-2"><div class="small text-muted">Our reply, @e.RespondedAt?.ToString("d MMM yyyy")</div>@e.Response</div>
        }
        else
        {
            <div class="small text-muted">Waiting for a reply</div>
        }
    </div>
}
