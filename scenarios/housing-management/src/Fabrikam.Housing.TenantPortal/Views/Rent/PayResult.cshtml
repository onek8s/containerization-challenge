@model PayResultViewModel
@{ ViewData["Title"] = "Payment"; }
@if (Model.Succeeded)
{
    <h1 class="h3">Thank you for your payment</h1>
    <p>We have received @Money.Format(Model.Amount). Your payment reference is <strong>@Model.PaymentReference</strong>.</p>
}
else
{
    <h1 class="h3">Your payment did not go through</h1>
    <p>Status: @Model.Status. You have not been charged. <a asp-action="Pay">Try again</a>.</p>
}
<a asp-action="Statement">See your statement</a>
