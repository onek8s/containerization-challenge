@model IList<RepairSummary>
@if (Model.Count == 0)
{
    <p class="text-muted mt-3">You have no repairs to show.</p>
}
else
{
    <table class="table table-sm bg-white mt-3">
        <thead><tr><th>Reference</th><th>Problem</th><th>Reported</th><th>Status</th><th>Appointment</th></tr></thead>
        <tbody>
        @foreach (var r in Model)
        {
            <tr>
                <td><a asp-controller="Repairs" asp-action="Details" asp-route-id="@r.Reference">@r.Reference</a></td>
                <td>@r.Description<br /><span class="small text-muted">@r.Location</span></td>
                <td>@r.ReportedAt.ToString("d MMM yyyy")</td>
                <td>@r.StatusText</td>
                <td>@(r.NextAppointment.HasValue && r.Status != WorkOrderStatus.Completed ? r.NextAppointment.Value.ToString("ddd d MMM") + " " + SlotText.For(r.NextSlot) : "")</td>
            </tr>
        }
        </tbody>
    </table>
}
