<!DOCTYPE html>
<html lang="en-GB">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Fabrikam Homes tenant portal</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/4.6.0/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <nav class="navbar navbar-expand-md navbar-dark brand-bar">
        <div class="container">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">Fabrikam Homes</a>
            @if (User.Identity.IsAuthenticated)
            {
                <ul class="navbar-nav mr-auto">
                    <li class="nav-item"><a class="nav-link" asp-controller="Rent" asp-action="Statement">My rent</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Repairs" asp-action="Index">Repairs</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Documents" asp-action="Index">Letters and documents</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Messages" asp-action="Index">Messages</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Profile" asp-action="Index">My details</a></li>
                </ul>
                <form asp-controller="Home" asp-action="SignOut" method="post" class="form-inline">
                    <span class="navbar-text mr-3">@User.FindFirst("name")?.Value</span>
                    <button type="submit" class="btn btn-sm btn-outline-light">Sign out</button>
                </form>
            }
        </div>
    </nav>
    <main class="container py-4">
        @if (TempData["Message"] != null)
        {
            <div class="alert alert-success">@TempData["Message"]</div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">@TempData["Error"]</div>
        }
        @RenderBody()
    </main>
    <footer class="container small text-muted py-3 border-top">
        Emergency repairs out of hours: 0300 123 4568. Smell gas? Call 0800 111 999. General enquiries: 0300 123 4567, Monday to Friday 8am to 6pm.
    </footer>
</body>
</html>
