@model StatementViewModel
@{ ViewData["Title"] = "Statement " + Model.Tenancy.Reference; }
<h1 class="h3">Rent statement &middot; @Model.Tenancy.Reference</h1>
<p class="text-muted">@string.Join(" & ", Model.Tenancy.Tenants.Select(n => n.FullName)) &middot; @Model.Tenancy.Property.SingleLineAddress</p>
<form method="get" class="form-inline mb-3">
    <label class="mr-2">From</label><input type="date" name="from" value="@Model.From.ToString("yyyy-MM-dd")" class="form-control form-control-sm mr-2" />
    <label class="mr-2">To</label><input type="date" name="to" value="@Model.To.ToString("yyyy-MM-dd")" class="form-control form-control-sm mr-2" />
    <button class="btn btn-sm btn-primary mr-2">Show</button>
    <a class="btn btn-sm btn-outline-secondary" asp-action="StatementPdf" asp-route-id="@Model.Tenancy.Id" asp-route-from="@Model.From.ToString("yyyy-MM-dd")" asp-route-to="@Model.To.ToString("yyyy-MM-dd")">PDF</a>
</form>
<table class="table table-sm table-striped">
    <thead><tr><th>Date</th><th>Week</th><th>Description</th><th>Reference</th><th class="text-right">Debit</th><th class="text-right">Credit</th><th class="text-right">Balance</th></tr></thead>
    <tbody>
        @foreach (var l in Model.Lines)
        {
            <tr>
                <td>@l.PostedOn.ToString("dd/MM/yyyy")</td>
                <td>@(l.Type == 0 ? "" : "WK" + RentCalendar.WeekNumber(l.RentWeek).ToString("00"))</td>
                <td>@l.Description</td>
                <td>@l.Reference</td>
                <td class="text-right">@(l.Debit > 0 ? l.Debit.ToString("N2") : "")</td>
                <td class="text-right">@(l.Credit > 0 ? l.Credit.ToString("N2") : "")</td>
                <td class="text-right @(l.Balance > 0 ? "text-danger" : "")">@l.Balance.ToString("N2")</td>
            </tr>
        }
    </tbody>
</table>
