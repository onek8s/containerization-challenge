@if (TempData["Message"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">@TempData["Message"]<button type="button" class="close" data-dismiss="alert">&times;</button></div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">@TempData["Error"]<button type="button" class="close" data-dismiss="alert">&times;</button></div>
}
