<!DOCTYPE html>
<html lang="en-GB">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Fabrikam Housing</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/4.6.0/css/bootstrap.min.css" />
    @RenderSection("Styles", required: false)
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-fabrikam">
        <a class="navbar-brand" asp-controller="Home" asp-action="Index">Fabrikam Housing</a>
        <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#nav"><span class="navbar-toggler-icon"></span></button>
        <div class="collapse navbar-collapse" id="nav">
            @if (User.Identity.IsAuthenticated)
            {
                <ul class="navbar-nav mr-auto">
                    <li class="nav-item"><a class="nav-link" asp-controller="Properties" asp-action="Index">Properties</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Tenancies" asp-action="Index">Tenancies</a></li>
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" data-toggle="dropdown">Repairs</a>
                        <div class="dropdown-menu">
                            <a class="dropdown-item" asp-controller="Repairs" asp-action="Triage">Triage queue</a>
                            <a class="dropdown-item" asp-controller="Repairs" asp-action="Index">Open work orders</a>
                            <a class="dropdown-item" asp-controller="Repairs" asp-action="Board">Live board</a>
                        </div>
                    </li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Compliance" asp-action="Index">Compliance</a></li>
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" data-toggle="dropdown">Contractors</a>
                        <div class="dropdown-menu">
                            <a class="dropdown-item" asp-controller="Contractors" asp-action="Index">Contractors</a>
                            @if (User.HasAnyRole(HousingRoles.Finance, HousingRoles.Admin))
                            {
                                <a class="dropdown-item" asp-controller="Contractors" asp-action="Invoices">Invoices to approve</a>
                            }
                        </div>
                    </li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Documents" asp-action="Index">Documents</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Reports" asp-action="Index">Reports</a></li>
                    @if (User.IsInRole(HousingRoles.Admin))
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Index">Admin</a></li>
                    }
                </ul>
                <span class="navbar-text text-light mr-3">
                    @User.DisplayName()
                    @if (!string.IsNullOrEmpty(User.Patch()))
                    {
                        <span class="badge badge-light ml-1">@User.Patch()</span>
                    }
                </span>
                <form asp-controller="Home" asp-action="Logout" method="post" class="form-inline">
                    <button type="submit" class="btn btn-sm btn-outline-light">Sign out</button>
                </form>
            }
        </div>
    </nav>
    <main role="main" class="container-fluid py-3">
        <partial name="_Messages" />
        @RenderBody()
    </main>
    <footer class="footer text-muted small px-3 py-2 border-top">
        Fabrikam Homes &middot; Housing management &middot; @Environment.MachineName
    </footer>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/4.6.0/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
