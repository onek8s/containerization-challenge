@model DocumentUploadInput
@{ ViewData["Title"] = "Upload document"; }
<h1 class="h3">Upload a document</h1>
<form asp-action="Upload" method="post" enctype="multipart/form-data" class="col-lg-6 px-0">
    <div asp-validation-summary="All" class="text-danger"></div>
    <input type="hidden" asp-for="PropertyId" />
    <input type="hidden" asp-for="TenancyId" />
    <div class="form-group"><label asp-for="Title"></label><input asp-for="Title" class="form-control" /></div>
    <div class="form-group"><label asp-for="Category"></label><select asp-for="Category" class="form-control" asp-items="Html.GetEnumSelectList<DocumentCategory>()"></select></div>
    <div class="form-check mb-3"><input asp-for="VisibleToTenant" class="form-check-input" /><label asp-for="VisibleToTenant" class="form-check-label">Show in the tenant portal</label></div>
    <div class="form-group"><input type="file" name="file" class="form-control-file" /></div>
    <button class="btn btn-primary">Upload</button>
</form>
