@{
    ViewData["Title"] = "Repairs board";
    var patch = (string)ViewBag.Patch;
}
<div class="d-flex justify-content-between align-items-center mb-2">
    <h1 class="h3 mb-0">Live repairs board</h1>
    <form method="get" class="form-inline">
        <select name="patch" class="form-control form-control-sm mr-2" onchange="this.form.submit()">
            @foreach (var p in new[] { "ALL", "NORTH", "SOUTH", "EAST" }) { <option value="@p" selected="@(patch == p)">@p</option> }
        </select>
        <span id="board-connection" class="badge badge-secondary">connecting</span>
    </form>
</div>
<div class="row board" id="board" data-patch="@patch" data-source="@Url.Action("BoardData", new { patch })" data-hub="@Url.Content("~/hubs/repairs")">
    @foreach (var column in new[] { "Reported", "Triaged", "Assigned", "Accepted", "Appointed", "InProgress", "NoAccess", "OnHold" })
    {
        <div class="col board-column">
            <h6>@column <span class="badge badge-light" data-count="@column">0</span></h6>
            <div class="board-cards" data-status="@column"></div>
        </div>
    }
</div>
<h6 class="mt-3">Recent activity</h6>
<ul id="board-activity" class="list-unstyled small text-muted"></ul>
@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/5.0.17/signalr.min.js"></script>
    <script src="~/js/repairs-board.js" asp-append-version="true"></script>
}
