@model RaiseWorkOrderInput
@{ ViewData["Title"] = "Raise repair"; }
<h1 class="h3">Raise a repair</h1>
<p class="text-muted">@Model.PropertyAddress</p>
<form asp-action="Raise" method="post" class="col-lg-8 px-0">
    <div asp-validation-summary="All" class="text-danger"></div>
    <input type="hidden" asp-for="PropertyId" />
    <div class="form-row">
        <div class="form-group col-md-6"><label asp-for="Location">Location in the home</label><input asp-for="Location" class="form-control" /></div>
        <div class="form-group col-md-6"><label asp-for="ReportedBy">Reported by</label><input asp-for="ReportedBy" class="form-control" /></div>
    </div>
    <div class="form-group"><label asp-for="Description"></label><textarea asp-for="Description" rows="3" class="form-control"></textarea></div>
    <div class="form-row">
        <div class="form-group col-md-7">
            <label asp-for="SorCode">Schedule of Rates</label>
            <select asp-for="SorCode" class="form-control">
                <option value="">Choose...</option>
                @foreach (var s in Model.Sor)
                {
                    <option value="@s.Code">@s.Code &ndash; @s.Description (@s.Trade, @s.DefaultPriority, @Money.Format(s.UnitPrice)/@s.Unit)</option>
                }
            </select>
        </div>
        <div class="form-group col-md-2"><label asp-for="Quantity"></label><input asp-for="Quantity" class="form-control" /></div>
        <div class="form-group col-md-3">
            <label asp-for="Priority">Priority</label>
            <select asp-for="Priority" class="form-control" asp-items="Html.GetEnumSelectList<RepairPriority>()"><option value="">From SOR code</option></select>
        </div>
    </div>
    <button class="btn btn-primary">Raise work order</button>
    <a class="btn btn-link" asp-controller="Properties" asp-action="Details" asp-route-id="@Model.PropertyId">Cancel</a>
</form>
