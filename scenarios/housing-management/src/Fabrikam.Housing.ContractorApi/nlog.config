<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      internalLogLevel="Warn"
      internalLogFile="D:\Logs\Housing\nlog-internal-contractor-api.log">

  <extensions>
    <add assembly="NLog.Web.AspNetCore"/>
  </extensions>

  <variable name="logFolder" value="${configsetting:item=Logging.Folder:default=D\:\\Logs\\Housing\\contractor-api}" />

  <targets async="true">
    <target xsi:type="File" name="file"
            fileName="${logFolder}/contractor-api-${shortdate}.log"
            archiveEvery="Day" maxArchiveFiles="30"
            layout="${longdate}|${level:uppercase=true}|${logger}|${aspnet-request-url}|${aspnet-user-identity}|${message} ${exception:format=tostring}" />
    <target xsi:type="File" name="access"
            fileName="${logFolder}/access-${shortdate}.log"
            layout="${longdate}|${aspnet-request-method}|${aspnet-request-url}|${aspnet-response-statuscode}|${aspnet-user-identity}|${message}" />
    <target xsi:type="Database" name="database"
            dbProvider="Microsoft.Data.SqlClient.SqlConnection, Microsoft.Data.SqlClient"
            connectionString="${configsetting:item=ConnectionStrings.Housing}"
            commandText="INSERT INTO housing.ErrorLog (Logged, Application, Level, Logger, Message, Exception, MachineName, Url) VALUES (@logged, 'ContractorApi', @level, @logger, @message, @exception, @machine, @url)">
      <parameter name="@logged" layout="${date}" />
      <parameter name="@level" layout="${level}" />
      <parameter name="@logger" layout="${logger}" />
      <parameter name="@message" layout="${message}" />
      <parameter name="@exception" layout="${exception:format=tostring}" />
      <parameter name="@machine" layout="${machinename}" />
      <parameter name="@url" layout="${aspnet-request-url}" />
    </target>
  </targets>

  <rules>
    <logger name="Microsoft.AspNetCore.Hosting.Diagnostics" minlevel="Info" writeTo="access" final="true" />
    <logger name="Microsoft.*" maxlevel="Info" final="true" />
    <logger name="System.Net.Http.*" maxlevel="Info" final="true" />
    <logger name="*" minlevel="Info" writeTo="file" />
    <logger name="*" minlevel="Error" writeTo="database">
      <filters defaultAction="Log">
        <when condition="'${configsetting:item=Database.Provider}' == 'Sqlite'" action="Ignore" />
      </filters>
    </logger>
  </rules>
</nlog>
