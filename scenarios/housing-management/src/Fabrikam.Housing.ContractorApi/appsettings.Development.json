{
  "ConnectionStrings": {
    "Housing": "Data Source=../../.devdata/housing.db"
  },
  "Database": {
    "Provider": "Sqlite"
  },
  "Authentication": {
    "Authority": "http://localhost:5100",
    "RequireHttpsMetadata": false
  },
  "Integration": {
    "Mode": "Simulated",
    "ProxyUrl": "",
    "SimulatorFolder": "../../.devdata/simulators",
    "Payments": {
      "WebhookSecret": "dev-webhook-secret"
    },
    "DocumentService": {
      "BaseUrl": "http://localhost:5105/",
      "ApiKey": "dev-docs-key"
    }
  },
  "Documents": {
    "PdfEngine": "Basic"
  },
  "DataProtection": {
    "KeyFolder": "../../.devdata/keys/contractor-api",
    "ProtectWithDpapi": false
  },
  "Logging": {
    "Folder": "../../.devdata/logs/contractor-api",
    "LogLevel": {
      "Default": "Debug",
      "Microsoft": "Information"
    }
  },
  "AllowedHosts": "*"
}
