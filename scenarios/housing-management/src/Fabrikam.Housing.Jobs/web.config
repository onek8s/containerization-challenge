<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- The application pool must have startMode=AlwaysRunning and the site preloadEnabled=true (see deploy\install-jobs.ps1), otherwise Hangfire stops when IIS recycles an idle pool. -->
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\Fabrikam.Housing.Jobs.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
        </environmentVariables>
      </aspNetCore>
      <applicationInitialization doAppInitAfterRestart="true">
        <add initializationPage="/health" />
      </applicationInitialization>
      <httpProtocol>
        <customHeaders>
          <remove name="X-Powered-By" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
</configuration>
