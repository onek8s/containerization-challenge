{
  "ConnectionStrings": {
    "Housing": "Data Source=../../.devdata/housing.db"
  },
  "Database": {
    "Provider": "Sqlite"
  },
  "Authentication": {
    "Authority": "http://localhost:5100",
    "ClientSecret": "dev-secret-housing-jobs",
    "RequireHttpsMetadata": false
  },
  "Jobs": {
    "TimeZone": "Europe/London",
    "WorkerCount": 2,
    "PrintFolder": "../../.devdata/print",
    "HousingBenefitInbound": "../../.devdata/interfaces/hb/inbound",
    "FinanceOutbound": "../../.devdata/interfaces/finance/outbound",
    "BacsArchiveFolder": "../../.devdata/interfaces/bacs/sent",
    "BackOfficeUrl": "http://localhost:5102/"
  },
  "Integration": {
    "Mode": "Simulated",
    "ProxyUrl": "",
    "SimulatorFolder": "../../.devdata/simulators",
    "DocumentService": {
      "BaseUrl": "http://localhost:5105/",
      "ApiKey": "dev-docs-key"
    }
  },
  "Documents": {
    "PdfEngine": "Basic"
  },
  "DataProtection": {
    "KeyFolder": "../../.devdata/keys/jobs",
    "ProtectWithDpapi": false
  },
  "Logging": {
    "Folder": "../../.devdata/logs/jobs",
    "LogLevel": {
      "Default": "Debug",
      "Microsoft": "Information"
    }
  },
  "AllowedHosts": "*"
