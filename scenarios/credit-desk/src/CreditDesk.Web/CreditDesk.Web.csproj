<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>CreditDesk.Web</RootNamespace>
    <AssemblyName>CreditDesk.Web</AssemblyName>
    <Version>3.2.0</Version>
    <Company>Fabrikam Wholesale</Company>
    <Product>Credit Desk</Product>
    <!-- IIS loads assemblies from .\bin next to Web.config -->
    <OutputPath>bin\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <GenerateBindingRedirectsOutputType>false</GenerateBindingRedirectsOutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNet.Mvc" Version="5.2.9" />
    <PackageReference Include="Microsoft.AspNet.Razor" Version="3.2.9" />
    <PackageReference Include="Microsoft.AspNet.WebPages" Version="3.2.9" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.ComponentModel.DataAnnotations" />
    <Reference Include="System.Configuration" />
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="System.ServiceModel" />
    <Reference Include="System.Web" />
    <Reference Include="System.Web.Abstractions" />
    <Reference Include="System.Web.Routing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CreditDesk.Contracts\CreditDesk.Contracts.csproj" />
    <ProjectReference Include="..\CreditDesk.Core\CreditDesk.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Views\**\*.cshtml" />
    <Content Include="Views\Web.config" />
    <Content Include="Content\**\*" />
    <Content Include="Global.asax" />
    <None Remove="Web.config" />
    <Content Include="Web.config" CopyToOutputDirectory="Never" />
  </ItemGroup>

</Project>
