<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>

  <connectionStrings>
    <add name="CreditDesk"
         connectionString="Data Source=sql01.fabrikam.local;Initial Catalog=CreditDesk;Integrated Security=SSPI;Application Name=Credit Desk Letters;Encrypt=True;TrustServerCertificate=False"
         providerName="System.Data.SqlClient" />
  </connectionStrings>

  <appSettings>
    <add key="QueuePath" value=".\private$\creditdesk.letters" />
    <add key="FailedQueuePath" value=".\private$\creditdesk.letters.failed" />
    <add key="TemplatePath" value="\\fs01.fabrikam.local\templates$\CreditDesk\CreditLimitLetter.dotx" />
    <add key="OutputFolder" value="\\fs01.fabrikam.local\letters$\credit" />
    <add key="Printer" value="\\print01.fabrikam.local\FIN-LETTERHEAD-01" />
    <add key="PrintCopies" value="1" />
    <add key="MaxAttempts" value="3" />
    <add key="RecycleWordAfter" value="50" />
  </appSettings>
</configuration>
