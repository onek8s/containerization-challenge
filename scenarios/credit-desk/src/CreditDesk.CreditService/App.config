<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>

  <connectionStrings>
    <add name="CreditDesk"
         connectionString="Data Source=sql01.fabrikam.local;Initial Catalog=CreditDesk;Integrated Security=SSPI;Application Name=Credit Desk Service;Encrypt=True;TrustServerCertificate=False"
         providerName="System.Data.SqlClient" />
  </connectionStrings>

  <appSettings>
    <add key="LetterQueue" value="FormatName:DIRECT=OS:docs01.fabrikam.local\private$\creditdesk.letters" />
    <add key="Group.SalesRep" value="FABRIKAM\CreditDesk Sales" />
    <add key="Group.CreditController" value="FABRIKAM\CreditDesk Controllers" />
    <add key="Group.FinanceManager" value="FABRIKAM\CreditDesk Finance Managers" />
    <add key="Group.CreditCommittee" value="FABRIKAM\CreditDesk Committee" />
    <add key="Policy.AutomaticIncreaseLimit" value="2500" />
    <add key="Policy.ControllerLimit" value="50000" />
    <add key="Policy.FinanceManagerLimit" value="250000" />
    <add key="Policy.MaximumMultiplier" value="3" />
    <add key="Policy.MaxOverdueDays" value="60" />
    <add key="Policy.MinimumCustomerMonths" value="6" />
    <add key="Policy.ApprovalValidityDays" value="365" />
  </appSettings>

  <system.serviceModel>
    <bindings>
      <netTcpBinding>
        <binding name="WindowsTcp" transactionFlow="false" maxReceivedMessageSize="4194304"
                 portSharingEnabled="true" sendTimeout="00:01:00" receiveTimeout="00:10:00">
          <security mode="Transport">
            <transport clientCredentialType="Windows" protectionLevel="EncryptAndSign" />
          </security>
        </binding>
        <!-- mexTcpBinding cannot use port sharing, so metadata uses a shared net.tcp binding on the same port. -->
        <binding name="MexTcp" portSharingEnabled="true">
          <security mode="None" />
        </binding>
      </netTcpBinding>
    </bindings>

    <behaviors>
      <serviceBehaviors>
        <behavior name="CreditServiceBehavior">
          <serviceMetadata httpGetEnabled="false" />
          <serviceDebug includeExceptionDetailInFaults="false" />
          <serviceAuthorization principalPermissionMode="UseWindowsGroups" impersonateCallerForAllOperations="false" />
          <serviceCredentials>
            <windowsAuthentication allowAnonymousLogons="false" includeWindowsGroups="true" />
          </serviceCredentials>
          <serviceThrottling maxConcurrentCalls="64" maxConcurrentSessions="200" maxConcurrentInstances="264" />
          <serviceSecurityAudit auditLogLocation="Application" serviceAuthorizationAuditLevel="Failure"
                                messageAuthenticationAuditLevel="Failure" suppressAuditFailure="true" />
        </behavior>
      </serviceBehaviors>
    </behaviors>

    <services>
      <service name="CreditDesk.CreditService.CreditService" behaviorConfiguration="CreditServiceBehavior">
        <host>
          <baseAddresses>
            <add baseAddress="net.tcp://credit01.fabrikam.local:8524/CreditDesk/" />
          </baseAddresses>
        </host>
        <endpoint address="CreditService" binding="netTcpBinding" bindingConfiguration="WindowsTcp"
                  contract="CreditDesk.Contracts.ICreditService">
          <identity>
            <servicePrincipalName value="CreditDesk/credit01.fabrikam.local" />
          </identity>
        </endpoint>
        <endpoint address="mex" binding="netTcpBinding" bindingConfiguration="MexTcp" contract="IMetadataExchange" />
      </service>
    </services>
  </system.serviceModel>

  <system.diagnostics>
    <trace autoflush="true" />
  </system.diagnostics>
</configuration>
