{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "Database": {
    "Provider": "Sqlite"
  },
  "ConnectionStrings": {
    "FieldService": "Data Source=../../App_Data/fieldservice.db"
  },
  "Worker": {
    "InboxFolder": "../../App_Data/share/Inbox",
    "ArchiveFolder": "../../App_Data/share/Inbox/Processed",
    "ErrorFolder": "../../App_Data/share/Inbox/Failed",
    "OutboxFolder": "../../App_Data/share/Finance",
    "ReportFolder": "../../App_Data/share/Reports",
    "StateFolder": "../../App_Data/worker-state",
    "InboxPollSeconds": 10,
    "TimeZone": "Europe/Helsinki"
  }
}
