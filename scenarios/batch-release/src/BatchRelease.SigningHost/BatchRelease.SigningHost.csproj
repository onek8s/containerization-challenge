<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>BatchRelease.SigningHost</RootNamespace>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <UserSecretsId>batchrelease-signinghost</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="8.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BatchRelease.Core\BatchRelease.Core.csproj" />
    <ProjectReference Include="..\BatchRelease.Contracts\BatchRelease.Contracts.csproj" />
    <ProjectReference Include="..\BatchRelease.Data\BatchRelease.Data.csproj" />
    <ProjectReference Include="..\BatchRelease.Vault\BatchRelease.Vault.csproj" />
  </ItemGroup>

</Project>
