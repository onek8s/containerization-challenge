{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    },
    "EventLog": {
      "LogLevel": {
        "Default": "Warning",
        "BatchRelease": "Information"
      }
    }
  },
  "ConnectionStrings": {
    "BatchRelease": "Server=release-sql.corp.local;Database=BatchRelease;Integrated Security=true;Encrypt=true;TrustServerCertificate=false;Application Name=Batch Release Signing"
  },
  "SigningHost": {
    "Urls": "https://release-sign.corp.local:5443/"
  },
  "Signing": {
    "KeyStorageProvider": "Microsoft Platform Crypto Provider",
    "RequireHardwareKeys": true,
    "IssuerThumbprint": "",
    "CertificateValidityMonths": 36,
    "KeySize": 2048,
    "Manufacturer": "Proseware Pharmaceuticals Oy",
    "DefaultDomain": "CORP",
    "TrustedCallers": [
      "CORP\\svc-release-web",
      "CORP\\svc-release-api"
    ]
  },
  "Vault": {
    "Root": "D:\\ReleaseVault",
    "RequireEncryption": true,
    "AdditionalReaders": [],
    "ResourceManagerName": "Proseware Batch Release",
    "AuditSourceName": "Proseware Batch Release",
    "SecurityAuditing": true
  }
}
