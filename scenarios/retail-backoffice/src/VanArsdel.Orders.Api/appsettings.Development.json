{
  "ConnectionStrings": {
    "Orders": "Data Source=../../.devdata/orders.db"
  },
  "Database": {
    "Provider": "Sqlite",
    "AutoCreate": true
  },
  "Authentication": {
    "Audiences": [
      "api://vanarsdel-retail"
    ],
    "RequireHttpsMetadata": false,
    "Authorities": [
      {
        "Name": "Lab",
        "Authority": "http://localhost:5100",
        "Issuer": "http://localhost:5100",
        "RoleClaimType": "roles"
      }
    ]
  },
  "ServiceIdentity": {
    "TokenEndpoint": "http://localhost:5100/connect/token",
    "ClientId": "orders-api",
    "ClientSecret": "dev-secret"
  },
  "Messaging": {
    "Transport": "InMemory"
  },
  "Redis": {
    "Configuration": ""
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  },
  "WebShopBus": {
    "Transport": "InMemory"
  },
  "Psp": {
    "BaseUrl": "http://localhost:5100/psp",
    "MerchantId": "VANARSDEL-DEV",
    "MerchantKey": "dev",
    "WebhookSecret": "psp-dev-secret",
    "CertificateSource": "None"
  },
  "Carrier": {
    "BaseUrl": "http://localhost:5100/carrier",
    "ApiKey": "dev",
    "WebhookSecret": "carrier-dev-token",
    "Name": "NordPost"
  }
}
