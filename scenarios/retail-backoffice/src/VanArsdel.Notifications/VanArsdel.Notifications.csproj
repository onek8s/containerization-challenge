  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MailKit" Version="2.15.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VanArsdel.BuildingBlocks\VanArsdel.BuildingBlocks.csproj" />
    <ProjectReference Include="..\VanArsdel.Contracts\VanArsdel.Contracts.csproj" />
    <ProjectReference Include="..\VanArsdel.Integration\VanArsdel.Integration.csproj" />
  </ItemGroup>

</Project>
