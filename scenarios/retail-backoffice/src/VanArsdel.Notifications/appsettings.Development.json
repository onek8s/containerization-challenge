{
  "ConnectionStrings": {
    "Notifications": "Data Source=../../.devdata/notifications.db"
  },
  "Database": {
    "Provider": "Sqlite",
    "AutoCreate": true
  },
  "ServiceIdentity": {
    "TokenEndpoint": "http://localhost:5100/connect/token",
    "ClientId": "notifications",
    "ClientSecret": "dev-secret"
  },
  "Messaging": {
    "Transport": "InMemory"
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  },
  "Services": {
    "StoreOps": "http://localhost:5208"
  },
  "Notifications": {
    "EmailProvider": "Postiq",
    "WebShopUrl": "http://localhost:5000",
    "Postiq": {
      "BaseUrl": "http://localhost:5100/postiq",
      "ApiKey": "dev"
    },
    "Smtp": {
      "Host": "localhost",
      "Port": 2525,
      "StartTls": false
    }
  }
}
