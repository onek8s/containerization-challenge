  },
  "Database": {
    "Provider": "SqlServer",
    "AutoCreate": false
  },
  "Authentication": {
    "Audiences": [
      "api://vanarsdel-retail",
      "https://api.corp.local/retail"
    ],
    "RequireHttpsMetadata": true,
    "Authorities": [
      {
        "Name": "Entra",
        "Authority": "https://login.microsoftonline.com/7c1b2f0e-5d3a-4c55-9e1f-2a8b6d0c4e91/v2.0",
        "Issuer": "https://login.microsoftonline.com/7c1b2f0e-5d3a-4c55-9e1f-2a8b6d0c4e91/v2.0",
        "RoleClaimType": "roles"
      },
      {
        "Name": "Adfs",
        "Authority": "https://adfs.corp.local/adfs",
        "Issuer": "http://adfs.corp.local/adfs/services/trust",
        "RoleClaimType": "role"
      }
    ]
  },
  "ServiceIdentity": {
    "TokenEndpoint": "https://login.microsoftonline.com/7c1b2f0e-5d3a-4c55-9e1f-2a8b6d0c4e91/oauth2/v2.0/token",
    "ClientId": "",
    "ClientSecret": "",
    "Scope": "api://vanarsdel-retail/.default"
  },
  "Messaging": {
    "Transport": "RabbitMq",
    "Host": "mq01.corp.local",
    "Port": 5671,
    "VirtualHost": "retail",
    "Username": "retail-reporting",
    "Password": "",
    "UseSsl": true
  },
  "Redis": {
    "Configuration": "redis01.corp.local:6380,ssl=True,password=,abortConnect=False"
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.File",
      "Serilog.Sinks.Seq"
    ],
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "D:\\Logs\\VanArsdel\\reporting-api-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "shared": true
        }
      },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://logs.corp.local:5341",
          "apiKey": ""
        }
      }
    ]
  },
  "Reports": {
