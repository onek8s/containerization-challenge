{
  "ConnectionStrings": {
    "Reporting": "Data Source=../../.devdata/reporting.db"
  },
  "Database": {
    "Provider": "Sqlite",
    "AutoCreate": true
  },
  "Authentication": {
    "Audiences": [
      "api://vanarsdel-retail"
    ],
    "RequireHttpsMetadata": false,
    "Authorities": [
      {
        "Name": "Lab",
        "Authority": "http://localhost:5100",
        "Issuer": "http://localhost:5100",
        "RoleClaimType": "roles"
      }
    ]
  },
  "ServiceIdentity": {
    "TokenEndpoint": "http://localhost:5100/connect/token",
    "ClientId": "reporting-api",
    "ClientSecret": "dev-secret"
  },
  "Messaging": {
    "Transport": "InMemory"
  },
  "Redis": {
    "Configuration": ""
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  },
  "Reports": {
    "OutputFolder": "../../.devdata/reports",
    "PublicBaseUrl": "http://localhost:5000",
    "Recipients": {
      "daily-sales-flash": [
        "flash@localhost"
      ]
    }
  }
}
