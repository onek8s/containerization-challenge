{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning",
        "MassTransit": "Warning"
      }
    }
  },
  "Scheduler": {
    "TimeZone": "Europe/Helsinki",
    "Jobs": [
      {
        "Name": "publish-price-lists",
        "Service": "Pricing",
        "Path": "api/pricelists/publish-due",
        "Cron": "0 0 2 * * ?",
        "Description": "Price lists that start today"
      },
      {
        "Name": "loyalty-tiers",
        "Service": "Customers",
        "Path": "api/loyalty/recalculate-tiers",
        "Cron": "0 0 3 * * ?",
        "Description": "Club levels on rolling 12 month spend"
      },
      {
        "Name": "replenishment",
        "Service": "Inventory",
        "Path": "api/replenishment/run",
        "Cron": "0 30 4 * * ?",
        "Description": "Store replenishment proposals from DC01"
      },
      {
        "Name": "report-daily-sales-flash",
        "Service": "Reporting",
        "Path": "api/reports/daily-sales-flash/run",
        "Cron": "0 30 5 * * ?",
        "Description": "Morning flash"
      },
      {
        "Name": "report-web-orders",
        "Service": "Reporting",
        "Path": "api/reports/web-orders/run",
        "Cron": "0 40 5 * * ?",
        "Description": "Web order intake"
      },
      {
        "Name": "report-top-styles",
        "Service": "Reporting",
        "Path": "api/reports/top-styles/run",
        "Cron": "0 0 6 ? * MON",
        "Description": "Monday trading meeting"
      },
      {
        "Name": "report-returns",
        "Service": "Reporting",
        "Path": "api/reports/returns/run",
        "Cron": "0 15 6 ? * MON",
        "Description": "Weekly returns by category"
      },
      {
        "Name": "expire-unpaid-orders",
        "Service": "Orders",
        "Path": "api/orders/expire-unpaid",
        "Cron": "0 0/15 * * * ?",
        "Description": "Cancel orders without payment after 2 hours"
      },
      {
        "Name": "expire-collections",
        "Service": "StoreOps",
        "Path": "api/collections/expire",
        "Cron": "0 5 * * * ?",
        "Description": "Uncollected click and collect parcels"
      },
      {
        "Name": "search-reindex",
        "Service": "Catalog",
        "Path": "api/search/reindex",
        "Cron": "0 0 1 ? * SUN",
        "Description": "Full product search rebuild"
      }
    ]
  }
}
