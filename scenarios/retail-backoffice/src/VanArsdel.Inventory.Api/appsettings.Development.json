{
  "ConnectionStrings": {
    "Inventory": "Data Source=../../.devdata/inventory.db"
  },
  "Database": {
    "Provider": "Sqlite",
    "AutoCreate": true
  },
  "Authentication": {
    "Audiences": [
      "api://vanarsdel-retail"
    ],
    "RequireHttpsMetadata": false,
    "Authorities": [
      {
        "Name": "Lab",
        "Authority": "http://localhost:5100",
        "Issuer": "http://localhost:5100",
        "RoleClaimType": "roles"
      }
    ]
  },
  "ServiceIdentity": {
    "TokenEndpoint": "http://localhost:5100/connect/token",
    "ClientId": "inventory-api",
    "ClientSecret": "dev-secret"
  },
  "Messaging": {
    "Transport": "InMemory"
  },
  "Redis": {
    "Configuration": ""
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://localhost:5203",
        "Protocols": "Http1"
      },
      "Grpc": {
        "Url": "http://localhost:5213",
        "Protocols": "Http2"
      }
    }
  },
  "Grpc": {
    "DetailedErrors": true
  }
}
