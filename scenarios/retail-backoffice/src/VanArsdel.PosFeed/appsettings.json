{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning",
        "MassTransit": "Warning"
      }
    }
  },
  "PosFeed": {
    "PollSeconds": 30,
    "FilePattern": "POS_*.txt",
    "MinFileAgeSeconds": 10
  }
}
