{
  "Messaging": {
    "Transport": "InMemory"
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  },
  "PosFeed": {
    "Source": "Folder",
    "PollSeconds": 5,
    "MinFileAgeSeconds": 1,
    "Folder": {
      "Inbox": "../../.devdata/pos/inbox",
      "Archive": "../../.devdata/pos/archive",
      "Error": "../../.devdata/pos/error"
    }
  }
}
