{
  "ConnectionStrings": {
    "Catalog": "Data Source=../../.devdata/catalog.db"
  },
  "Database": {
    "Provider": "Sqlite",
    "AutoCreate": true
  },
  "Authentication": {
    "Audiences": [
      "api://vanarsdel-retail"
    ],
    "RequireHttpsMetadata": false,
    "Authorities": [
      {
        "Name": "Lab",
        "Authority": "http://localhost:5100",
        "Issuer": "http://localhost:5100",
        "RoleClaimType": "roles"
      }
    ]
  },
  "ServiceIdentity": {
    "TokenEndpoint": "http://localhost:5100/connect/token",
    "ClientId": "catalog-api",
    "ClientSecret": "dev-secret"
  },
  "Messaging": {
    "Transport": "InMemory"
  },
  "Redis": {
    "Configuration": ""
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  },
  "Search": {
    "Provider": "InMemory"
  }
}
