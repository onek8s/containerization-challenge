{
  "Gateway": {
    "BaseUrl": "http://localhost:5000"
  },
  "Oidc": {
    "RequireHttpsMetadata": false,
    "Providers": [
      {
        "Name": "Entra",
        "DisplayName": "Lab sign-in",
        "Authority": "http://localhost:5100",
        "ClientId": "backoffice",
        "ClientSecret": "dev-secret",
        "Scopes": "openid profile retail.api",
        "RoleClaimType": "roles"
      }
    ]
  },
  "DataProtection": {
    "KeysFolder": "../../.devdata/keys/backoffice"
  },
  "HealthChecksUI": {
    "HealthChecks": [
      {
        "Name": "Gateway",
        "Uri": "http://localhost:5000/health"
      },
      {
        "Name": "Catalog",
        "Uri": "http://localhost:5201/health"
      },
      {
        "Name": "Pricing",
        "Uri": "http://localhost:5202/health"
      },
      {
        "Name": "Inventory",
        "Uri": "http://localhost:5203/health"
      },
      {
        "Name": "Allocation",
        "Uri": "http://localhost:5204/health"
      },
      {
        "Name": "Orders",
        "Uri": "http://localhost:5205/health"
      },
      {
        "Name": "Customers",
        "Uri": "http://localhost:5206/health"
      },
      {
        "Name": "Returns",
        "Uri": "http://localhost:5207/health"
      },
      {
        "Name": "Store operations",
        "Uri": "http://localhost:5208/health"
      },
      {
        "Name": "Reporting",
        "Uri": "http://localhost:5209/health"
      }
    ]
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  }
}
