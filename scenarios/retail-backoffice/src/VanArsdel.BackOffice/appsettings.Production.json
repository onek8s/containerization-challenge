{
  "Gateway": {
    "BaseUrl": "https://api.corp.local"
  },
  "Oidc": {
    "RequireHttpsMetadata": true,
    "Providers": [
      {
        "Name": "Entra",
        "DisplayName": "VanArsdel account",
        "Authority": "https://login.microsoftonline.com/7c1b2f0e-5d3a-4c55-9e1f-2a8b6d0c4e91/v2.0",
        "ClientId": "",
        "ClientSecret": "",
        "Scopes": "openid profile offline_access api://vanarsdel-retail/user_impersonation",
        "RoleClaimType": "roles"
      },
      {
        "Name": "Adfs",
        "DisplayName": "Store domain (ADFS)",
        "Authority": "https://adfs.corp.local/adfs",
        "ClientId": "",
        "ClientSecret": "",
        "Scopes": "openid profile allatclaims https://api.corp.local/retail/user_impersonation",
        "RoleClaimType": "role"
      }
    ]
  },
  "DataProtection": {
    "KeysFolder": "D:\\VanArsdel\\Keys\\BackOffice"
  },
  "HealthChecksUI": {
    "HealthChecks": [
      {
        "Name": "Gateway",
        "Uri": "https://api.corp.local/health"
      },
      {
        "Name": "Catalog",
        "Uri": "https://catalog.corp.local/health"
      },
      {
        "Name": "Pricing",
        "Uri": "https://pricing.corp.local/health"
      },
      {
        "Name": "Inventory",
        "Uri": "https://inventory.corp.local:5001/health"
      },
      {
        "Name": "Allocation",
        "Uri": "https://allocation.corp.local/health"
      },
      {
        "Name": "Orders",
        "Uri": "https://orders.corp.local/health"
      },
      {
        "Name": "Customers",
        "Uri": "https://customers.corp.local/health"
      },
      {
        "Name": "Returns",
        "Uri": "https://returns.corp.local/health"
      },
      {
        "Name": "Store operations",
        "Uri": "https://storeops.corp.local/health"
      },
      {
        "Name": "Reporting",
        "Uri": "https://reporting.corp.local/health"
      }
    ]
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.File",
      "Serilog.Sinks.Seq"
    ],
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "D:\\Logs\\VanArsdel\\backoffice-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "shared": true
        }
      },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://logs.corp.local:5341",
          "apiKey": ""
        }
      }
    ]
  }
}
