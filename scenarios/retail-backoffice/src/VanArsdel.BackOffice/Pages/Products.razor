@page "/products"
@inject RetailApi Api

<h1>Products</h1>
<ErrorBanner Message="@error" />

<div class="filters">
    <input placeholder="Style, name or EAN" @bind="search" @bind:event="oninput" @onkeyup="@(e => e.Key == "Enter" ? Load(1) : Task.CompletedTask)" />
    <select @bind="status">
        <option value="">All</option>
        <option>Draft</option>
        <option>Published</option>
        <option>Discontinued</option>
    </select>
    <button @onclick="() => Load(1)">Search</button>
</div>

@if (result != null)
{
    <p>@result.Total products</p>
    <table>
        <thead><tr><th>Style</th><th>Name</th><th>Brand</th><th>Category</th><th>Season</th><th>Status</th><th class="num">RRP €</th><th class="num">SKUs</th><th></th></tr></thead>
        <tbody>
            @foreach (var p in result.Items)
            {
                <tr>
                    <td>@p.StyleCode</td><td>@p.Name</td><td>@p.Brand</td><td>@p.Category</td><td>@p.Season</td><td>@p.Status</td>
                    <td class="num">@p.RecommendedPriceEur.ToString("N2")</td><td class="num">@p.SkuCount</td>
                    <td>
                        @if (p.Status == "Draft")
                        {
                            <button @onclick="() => Publish(p)">Publish</button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <div class="pager">
        <button disabled="@(pageNo <= 1)" @onclick="() => Load(pageNo - 1)">Previous</button>
        <span>Page @pageNo</span>
        <button disabled="@(pageNo * 50 >= result.Total)" @onclick="() => Load(pageNo + 1)">Next</button>
    </div>
}

@code {
    private Paged<ProductRow> result;
    private string search;
    private string status = "";
    private int pageNo = 1;
    private string error;

    protected override Task OnInitializedAsync() => Load(1);

    private async Task Load(int p)
    {
        error = null;
        pageNo = p;
        try
        {
            result = await Api.ProductsAsync(search, status, pageNo);
        }
        catch (ApiException ex)
        {
            error = ex.Message;
        }
    }

    private async Task Publish(ProductRow product)
    {
        try
        {
            await Api.PublishProductAsync(product.StyleCode);
            await Load(pageNo);
        }
        catch (ApiException ex)
        {
            error = ex.Message;
        }
    }
}
