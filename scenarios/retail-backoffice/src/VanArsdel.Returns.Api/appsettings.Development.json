{
  "ConnectionStrings": {
    "Returns": "Data Source=../../.devdata/returns.db"
  },
  "Database": {
    "Provider": "Sqlite",
    "AutoCreate": true
  },
  "Authentication": {
    "Audiences": [
      "api://vanarsdel-retail"
    ],
    "RequireHttpsMetadata": false,
    "Authorities": [
      {
        "Name": "Lab",
        "Authority": "http://localhost:5100",
        "Issuer": "http://localhost:5100",
        "RoleClaimType": "roles"
      }
    ]
  },
  "ServiceIdentity": {
    "TokenEndpoint": "http://localhost:5100/connect/token",
    "ClientId": "returns-api",
    "ClientSecret": "dev-secret"
  },
  "Messaging": {
    "Transport": "InMemory"
  },
  "Redis": {
    "Configuration": ""
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  },
  "Services": {
    "Orders": "http://localhost:5205"
  },
  "Carrier": {
    "BaseUrl": "http://localhost:5100/carrier"
  },
  "Psp": {
    "BaseUrl": "http://localhost:5100/psp",
    "MerchantId": "VANARSDEL-DEV",
    "MerchantKey": "dev",
    "CertificatePath": ""
  },
  "Returns": {
    "CarrierApiKey": "dev",
    "CarrierWebhookSecret": "carrier-dev-token"
  }
}
