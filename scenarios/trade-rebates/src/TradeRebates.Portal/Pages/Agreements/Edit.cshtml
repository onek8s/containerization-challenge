@page "{id:int?}"
@model ContosoFoods.TradeRebates.Portal.Pages.Agreements.EditModel
@{
    ViewData["Title"] = Model.Input.AgreementId is null ? "New agreement" : "Edit agreement";
}
<h1>@ViewData["Title"]</h1>
<form method="post">
    <div asp-validation-summary="All"></div>
    <input type="hidden" asp-for="Input.AgreementId" />
    <input type="hidden" asp-for="RowVer" />
    <fieldset>
        <p><label asp-for="Input.AgreementNo">Agreement number</label><input type="text" asp-for="Input.AgreementNo" /></p>
        <p><label asp-for="Input.DistributorId">Distributor</label><select asp-for="Input.DistributorId" asp-items="Model.DistributorItems"></select></p>
        <p><label asp-for="Input.Description">Description</label><input type="text" asp-for="Input.Description" /></p>
        <p><label asp-for="Input.Basis">Basis</label>
            <select asp-for="Input.Basis"><option value="Q">Quantity</option><option value="V">Net value</option></select></p>
        <p><label asp-for="Input.Category">Category</label><input type="text" asp-for="Input.Category" placeholder="empty = all categories" /></p>
        <p><label asp-for="Input.Tiers">Tiers</label><input type="text" asp-for="Input.Tiers" style="min-width:360px" />
            <br /><span class="muted">R or S (retroactive or stepped), then threshold:rate% pairs starting at 0, e.g. <code>R;0:0;10000:1.5;25000:2.25</code></span></p>
        <p><label asp-for="Input.ValidFrom">Valid from</label><input type="date" asp-for="Input.ValidFrom" /></p>
        <p><label asp-for="Input.ValidTo">Valid to</label><input type="date" asp-for="Input.ValidTo" /></p>
        <p><label asp-for="Input.CapAmount">Cap</label><input type="number" step="0.01" asp-for="Input.CapAmount" /></p>
    </fieldset>
    <button type="submit">Save draft</button>
</form>
