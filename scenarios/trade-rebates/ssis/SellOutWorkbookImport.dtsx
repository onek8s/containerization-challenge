          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{2A4D6C8E-1B3F-4A5C-9E7D-0F1E2D3C4B5A}"
              SQLTask:TimeOut="600"
              SQLTask:SqlStatementSource="EXEC rebate.ImportSellOutWorkbook @Path = ?, @SubmittedBy = N'SSIS SellOutWorkbookImport';" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
              <SQLTask:ParameterBinding
                SQLTask:ParameterName="0"
                SQLTask:DtsVariableName="User::CurrentFile"
                SQLTask:ParameterDirection="Input"
                SQLTask:DataType="130"
                SQLTask:ParameterSize="400" />
            </SQLTask:SqlTaskData>
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
