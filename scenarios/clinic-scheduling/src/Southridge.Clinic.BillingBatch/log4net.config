<?xml version="1.0" encoding="utf-8"?>
<!-- Billing run log: one file per run day, kept 90 days (the billing office asks for these when a payer disputes a file). -->
<log4net>
  <appender name="File" type="log4net.Appender.RollingFileAppender">
    <file value="..\logs\billing-batch.log" />
    <appendToFile value="true" />
    <rollingStyle value="Date" />
    <datePattern value="'.'yyyyMMdd" />
    <maxSizeRollBackups value="90" />
    <layout type="log4net.Layout.PatternLayout">
      <conversionPattern value="%date %-5level %logger{1} - %message%newline%exception" />
    </layout>
  </appender>
  <appender name="Console" type="log4net.Appender.ConsoleAppender">
    <layout type="log4net.Layout.PatternLayout">
      <conversionPattern value="%date{HH:mm:ss} %-5level %message%newline" />
    </layout>
  </appender>
  <root>
    <level value="INFO" />
    <appender-ref ref="File" />
    <appender-ref ref="Console" />
  </root>
</log4net>
