<?xml version="1.0" encoding="utf-8"?>
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <connectionStrings>
    <add name="Clinic" connectionString="Data Source=clinic-sql.corp.local;Initial Catalog=SouthridgeClinic;User ID=clinic_services;Password=Lab-Services-1;Application Name=Clinic Services"
         xdt:Transform="SetAttributes" xdt:Locator="Match(name)" />
    <add name="Workflow" connectionString="Data Source=clinic-sql.corp.local;Initial Catalog=SouthridgeWorkflow;User ID=clinic_services;Password=Lab-Services-1;Application Name=Clinic Workflow"
         xdt:Transform="SetAttributes" xdt:Locator="Match(name)" />
  </connectionStrings>
  <appSettings>
    <add key="Clinic:Environment" value="Lab" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
    <add key="Clinic:ServiceCertificatePassword" value="Lab-Cert-1" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
    <add key="Clinic:InternalServiceKey" value="lab-internal-key" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
  </appSettings>
  <system.web>
    <compilation xdt:Transform="RemoveAttributes(debug)" />
  </system.web>
  <system.net>
    <mailSettings>
      <smtp deliveryMethod="Network" xdt:Transform="SetAttributes(deliveryMethod)">
        <specifiedPickupDirectory xdt:Transform="Remove" />
        <network host="smtp.corp.local" port="25" xdt:Transform="Insert" />
      </smtp>
    </mailSettings>
  </system.net>
</configuration>
