<?xml version="1.0" encoding="utf-8"?>
<!-- Interface engine logging. traffic.log keeps every HL7 message in and out (14 days); engine.log is the service log. -->
<log4net>
  <appender name="Engine" type="log4net.Appender.RollingFileAppender">
    <file value="..\logs\interface-engine.log" />
    <appendToFile value="true" />
    <rollingStyle value="Date" />
    <datePattern value="'.'yyyyMMdd" />
    <maxSizeRollBackups value="30" />
    <lockingModel type="log4net.Appender.FileAppender+MinimalLock" />
    <layout type="log4net.Layout.PatternLayout">
      <conversionPattern value="%date [%thread] %-5level %logger{1} - %message%newline%exception" />
    </layout>
  </appender>
  <appender name="Traffic" type="log4net.Appender.RollingFileAppender">
    <file value="..\logs\interface-traffic.log" />
    <appendToFile value="true" />
    <rollingStyle value="Date" />
    <datePattern value="'.'yyyyMMdd" />
    <maxSizeRollBackups value="14" />
    <layout type="log4net.Layout.PatternLayout">
      <conversionPattern value="%date %message%newline" />
    </layout>
  </appender>
  <appender name="Console" type="log4net.Appender.ColoredConsoleAppender">
    <mapping>
      <level value="ERROR" />
      <foreColor value="Red, HighIntensity" />
    </mapping>
    <mapping>
      <level value="WARN" />
      <foreColor value="Yellow" />
    </mapping>
    <layout type="log4net.Layout.PatternLayout">
      <conversionPattern value="%date{HH:mm:ss} %-5level %logger{1} - %message%newline" />
    </layout>
  </appender>

  <logger name="Traffic" additivity="false">
    <level value="INFO" />
    <appender-ref ref="Traffic" />
  </logger>
  <root>
    <level value="INFO" />
    <appender-ref ref="Engine" />
    <appender-ref ref="Console" />
  </root>
</log4net>
