<?xml version="1.0" encoding="utf-8"?>
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <connectionStrings>
    <add name="Clinic" connectionString="Data Source=clinic-sql.corp.local;Initial Catalog=SouthridgeClinic;User ID=clinic_web;Password=__WEB_DB_PASSWORD__;Application Name=Clinic Staff Site"
         xdt:Transform="SetAttributes" xdt:Locator="Match(name)" />
  </connectionStrings>
  <appSettings>
    <add key="Clinic:Environment" value="Production" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
    <add key="Clinic:ReportServerUrl" value="http://reports.corp.local/ReportServer" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
    <add key="Clinic:ServicesUrl" value="http://clinic-svc.corp.local/" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
    <add key="Clinic:InternalServiceKey" value="__INTERNAL_SERVICE_KEY__" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
  </appSettings>
  <system.web>
    <compilation xdt:Transform="RemoveAttributes(debug)" />
    <customErrors mode="On" xdt:Transform="SetAttributes(mode)" />
    <authentication>
      <forms requireSSL="true" xdt:Transform="SetAttributes(requireSSL)" />
    </authentication>
    <machineKey validationKey="__MACHINE_VALIDATION_KEY__" decryptionKey="__MACHINE_DECRYPTION_KEY__" validation="HMACSHA256" decryption="AES" xdt:Transform="Replace" />
  </system.web>
  <system.serviceModel>
    <client>
      <endpoint name="ReferralWorkflow" address="http://clinic-svc.corp.local/ReferralWorkflowService.svc" xdt:Transform="SetAttributes(address)" xdt:Locator="Match(name)" />
    </client>
  </system.serviceModel>
  <system.net>
    <mailSettings>
      <smtp deliveryMethod="Network" xdt:Transform="SetAttributes(deliveryMethod)">
        <specifiedPickupDirectory xdt:Transform="Remove" />
        <network host="smtp.corp.local" port="25" xdt:Transform="Insert" />
      </smtp>
    </mailSettings>
  </system.net>
</configuration>
