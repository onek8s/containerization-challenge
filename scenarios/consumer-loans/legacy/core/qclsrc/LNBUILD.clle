/* LNBUILD - compile the lending programs into LNLIB */
PGM
  DCL VAR(&LIB) TYPE(*CHAR) LEN(10) VALUE('LNLIB')
  ADDLIBLE LIB(CIFLIB) POSITION(*LAST)
  MONMSG MSGID(CPF2103)
  ADDLIBLE LIB(&LIB) POSITION(*FIRST)
  MONMSG MSGID(CPF2103)

  CRTBNDRPG PGM(&LIB/CUSTINQ) SRCFILE(&LIB/QRPGLESRC) DBGVIEW(*SOURCE)
  CRTBNDRPG PGM(&LIB/CUSCRT)  SRCFILE(&LIB/QRPGLESRC) DBGVIEW(*SOURCE)
  CRTBNDRPG PGM(&LIB/LNBOOK)  SRCFILE(&LIB/QRPGLESRC) DBGVIEW(*SOURCE)
  CRTBNDRPG PGM(&LIB/LNDISB)  SRCFILE(&LIB/QRPGLESRC) DBGVIEW(*SOURCE)
  CRTBNDRPG PGM(&LIB/LNFEE)   SRCFILE(&LIB/QRPGLESRC) DBGVIEW(*SOURCE)
  CRTBNDRPG PGM(&LIB/LNPPLN)  SRCFILE(&LIB/QRPGLESRC) DBGVIEW(*SOURCE)
  CRTBNDRPG PGM(&LIB/LNTERM)  SRCFILE(&LIB/QRPGLESRC) DBGVIEW(*SOURCE)
  CRTBNDRPG PGM(&LIB/LNEOD)   SRCFILE(&LIB/QRPGLESRC) DBGVIEW(*SOURCE)
ENDPGM
