/* LNSETUP - create the lending objects in LNLIB (run once per partition) */
PGM
  DCL VAR(&LIB) TYPE(*CHAR) LEN(10) VALUE('LNLIB')

  CHKOBJ OBJ(&LIB) OBJTYPE(*LIB)
  MONMSG MSGID(CPF9801) EXEC(CRTLIB LIB(&LIB) TEXT('Consumer lending'))

  CRTPF FILE(&LIB/LNMSTP)  SRCFILE(&LIB/QDDSSRC) SRCMBR(LNMSTP)
  MONMSG MSGID(CPF7302)
  CRTLF FILE(&LIB/LNMSTL2) SRCFILE(&LIB/QDDSSRC) SRCMBR(LNMSTL2)
  MONMSG MSGID(CPF7302)
  CRTPF FILE(&LIB/LNTRNP)  SRCFILE(&LIB/QDDSSRC) SRCMBR(LNTRNP)
  MONMSG MSGID(CPF7302)
  CRTPF FILE(&LIB/LNPPLP)  SRCFILE(&LIB/QDDSSRC) SRCMBR(LNPPLP)
  MONMSG MSGID(CPF7302)
  CRTPF FILE(&LIB/BUSDATE) SRCFILE(&LIB/QDDSSRC) SRCMBR(BUSDATE)
  MONMSG MSGID(CPF7302)

  /* journaling is required for commitment control in the programs */
  STRJRNPF FILE(&LIB/LNMSTP &LIB/LNTRNP &LIB/LNPPLP &LIB/BUSDATE) JRN(&LIB/LNJRN) IMAGES(*BOTH)
  MONMSG MSGID(CPF7030)

  /* event queue read by the lending collections service (64 byte FIFO) */
  CRTDTAQ DTAQ(&LIB/LNEVTQ) MAXLEN(64) SEQ(*FIFO) SIZE(*MAX2GB) AUTORCL(*YES) +
          TEXT('Loan events for consumer lending')
  MONMSG MSGID(CPF9870)

  RUNSQLSTM SRCFILE(&LIB/QSQLSRC) SRCMBR(LNPROCS) COMMIT(*NONE) NAMING(*SYS) DFTRDBCOL(&LIB)

  /* service profile used by the lending applications (Kerberos mapped via EIM) */
  GRTOBJAUT OBJ(&LIB/*ALL) OBJTYPE(*ALL) USER(LNWEB) AUT(*CHANGE)
  GRTOBJAUT OBJ(&LIB/LNEVTQ) OBJTYPE(*DTAQ) USER(LNCOLL) AUT(*CHANGE)
ENDPGM
