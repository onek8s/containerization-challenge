{
  "ConnectionStrings": {
    "PortalIdentity": "Server=sql01.corp.local;Database=ConsumerLendingPortal;User Id=lending_portal;Password=;Encrypt=True;Application Name=Lending Customer Portal"
  },
  "Database": { "Provider": "SqlServer", "Upgrade": false },
  "LendingApi": {
    "BaseUrl": "https://lending-api.corp.local/",
    "ApiKey": "",
    "TimeoutSeconds": 30
  },
  "Portal": {
    "BankName": "Lucerne Savings Bank",
    "SupportPhone": "+358 20 790 1100",
    "RequireTwoFactor": true
  },
  "DataProtection": { "KeysFolder": "D:\\ConsumerLoans\\Portal\\Keys" },
  "NLog": {
    "throwConfigExceptions": true,
    "variables": { "logDir": "D:\\Logs\\ConsumerLoans\\Portal" },
    "targets": {
      "file": {
        "type": "File",
        "fileName": "${var:logDir}/portal-${shortdate}.log",
        "layout": "${longdate}|${level:uppercase=true}|${logger}|${aspnet-request-ip}|${message} ${exception:format=tostring}"
      },
      "console": { "type": "Console" }
    },
    "rules": [
      { "logger": "Microsoft.*", "maxLevel": "Info", "final": true },
      { "logger": "System.Net.Http.*", "maxLevel": "Info", "final": true },
      { "logger": "*", "minLevel": "Info", "writeTo": "file" }
    ]
  },
  "AllowedHosts": "*"
}
