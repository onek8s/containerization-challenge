@page
@model Lucerne.Lending.CustomerPortal.Pages.Account.LoginWith2faModel
@{ ViewData["Title"] = "Confirm sign in"; }
<p>Enter the six digit code from your authenticator app.</p>
<form method="post">
    <div asp-validation-summary="All" class="validation"></div>
    <input type="hidden" asp-for="ReturnUrl" />
    <label asp-for="Code">Code</label>
    <input asp-for="Code" type="text" inputmode="numeric" autocomplete="one-time-code" maxlength="7" />
    <button type="submit">Confirm</button>
</form>
