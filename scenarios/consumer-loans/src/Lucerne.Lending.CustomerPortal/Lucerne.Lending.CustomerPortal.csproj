<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <RootNamespace>Lucerne.Lending.CustomerPortal</RootNamespace>
    <ClientAppDir>ClientApp\</ClientAppDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="6.0.36" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="6.0.36" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="6.0.36" />
    <PackageReference Include="NLog.Web.AspNetCore" Version="5.3.8" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Lucerne.Lending.Contracts\Lucerne.Lending.Contracts.csproj" />
    <ProjectReference Include="..\Lucerne.Lending.Domain\Lucerne.Lending.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="$(ClientAppDir)**" />
    <None Remove="$(ClientAppDir)**" />
    <None Include="$(ClientAppDir)**" Exclude="$(ClientAppDir)node_modules\**" />
  </ItemGroup>

  <!-- the customer client (Vue) is built into wwwroot/app on publish -->
  <Target Name="BuildClientApp" BeforeTargets="ComputeFilesToPublish" Condition="'$(SkipClientApp)' != 'true'">
    <Exec WorkingDirectory="$(ClientAppDir)" Command="npm ci" />
    <Exec WorkingDirectory="$(ClientAppDir)" Command="npm run build" />
    <ItemGroup>
      <ClientDist Include="wwwroot\app\**" />
      <ResolvedFileToPublish Include="@(ClientDist->'%(FullPath)')" Exclude="@(ResolvedFileToPublish)">
        <RelativePath>%(ClientDist.Identity)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>
