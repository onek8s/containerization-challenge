{
  "ConnectionStrings": {
    "Lending": "Server=sql01.corp.local;Database=ConsumerLending;User Id=lending_docs;Password=;Encrypt=True;Application Name=Lending Documents"
  },
  "Database": { "Provider": "SqlServer" },
  "ESign": {
    "BaseUrl": "https://api.signhub.example",
    "ApiKey": "",
    "CallbackUrl": "https://lending-api.corp.local/api/esign/callback",
    "ReturnUrl": "https://apply.corp.local/applications",
    "ValidDays": 14
  },
  "Mail": {
    "Host": "smtp.corp.local",
    "Port": 25,
    "From": "Lucerne Savings Bank <noreply@lucernebank.example>"
  },
  "Portal": { "BaseUrl": "https://apply.corp.local" },
  "NLog": {
    "throwConfigExceptions": true,
    "variables": { "logDir": "D:\\Logs\\ConsumerLoans\\Documents" },
    "targets": {
      "file": {
        "type": "File",
        "fileName": "${var:logDir}/documents-${shortdate}.log",
        "layout": "${longdate}|${level:uppercase=true}|${logger}|${message} ${exception:format=tostring}",
        "maxArchiveFiles": 60
      },
      "console": { "type": "Console" }
    },
    "rules": [
      { "logger": "Microsoft.*", "maxLevel": "Info", "final": true },
      { "logger": "*", "minLevel": "Info", "writeTo": "file" }
    ]
  }
}
