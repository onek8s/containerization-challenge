<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" throwConfigExceptions="true">
  <variable name="logDir" value="D:\Logs\ConsumerLoans\LoanTape" />
  <targets>
    <target xsi:type="File" name="file" fileName="${logDir}/loantape-${shortdate}.log" layout="${longdate}|${level:uppercase=true}|${message} ${exception:format=tostring}" />
    <target xsi:type="Console" name="console" />
  </targets>
  <rules>
    <logger name="*" minlevel="Info" writeTo="file,console" />
  </rules>
</nlog>
