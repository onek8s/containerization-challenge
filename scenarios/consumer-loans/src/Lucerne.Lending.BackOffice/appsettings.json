{
  "ConnectionStrings": {
    "Lending": "Server=sql01.corp.local;Database=ConsumerLending;User Id=lending_office;Password=;Encrypt=True;Application Name=Lending Back Office"
  },
  "Database": { "Provider": "SqlServer", "Upgrade": false },
  "Auth": {
    "Mode": "WsFederation",
    "MetadataAddress": "https://adfs.corp.local/FederationMetadata/2007-06/FederationMetadata.xml",
    "Realm": "https://lending-office.corp.local/"
  },
  "Core": {
    "Provider": "IbmI",
    "SystemName": "core.corp.local",
    "UseKerberos": true,
    "MaxConnections": 4,
    "OdbcConnectionString": "Driver={IBM i Access ODBC Driver};System=core.corp.local;Signon=4;Naming=1;DefaultLibraries=LNLIB,CIFLIB,RATLIB,DPLIB;CCSID=1208;TranslateBinary=1;CommitMode=0;",
    "OleDbConnectionString": "Provider=IBMDA400;Data Source=core.corp.local;Default Collection=LNLIB;Convert Date Time To Char=FALSE;Catalog Library List=LNLIB,CIFLIB;"
  },
  "PaymentsHub": { "BaseUrl": "https://payhub.corp.local/", "ClientId": "consumer-lending", "ClientSecret": "" },
  "Lending": { "SeniorApprovalLimit": 30000, "BranchCode": "0901" },
  "NLog": {
    "throwConfigExceptions": true,
    "variables": { "logDir": "D:\\Logs\\ConsumerLoans\\BackOffice" },
    "targets": {
      "file": {
        "type": "File",
        "fileName": "${var:logDir}/backoffice-${shortdate}.log",
        "layout": "${longdate}|${level:uppercase=true}|${logger}|${aspnet-user-identity}|${message} ${exception:format=tostring}"
      }
    },
    "rules": [
      { "logger": "Microsoft.*", "maxLevel": "Info", "final": true },
      { "logger": "*", "minLevel": "Info", "writeTo": "file" }
    ]
  },
  "AllowedHosts": "*"
}
