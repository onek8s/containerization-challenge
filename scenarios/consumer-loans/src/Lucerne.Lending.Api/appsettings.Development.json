{
  "ConnectionStrings": {
    "Lending": "Data Source=../../App_Data/lending.db"
  },
  "Database": {
    "Provider": "Sqlite",
    "Upgrade": true
  },
  "Core": {
    "Provider": "Simulator",
    "SimulatorDatabase": "../../App_Data/core-simulator.db"
  },
  "Bureau": {
    "Endpoint": "http://localhost:5109/bureau/ConsumerReportService.svc",
    "UserId": "test",
    "Password": "test"
  },
  "ESign": {
    "BaseUrl": "http://localhost:5109/esign/",
    "ApiKey": "dev-esign-key",
    "CallbackUrl": "http://localhost:5102/api/esign/callback",
    "CallbackSecret": "dev-callback-secret",
    "ReturnUrl": "http://localhost:5101/applications"
  },
  "PaymentsHub": {
    "BaseUrl": "http://localhost:5109/payhub/",
    "ClientSecret": "dev"
  },
  "Lending": {
    "BookingIntervalSeconds": 10
  },
  "Seed": {
    "ApiClients": {
      "customer-portal": { "Key": "dev-portal-key", "Scopes": "portal" },
      "back-office": { "Key": "dev-office-key", "Scopes": "office" }
    }
  },
  "NLog": {
    "variables": { "logDir": "../../App_Data/logs" },
    "rules": [
      { "logger": "Microsoft.*", "maxLevel": "Info", "final": true },
      { "logger": "System.Net.Http.*", "maxLevel": "Info", "final": true },
      { "logger": "*", "minLevel": "Info", "writeTo": "file,console" }
    ]
  }
}
