{
  "ConnectionStrings": {
    "Lending": "Server=sql01.corp.local;Database=ConsumerLending;User Id=lending_api;Password=;Encrypt=True;TrustServerCertificate=False;Application Name=Lending API"
  },
  "Database": {
    "Provider": "SqlServer",
    "Upgrade": false
  },
  "Core": {
    "Provider": "IbmI",
    "SystemName": "core.corp.local",
    "LendingLibrary": "LNLIB",
    "CustomerLibrary": "CIFLIB",
    "UseKerberos": true,
    "MaxConnections": 4,
    "OdbcConnectionString": "Driver={IBM i Access ODBC Driver};System=core.corp.local;Signon=4;Naming=1;DefaultLibraries=LNLIB,CIFLIB,RATLIB,DPLIB;CCSID=1208;TranslateBinary=1;CommitMode=0;"
  },
  "Bureau": {
    "Endpoint": "https://ws.nordiccredit.example/consumer/v3/ConsumerReportService.svc",
    "UserId": "LUCSB_LEND",
    "Password": "",
    "CustomerCode": "LUCSB"
  },
  "ESign": {
    "BaseUrl": "https://api.signhub.example",
    "ApiKey": "",
    "CallbackUrl": "https://lending-api.corp.local/api/esign/callback",
    "CallbackSecret": "",
    "ReturnUrl": "https://apply.corp.local/applications"
  },
  "PaymentsHub": {
    "BaseUrl": "https://payhub.corp.local/",
    "ClientId": "consumer-lending",
    "ClientSecret": ""
  },
  "Lending": {
    "OfferValidDays": 30,
    "AutoBookingLimit": 20000,
    "SeniorApprovalLimit": 30000,
    "BranchCode": "0901",
    "SystemUser": "LNWEB",
    "BookingIntervalSeconds": 60,
    "RunBackgroundWorkers": true
  },
  "NLog": {
    "throwConfigExceptions": true,
    "variables": { "logDir": "D:\\Logs\\ConsumerLoans\\Api" },
    "targets": {
      "async": true,
      "file": {
        "type": "File",
        "fileName": "${var:logDir}/lending-api-${shortdate}.log",
        "layout": "${longdate}|${level:uppercase=true}|${logger}|${aspnet-traceidentifier}|${message} ${exception:format=tostring}",
        "archiveEvery": "Day",
        "maxArchiveFiles": 60
      },
      "console": { "type": "Console" }
    },
    "rules": [
      { "logger": "Microsoft.*", "maxLevel": "Info", "final": true },
      { "logger": "System.Net.Http.*", "maxLevel": "Info", "final": true },
      { "logger": "*", "minLevel": "Info", "writeTo": "file" }
    ]
  },
  "AllowedHosts": "*"
}
