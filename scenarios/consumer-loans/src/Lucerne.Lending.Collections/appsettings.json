{
  "ConnectionStrings": {
    "Lending": "Server=sql01.corp.local;Database=ConsumerLending;User Id=lending_coll;Password=;Encrypt=True;Application Name=Lending Collections"
  },
  "Database": { "Provider": "SqlServer" },
  "Core": {
    "Provider": "IbmI",
    "SystemName": "core.corp.local",
    "UseKerberos": true,
    "EventQueueLibrary": "LNLIB",
    "EventQueue": "LNEVTQ",
    "MaxConnections": 2,
    "OdbcConnectionString": "Driver={IBM i Access ODBC Driver};System=core.corp.local;Signon=4;Naming=1;DefaultLibraries=LNLIB,CIFLIB,RATLIB,DPLIB;CCSID=1208;TranslateBinary=1;CommitMode=0;",
    "OleDbConnectionString": "Provider=IBMDA400;Data Source=core.corp.local;Default Collection=LNLIB;Convert Date Time To Char=FALSE;Catalog Library List=LNLIB,CIFLIB;"
  },
  "GeneralLedger": {
    "OutboundFolder": "D:\\Interfaces\\GL\\Outbound",
    "CompanyCode": "1100"
  },
  "Collections": {
    "AgencyOutboundFolder": "D:\\Interfaces\\Agency\\Outbound"
  },
  "PaymentsHub": { "BaseUrl": "https://payhub.corp.local/" },
  "Lending": { "SystemUser": "LNCOLL", "CostCenter": "4410" },
  "NLog": {
    "throwConfigExceptions": true,
    "variables": { "logDir": "D:\\Logs\\ConsumerLoans\\Collections" },
    "targets": {
      "file": {
        "type": "File",
        "fileName": "${var:logDir}/collections-${shortdate}.log",
        "layout": "${longdate}|${level:uppercase=true}|${logger}|${message} ${exception:format=tostring}",
        "maxArchiveFiles": 90
      },
      "console": { "type": "Console" }
    },
    "rules": [
      { "logger": "Microsoft.*", "maxLevel": "Info", "final": true },
      { "logger": "System.Net.Http.*", "maxLevel": "Info", "final": true },
      { "logger": "*", "minLevel": "Info", "writeTo": "file,console" }
    ]
  }
}
