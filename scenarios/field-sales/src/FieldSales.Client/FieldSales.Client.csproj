<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>7.3</LangVersion>
    <RootNamespace>Wingtip.FieldSales.Client</RootNamespace>
    <AssemblyName>FieldSales</AssemblyName>
    <ApplicationIcon>fieldsales.ico</ApplicationIcon>
    <Version>3.2.0</Version>
    <Company>Wingtip Foods</Company>
    <Product>Field Sales</Product>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>

  <!-- ClickOnce. Publish.ps1 passes InstallUrl, ApplicationVersion and the signing certificate thumbprint. -->
  <PropertyGroup>
    <IsWebBootstrapper>true</IsWebBootstrapper>
    <PublishUrl>publish\</PublishUrl>
    <InstallUrl>https://salesapp.corp.local/</InstallUrl>
    <Install>true</Install>
    <InstallFrom>Web</InstallFrom>
    <UpdateEnabled>true</UpdateEnabled>
    <UpdateMode>Foreground</UpdateMode>
    <UpdateRequired>false</UpdateRequired>
    <MapFileExtensions>true</MapFileExtensions>
    <CreateWebPageOnPublish>true</CreateWebPageOnPublish>
    <WebPage>publish.htm</WebPage>
    <ProductName>Field Sales</ProductName>
    <PublisherName>Wingtip Foods</PublisherName>
    <SuiteName>Wingtip Foods</SuiteName>
    <SupportUrl>https://salesadmin.corp.local/</SupportUrl>
    <ApplicationRevision>0</ApplicationRevision>
    <ApplicationVersion>3.2.0.%2a</ApplicationVersion>
    <MinimumRequiredVersion>3.2.0.0</MinimumRequiredVersion>
    <UseApplicationTrust>false</UseApplicationTrust>
    <BootstrapperEnabled>true</BootstrapperEnabled>
    <SignManifests>false</SignManifests>
    <TargetZone>LocalIntranet</TargetZone>
  </PropertyGroup>

  <ItemGroup>
    <BootstrapperPackage Include=".NETFramework,Version=v4.7.2">
      <Visible>False</Visible>
      <ProductName>Microsoft .NET Framework 4.7.2 (x86 and x64)</ProductName>
      <Install>true</Install>
    </BootstrapperPackage>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="log4net" Version="3.5.0" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Configuration" />
    <Reference Include="System.Deployment" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Security" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FieldSales.Core\FieldSales.Core.csproj" />
    <ProjectReference Include="..\FieldSales.Contracts\FieldSales.Contracts.csproj" />
  </ItemGroup>

  <!-- The API address is environment specific. Publish.ps1 passes -p:ApiBaseUrl=...; the value is written into a copy
       of App.config so that the ClickOnce manifest carries the right FieldSales.exe.config. -->
  <Target Name="SetApiBaseUrl" BeforeTargets="PrepareForBuild" Condition="'$(ApiBaseUrl)' != ''">
    <Copy SourceFiles="App.config" DestinationFiles="$(IntermediateOutputPath)App.config" />
    <XmlPoke XmlInputPath="$(IntermediateOutputPath)App.config" Query="/configuration/appSettings/add[@key='ApiBaseUrl']/@value" Value="$(ApiBaseUrl)" />
    <PropertyGroup>
      <AppConfig>$(IntermediateOutputPath)App.config</AppConfig>
    </PropertyGroup>
  </Target>

</Project>
