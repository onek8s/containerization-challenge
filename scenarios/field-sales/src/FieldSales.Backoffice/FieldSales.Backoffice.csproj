<Project Sdk="MSBuild.SDK.SystemWeb">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <RootNamespace>Wingtip.FieldSales.Backoffice</RootNamespace>
    <AssemblyName>FieldSales.Backoffice</AssemblyName>
    <AppConfig>Web.config</AppConfig>
    <Version>3.2.0</Version>
    <Company>Wingtip Foods</Company>
    <Product>Field Sales</Product>
    <GeneratedBindingRedirectsAction>None</GeneratedBindingRedirectsAction>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="Microsoft.AspNet.Mvc" Version="5.2.9" />
    <PackageReference Include="Microsoft.AspNet.Identity.Owin" Version="2.2.4" />
    <PackageReference Include="Microsoft.Owin.Host.SystemWeb" Version="4.2.2" />
    <PackageReference Include="Microsoft.Owin.Security.Cookies" Version="4.2.2" />
    <PackageReference Include="Autofac.Mvc5" Version="6.1.0" />
    <PackageReference Include="log4net" Version="3.5.0" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.ComponentModel.DataAnnotations" />
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.Configuration" />
    <Reference Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Views\**\*.cshtml" />
    <Content Include="Views\Web.config" />
    <Content Include="Content\**\*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FieldSales.Core\FieldSales.Core.csproj" />
    <ProjectReference Include="..\FieldSales.Data\FieldSales.Data.csproj" />
  </ItemGroup>

</Project>
