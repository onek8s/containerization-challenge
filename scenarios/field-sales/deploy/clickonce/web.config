<?xml version="1.0" encoding="utf-8"?>
<!-- ClickOnce deployment site. Manifests must never be cached by proxies or the laptop would not see new versions. -->
<configuration>
  <system.webServer>
    <staticContent>
      <remove fileExtension=".application" />
      <mimeMap fileExtension=".application" mimeType="application/x-ms-application" />
      <remove fileExtension=".manifest" />
      <mimeMap fileExtension=".manifest" mimeType="application/x-ms-manifest" />
      <remove fileExtension=".deploy" />
      <mimeMap fileExtension=".deploy" mimeType="application/octet-stream" />
      <clientCache cacheControlMode="DisableCache" />
    </staticContent>
    <defaultDocument>
      <files>
        <clear />
        <add value="publish.htm" />
      </files>
    </defaultDocument>
    <security>
      <requestFiltering>
        <fileExtensions>
          <remove fileExtension=".config" />
          <add fileExtension=".config" allowed="false" />
          <add fileExtension=".deploy" allowed="true" />
        </fileExtensions>
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
