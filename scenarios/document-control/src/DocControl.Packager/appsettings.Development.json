{
  "DocControl": {
    "Database": {
      "Provider": "Sqlite",
      "ConnectionString": "Data Source=../DocControl.Web/App_Data/doccontrol-dev.db",
      "CreateSampleData": true
    },
    "Storage": {
      "VaultRoot": "../DocControl.Web/App_Data/vault",
      "TransmittalRoot": "../DocControl.Web/App_Data/transmittals"
    },
    "Packager": {
      "PollSeconds": 5,
      "MaxParallelBuilds": 1,
      "WorkFolder": "App_Data/work",
      "MinFreeBytes": 104857600,
      "PortalUrl": "http://localhost:5080",
      "Mail": {
        "PickupDirectory": "App_Data/mail"
      }
    }
  }
}
