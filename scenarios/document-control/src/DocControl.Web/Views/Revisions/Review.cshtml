@model IReadOnlyList<RevisionRecord>
@{ ViewData["Title"] = "Review"; }
<h1>Waiting for review</h1>
@if (Model.Count == 0)
{
    <p class="muted">Nothing waiting.</p>
}
<table>
    <tr><th>Document</th><th>Rev</th><th>File</th><th>Submitted</th><th></th></tr>
    @foreach (var r in Model)
    {
        <tr>
            <td><a asp-controller="Register" asp-action="Document" asp-route-number="@r.DocumentNumber">@r.DocumentNumber</a><br /><small>@r.DocumentTitle</small></td>
            <td>@r.Code</td>
            <td><a asp-controller="Register" asp-action="File" asp-route-id="@r.Id">@r.FileName</a></td>
            <td>@r.SubmittedBy<br /><small>@r.SubmittedUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</small></td>
            <td>
                <form method="post" asp-action="Approve" class="inline">
                    <input type="hidden" name="id" value="@r.Id" />
                    <input name="comment" placeholder="Comment" />
                    <button type="submit">Approve</button>
                </form>
                <form method="post" asp-action="Reject" class="inline">
                    <input type="hidden" name="id" value="@r.Id" />
                    <input name="comment" placeholder="Reason" />
                    <button type="submit" class="danger">Reject</button>
                </form>
            </td>
        </tr>
    }
</table>
