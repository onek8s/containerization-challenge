module VanArsdel.Integration.Orchestrations
{
    internal porttype CanonicalInvoiceInType
    {
        oneway Receive
        {
            VanArsdel.Integration.Schemas.Canonical.CanonicalInvoice
        };
    };
    internal porttype ErpIDocOutType
    {
        oneway Send
        {
            VanArsdel.Integration.Schemas.IDoc.INVOIC02
        };
    };
    internal porttype NotifyType
    {
        oneway Send
        {
            System.Xml.XmlDocument
        };
    };
    [Microsoft.XLANGs.BaseTypes.BPELExportable(false)]
    internal service ProcessSupplierInvoice
    {
        [Microsoft.XLANGs.BaseTypes.DirectBinding()]
        port implements CanonicalInvoiceInType InvoiceIn;
        [Microsoft.XLANGs.BaseTypes.LogicalBinding()]
        port uses ErpIDocOutType ErpIDocOut;
        [Microsoft.XLANGs.BaseTypes.PhysicalBinding(typeof(Microsoft.BizTalk.DefaultPipelines.PassThruTransmit))]
        port uses dynamic NotifyType Notify;
        message System.Xml.XmlDocument NotifyMsg;
        message VanArsdel.Integration.Schemas.Canonical.CanonicalInvoice InvoiceMsg;
        message VanArsdel.Integration.Schemas.IDoc.INVOIC02 IDocMsg;
        System.String partnerId;
        System.String documentNumber;
        System.String unresolved;
        body ()
        {
            [Microsoft.XLANGs.BaseTypes.DesignerPosition("7048c840-6094-5ff9-bcc0-3b7d9bbcdf2b")]
            activate ((VanArsdel.Integration.Schemas.MessageKind == "SupplierInvoice") || (VanArsdel.Integration.Schemas.MessageKind == "SupplierCreditNote")) receive (InvoiceIn.Receive, InvoiceMsg);
            [Microsoft.XLANGs.BaseTypes.DesignerPosition("d892ea02-4929-5db2-91a1-7d71310dd91f")]
            partnerId = InvoiceMsg(VanArsdel.Integration.Schemas.PartnerId);
            documentNumber = xpath(InvoiceMsg, "string(/*[local-name()='Invoice']/*[local-name()='Header']/*[local-name()='InvoiceNumber'])");
            unresolved = xpath(InvoiceMsg, "string(/*[local-name()='Invoice']/*[local-name()='Lines']/*[starts-with(*[local-name()='Item'], '?')][1]/*[local-name()='PartnerItem'])");
            [Microsoft.XLANGs.BaseTypes.DesignerPosition("bf8c6bc9-5687-53fa-a967-b9210633f711")]
            if (unresolved != "")
            {
                [Microsoft.XLANGs.BaseTypes.DesignerPosition("80b1dc49-d4cb-57fd-91ed-28c09856f592")]
                construct NotifyMsg
                {
                    [Microsoft.XLANGs.BaseTypes.DesignerPosition("03a26d3d-6710-54f1-bca2-d5c6f4d91850")]
                    NotifyMsg = new System.Xml.XmlDocument();
                    NotifyMsg.LoadXml("<Notice/>");
                    NotifyMsg.DocumentElement.InnerText = "Supplier invoice " + documentNumber + " from " + partnerId + " has an item without cross-reference: " + unresolved;
                    NotifyMsg(SMTP.Subject) = VanArsdel.Integration.Runtime.Orchestration.OrderProcess.Subject("Supplier invoice item", partnerId, documentNumber);
                }
                [Microsoft.XLANGs.BaseTypes.DesignerPosition("1c3f3793-b473-58fe-ad55-1ad32d2e9cca")]
                Notify(Microsoft.XLANGs.BaseTypes.Address) = VanArsdel.Integration.Runtime.Orchestration.OrderProcess.MailTo("Purchasing");
                [Microsoft.XLANGs.BaseTypes.DesignerPosition("118e4932-9fab-59f2-8c4e-947ac77509b7")]
                send (Notify.Send, NotifyMsg);
            }
            [Microsoft.XLANGs.BaseTypes.DesignerPosition("9c0aaae3-1bc4-51ef-a021-a68b9a46d740")]
            construct IDocMsg
            {
                [Microsoft.XLANGs.BaseTypes.DesignerPosition("c79d8fa4-a6f4-54d4-a4de-aa72402309ba")]
                transform (IDocMsg) = VanArsdel.Integration.Maps.Invoice_to_IDoc_INVOIC02 (InvoiceMsg);
            }
            [Microsoft.XLANGs.BaseTypes.DesignerPosition("6f7672df-bde3-5785-90a0-18544756e085")]
            send (ErpIDocOut.Send, IDocMsg);
        }
    }
}
