                <om:Property Name="Signal" Value="False" />
                <om:Element Type="Receive" OID="01478673-4b3c-59d3-9b0b-cba2bb383976" ParentLink="ServiceBody_Statement">
                    <om:Property Name="Activate" Value="True" />
