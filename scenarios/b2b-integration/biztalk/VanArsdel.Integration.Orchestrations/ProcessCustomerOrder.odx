        };
    };
    internal porttype NotifyType
    {
        oneway Send
        {
            System.Xml.XmlDocument
        };
    };
    [Microsoft.XLANGs.BaseTypes.BPELExportable(false)]
    internal service ProcessCustomerOrder
    {
        [Microsoft.XLANGs.BaseTypes.DirectBinding()]
        port implements CanonicalOrderInType OrderIn;
        [Microsoft.XLANGs.BaseTypes.LogicalBinding()]
        port uses ErpOrderServiceType ErpOrderService;
        [Microsoft.XLANGs.BaseTypes.LogicalBinding()]
        port uses ErpIDocOutType ErpIDocOut;
        [Microsoft.XLANGs.BaseTypes.LogicalBinding()]
        port uses CreditHoldOutType CreditHoldOut;
        [Microsoft.XLANGs.BaseTypes.PhysicalBinding(typeof(Microsoft.BizTalk.DefaultPipelines.PassThruTransmit))]
        port uses dynamic NotifyType Notify;
        message System.Xml.XmlDocument NotifyMsg;
        message VanArsdel.Integration.Schemas.Canonical.CanonicalOrder OrderMsg;
        message VanArsdel.Integration.Schemas.Canonical.CanonicalOrder ErpOrderMsg;
        message VanArsdel.Integration.Schemas.IDoc.ORDERS05 IDocMsg;
        message VanArsdel.Integration.Schemas.Erp.OrderManagementService.CheckCredit CreditRequest;
        message VanArsdel.Integration.Schemas.Erp.OrderManagementService.CheckCreditResponse CreditResponse;
        System.String partnerId;
        System.String documentNumber;
        VanArsdel.Integration.Rules.RuleOutcome outcome;
        VanArsdel.Integration.Rules.PartnerFacts partnerFacts;
        System.Boolean released;
        System.Exception lastError;
        body ()
        {
            [Microsoft.XLANGs.BaseTypes.DesignerPosition("01478673-4b3c-59d3-9b0b-cba2bb383976")]
            activate (VanArsdel.Integration.Schemas.MessageKind == "CustomerOrder") receive (OrderIn.Receive, OrderMsg);
            [Microsoft.XLANGs.BaseTypes.DesignerPosition("99ff21af-f978-53ca-a9ae-f53c29e3c4f6")]
            partnerId = OrderMsg(VanArsdel.Integration.Schemas.PartnerId);
            documentNumber = OrderMsg(VanArsdel.Integration.Schemas.OrderNumber);
            released = false;
            VanArsdel.Integration.Runtime.Tracking.OrderLifecycleTracker.Received(partnerId, documentNumber, VanArsdel.Integration.Runtime.Orchestration.OrderProcess.StandardOf(partnerId), OrderMsg(BTS.InterchangeID), System.DateTime.UtcNow, System.Convert.ToInt32(xpath(OrderMsg, "count(/*[local-name()='Order']/*[local-name()='Lines']/*)")));
            [Microsoft.XLANGs.BaseTypes.DesignerPosition("5ba23322-c50e-5164-bff1-bc245da1e3fb")]
            scope
            {
                body
                {
                    [Microsoft.XLANGs.BaseTypes.DesignerPosition("cc122812-86c7-565d-a1ff-431bc2bc0406")]
                    outcome = VanArsdel.Integration.Runtime.Orchestration.OrderProcess.Validate(OrderMsg);
                    [Microsoft.XLANGs.BaseTypes.DesignerPosition("8b80b367-2a24-58a3-bdef-63331e2d2369")]
