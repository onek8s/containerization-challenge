module VanArsdel.Integration.Orchestrations
{
    internal porttype CanonicalOrderInType
    {
        oneway Receive
        {
            VanArsdel.Integration.Schemas.Canonical.CanonicalOrder
        };
    };
    internal porttype ErpOrderServiceType
    {
        requestresponse CheckCredit
        {
            VanArsdel.Integration.Schemas.Erp.OrderManagementService.CheckCredit, VanArsdel.Integration.Schemas.Erp.OrderManagementService.CheckCreditResponse
        };
    };
    internal porttype ErpIDocOutType
    {
        oneway Send
        {
            VanArsdel.Integration.Schemas.IDoc.ORDERS05
        };
    };
    internal porttype CreditHoldOutType
    {
        oneway Send
        {
