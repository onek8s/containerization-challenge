                    <om:Property Name="MessageName" Value="OrderMsg" />
                    <om:Property Name="OperationName" Value="Receive" />
                    <om:Property Name="OperationMessageName" Value="Request" />
                    <om:Property Name="Filter" Value='VanArsdel.Integration.Schemas.MessageKind == "CustomerOrder"' />
                    <om:Property Name="ReportToAnalyst" Value="True" />
                    <om:Property Name="Name" Value="ReceiveOrder" />
                    <om:Property Name="Signal" Value="True" />
                </om:Element>
                <om:Element Type="VariableAssignment" OID="99ff21af-f978-53ca-a9ae-f53c29e3c4f6" ParentLink="ServiceBody_Statement">
                    <om:Property Name="Expression" Value="partnerId = OrderMsg(VanArsdel.Integration.Schemas.PartnerId);&#10;documentNumber = OrderMsg(VanArsdel.Integration.Schemas.OrderNumber);&#10;released = false;&#10;VanArsdel.Integration.Runtime.Tracking.OrderLifecycleTracker.Received(partnerId, documentNumber, VanArsdel.Integration.Runtime.Orchestration.OrderProcess.StandardOf(partnerId), OrderMsg(BTS.InterchangeID), System.DateTime.UtcNow, System.Convert.ToInt32(xpath(OrderMsg, &quot;count(/*[local-name()='Order']/*[local-name()='Lines']/*)&quot;)));" />
                    <om:Property Name="ReportToAnalyst" Value="True" />
                    <om:Property Name="Name" Value="ReadOrderKeys" />
                    <om:Property Name="Signal" Value="False" />
                </om:Element>
                <om:Element Type="Scope" OID="5ba23322-c50e-5164-bff1-bc245da1e3fb" ParentLink="ServiceBody_Statement">
                    <om:Property Name="InitializedTransactionType" Value="True" />
                    <om:Property Name="IsSynchronized" Value="False" />
                    <om:Property Name="ReportToAnalyst" Value="True" />
                    <om:Property Name="Name" Value="ProcessOrder" />
                    <om:Property Name="Signal" Value="False" />
                    <om:Element Type="VariableAssignment" OID="cc122812-86c7-565d-a1ff-431bc2bc0406" ParentLink="ComplexStatement_Statement">
                        <om:Property Name="Expression" Value="outcome = VanArsdel.Integration.Runtime.Orchestration.OrderProcess.Validate(OrderMsg);" />
                        <om:Property Name="ReportToAnalyst" Value="True" />
                        <om:Property Name="Name" Value="ValidateOrder" />
                        <om:Property Name="Signal" Value="False" />
                    </om:Element>
                    <om:Element Type="Decision" OID="8b80b367-2a24-58a3-bdef-63331e2d2369" ParentLink="ComplexStatement_Statement">
                        <om:Property Name="ReportToAnalyst" Value="True" />
                        <om:Property Name="Name" Value="IsRejected" />
                        <om:Property Name="Signal" Value="False" />
                        <om:Element Type="DecisionBranch" OID="c917457b-0025-5b1f-9d5d-793789ad4587" ParentLink="ReallyComplexStatement_Branch">
                            <om:Property Name="Expression" Value="outcome.Rejected || outcome.ManualReview" />
                            <om:Property Name="IsGhostBranch" Value="False" />
                            <om:Property Name="ReportToAnalyst" Value="True" />
                            <om:Property Name="Name" Value="Rejected" />
                            <om:Property Name="Signal" Value="False" />
                            <om:Element Type="VariableAssignment" OID="67ae7502-6661-51c0-bfb3-2f6b794e9cc5" ParentLink="ComplexStatement_Statement">
                                <om:Property Name="Expression" Value="VanArsdel.Integration.Runtime.Tracking.OrderLifecycleTracker.Rejected(partnerId, documentNumber, outcome.Summary(), System.DateTime.UtcNow);" />
                                <om:Property Name="ReportToAnalyst" Value="True" />
                                <om:Property Name="Name" Value="TrackRejected" />
                                <om:Property Name="Signal" Value="False" />
                            </om:Element>
                            <om:Element Type="Construct" OID="19805652-c36b-56fe-86a5-b9cc39120e74" ParentLink="ComplexStatement_Statement">
                                <om:Property Name="ReportToAnalyst" Value="True" />
                                <om:Property Name="Name" Value="BuildNotice" />
                                <om:Property Name="Signal" Value="False" />
                                <om:Element Type="MessageAssignment" OID="65da3b5f-e4e6-5f4d-8051-c76a82ff3a2d" ParentLink="ComplexStatement_Statement">
                                    <om:Property Name="Expression" Value='NotifyMsg = new System.Xml.XmlDocument();&#10;NotifyMsg.LoadXml("&lt;Notice/&gt;");&#10;NotifyMsg.DocumentElement.InnerText = VanArsdel.Integration.Runtime.Orchestration.OrderProcess.RejectionNotice(partnerId, documentNumber, outcome);&#10;NotifyMsg(SMTP.Subject) = VanArsdel.Integration.Runtime.Orchestration.OrderProcess.Subject("Rejected order", partnerId, documentNumber);' />
                                    <om:Property Name="ReportToAnalyst" Value="False" />
                                    <om:Property Name="Name" Value="Assign_BuildNotice" />
                                    <om:Property Name="Signal" Value="False" />
                                </om:Element>
                                <om:Element Type="MessageRef" OID="e5dea354-0a67-524e-871b-916dbfd66912" ParentLink="Construct_MessageRef">
                                    <om:Property Name="Ref" Value="NotifyMsg" />
                                    <om:Property Name="ReportToAnalyst" Value="True" />
                                    <om:Property Name="Signal" Value="False" />
                                </om:Element>
                            </om:Element>
                            <om:Element Type="VariableAssignment" OID="cb460ee8-a561-50be-a0ad-235c824ae12c" ParentLink="ComplexStatement_Statement">
                                <om:Property Name="Expression" Value='Notify(Microsoft.XLANGs.BaseTypes.Address) = VanArsdel.Integration.Runtime.Orchestration.OrderProcess.MailTo("CustomerService");' />
                                <om:Property Name="ReportToAnalyst" Value="True" />
                                <om:Property Name="Name" Value="SetMailTo" />
                                <om:Property Name="Signal" Value="False" />
