module VanArsdel.Integration.Orchestrations
{
    internal porttype CanonicalInvoiceInType
    {
        oneway Receive
        {
            VanArsdel.Integration.Schemas.Canonical.CanonicalInvoice
        };
    };
    internal porttype PartnerInvoiceOutType
    {
        oneway Send
        {
            System.Xml.XmlDocument
        };
    };
    [Microsoft.XLANGs.BaseTypes.BPELExportable(false)]
    internal service SendCustomerInvoice
    {
        [Microsoft.XLANGs.BaseTypes.DirectBinding()]
        port implements CanonicalInvoiceInType InvoiceIn;
        [Microsoft.XLANGs.BaseTypes.DirectBinding()]
        port uses PartnerInvoiceOutType PartnerOut;
        message VanArsdel.Integration.Schemas.Canonical.CanonicalInvoice InvoiceMsg;
        message VanArsdel.Integration.Schemas.X12.X12_00401_810 X12Msg;
        message VanArsdel.Integration.Schemas.Edifact.EFACT_D96A_INVOIC EdifactMsg;
        System.String partnerId;
        System.String documentNumber;
        System.String erpOrderNumber;
        System.String standard;
        body ()
        {
            [Microsoft.XLANGs.BaseTypes.DesignerPosition("c1eca2c0-14e3-5208-b4d8-6969f01c379d")]
            activate (VanArsdel.Integration.Schemas.MessageKind == "CustomerInvoice") receive (InvoiceIn.Receive, InvoiceMsg);
            [Microsoft.XLANGs.BaseTypes.DesignerPosition("e766676d-56a2-519d-8312-fba6625f2879")]
            partnerId = InvoiceMsg(VanArsdel.Integration.Schemas.PartnerId);
            documentNumber = xpath(InvoiceMsg, "string(/*[local-name()='Invoice']/*[local-name()='Header']/*[local-name()='InvoiceNumber'])");
            erpOrderNumber = xpath(InvoiceMsg, "string(/*[local-name()='Invoice']/*[local-name()='Header']/*[local-name()='ErpOrderNumber'])");
            standard = VanArsdel.Integration.Runtime.Orchestration.OrderProcess.StandardOf(partnerId);
            [Microsoft.XLANGs.BaseTypes.DesignerPosition("84a02aec-0819-5616-85ef-ad8ee5c28a34")]
            if (standard == "X12")
            {
                [Microsoft.XLANGs.BaseTypes.DesignerPosition("05c43684-b74b-56ad-9d12-9aa1969d0b50")]
                construct X12Msg
                {
                    [Microsoft.XLANGs.BaseTypes.DesignerPosition("e89abda2-16b7-5b27-9173-567b1bff0ae9")]
                    transform (X12Msg) = VanArsdel.Integration.Maps.Invoice_to_X12_00401_810 (InvoiceMsg);
                }
                [Microsoft.XLANGs.BaseTypes.DesignerPosition("ac474b68-81e9-53c9-a69e-8e427233617f")]
                construct X12Msg
                {
                    [Microsoft.XLANGs.BaseTypes.DesignerPosition("6fbff5ea-f7ef-5454-b8cd-3f6820a6facd")]
                    X12Msg = X12Msg;
                    X12Msg(VanArsdel.Integration.Schemas.PartnerId) = partnerId;
                    X12Msg(VanArsdel.Integration.Schemas.Endpoint) = VanArsdel.Integration.Runtime.Orchestration.OrderProcess.EndpointFor(partnerId, "Invoice");
                }
                [Microsoft.XLANGs.BaseTypes.DesignerPosition("babb16b3-62a8-5a3f-9154-8dc562ab7040")]
                send (PartnerOut.Send, X12Msg);
            }
            else
            {
                [Microsoft.XLANGs.BaseTypes.DesignerPosition("75d5ff11-57de-55e5-8e51-d3d2e010d2a9")]
                construct EdifactMsg
                {
                    [Microsoft.XLANGs.BaseTypes.DesignerPosition("34f82479-bbf2-5b9a-8ca1-85579d73b4d3")]
                    transform (EdifactMsg) = VanArsdel.Integration.Maps.Invoice_to_EFACT_D96A_INVOIC (InvoiceMsg);
                }
                [Microsoft.XLANGs.BaseTypes.DesignerPosition("c132257d-84bc-53ef-8987-bebc064cef23")]
                construct EdifactMsg
                {
