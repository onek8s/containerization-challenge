module VanArsdel.Integration.Orchestrations
{
    internal porttype FunctionalAckInType
    {
        oneway Receive
        {
            VanArsdel.Integration.Schemas.Canonical.CanonicalFunctionalAck
        };
    };
    internal porttype NotifyType
    {
        oneway Send
        {
            System.Xml.XmlDocument
        };
    };
    [Microsoft.XLANGs.BaseTypes.BPELExportable(false)]
    internal service ProcessFunctionalAck
    {
        [Microsoft.XLANGs.BaseTypes.DirectBinding()]
        port implements FunctionalAckInType AckIn;
        [Microsoft.XLANGs.BaseTypes.PhysicalBinding(typeof(Microsoft.BizTalk.DefaultPipelines.PassThruTransmit))]
        port uses dynamic NotifyType Notify;
        message System.Xml.XmlDocument NotifyMsg;
        message VanArsdel.Integration.Schemas.Canonical.CanonicalFunctionalAck AckMsg;
        System.String partnerId;
        System.String documentNumber;
        System.String status;
        System.Boolean matched;
        body ()
        {
            [Microsoft.XLANGs.BaseTypes.DesignerPosition("25f1e266-28e4-528e-9c16-d22419707fbf")]
            activate (BTS.MessageType == "http://schemas.vanarsdel.com/integration/canonical/2014#FunctionalAck" && VanArsdel.Integration.Schemas.MessageKind != "PurchaseOrderAck") receive (AckIn.Receive, AckMsg);
            [Microsoft.XLANGs.BaseTypes.DesignerPosition("f02756d9-41c0-55ec-8fa6-9f3c9333d8b8")]
            partnerId = AckMsg(VanArsdel.Integration.Schemas.PartnerId);
            documentNumber = AckMsg(VanArsdel.Integration.Schemas.AckControlNumber);
            status = xpath(AckMsg, "string(/*[local-name()='FunctionalAck']/*[local-name()='Status'])");
            matched = VanArsdel.Integration.Runtime.Interchanges.InterchangeRegistry.ApplyAck(partnerId, documentNumber, status, System.DateTime.UtcNow);
            [Microsoft.XLANGs.BaseTypes.DesignerPosition("2b64c098-6e8d-56e0-aa04-ed456547f9f7")]
            if (status == "Rejected" || status == "AcceptedWithErrors" || !matched)
            {
                [Microsoft.XLANGs.BaseTypes.DesignerPosition("6c1ba41b-f483-557d-9e13-b5c965aecef5")]
                construct NotifyMsg
                {
                    [Microsoft.XLANGs.BaseTypes.DesignerPosition("fb9c4da1-0f11-500b-9889-b0bc134f30ec")]
                    NotifyMsg = new System.Xml.XmlDocument();
                    NotifyMsg.LoadXml("<Notice/>");
                    NotifyMsg.DocumentElement.InnerText = "Partner " + partnerId + " acknowledged control number " + documentNumber + " with " + status + (matched ? "" : " (no matching interchange)");
                    NotifyMsg(SMTP.Subject) = VanArsdel.Integration.Runtime.Orchestration.OrderProcess.Subject("Acknowledgement problem", partnerId, documentNumber);
                }
                [Microsoft.XLANGs.BaseTypes.DesignerPosition("d650fecf-f6f3-577e-afcb-d111a6c6c866")]
                Notify(Microsoft.XLANGs.BaseTypes.Address) = VanArsdel.Integration.Runtime.Orchestration.OrderProcess.MailTo("Integration");
                [Microsoft.XLANGs.BaseTypes.DesignerPosition("d730c9d0-58be-5ce9-a581-515ffefd91ba")]
                send (Notify.Send, NotifyMsg);
            }
        }
    }
}
