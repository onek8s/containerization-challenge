                    <om:Property Name="Filter" Value='BTS.MessageType == "http://schemas.vanarsdel.com/integration/canonical/2014#FunctionalAck" &amp;&amp; VanArsdel.Integration.Schemas.MessageKind != "PurchaseOrderAck"' />
