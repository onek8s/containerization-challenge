                        <om:Property Name="Expression" Value='standard == "Edifact"' />
                        <om:Property Name="IsGhostBranch" Value="False" />
                        <om:Property Name="ReportToAnalyst" Value="True" />
                        <om:Property Name="Name" Value="Edifact" />
                        <om:Property Name="Signal" Value="False" />
                        <om:Element Type="Construct" OID="ae6112e3-bc77-524e-a12c-5fe3c10eb045" ParentLink="ComplexStatement_Statement">
                            <om:Property Name="ReportToAnalyst" Value="True" />
