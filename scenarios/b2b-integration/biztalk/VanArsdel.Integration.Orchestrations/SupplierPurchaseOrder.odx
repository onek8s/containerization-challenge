                    <om:Element Type="Transform" OID="9b532730-f1d4-5c9f-a1fb-324b00ab3949" ParentLink="ComplexStatement_Statement">
                        <om:Property Name="ClassName" Value="VanArsdel.Integration.Maps.IDoc_ORDERS05_to_Order" />
