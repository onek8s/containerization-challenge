                <om:Element Type="Receive" OID="0b40a21e-5c14-5c77-8e6e-e77a9e271674" ParentLink="ServiceBody_Statement">
                    <om:Property Name="Activate" Value="True" />
                    <om:Property Name="PortName" Value="PurchaseOrderIn" />
                    <om:Property Name="MessageName" Value="PoIDocMsg" />
                    <om:Property Name="OperationName" Value="Receive" />
                    <om:Property Name="OperationMessageName" Value="Request" />
                    <om:Property Name="Filter" Value='VanArsdel.Integration.Schemas.MessageKind == "ORDERS" &amp;&amp; VanArsdel.Integration.Schemas.SourceSystem == "ERP"' />
                    <om:Property Name="ReportToAnalyst" Value="True" />
                    <om:Property Name="Name" Value="ReceivePurchaseOrder" />
