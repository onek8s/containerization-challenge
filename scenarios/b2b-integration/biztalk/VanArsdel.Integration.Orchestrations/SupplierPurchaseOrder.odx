                </om:Element>
                <om:Element Type="VariableAssignment" OID="bb94fa5f-962b-5cac-95ea-abc5d416fff5" ParentLink="ServiceBody_Statement">
                    <om:Property Name="Expression" Value='partnerId = PoMsg(VanArsdel.Integration.Schemas.PartnerId);&#10;documentNumber = PoMsg(VanArsdel.Integration.Schemas.OrderNumber);&#10;standard = VanArsdel.Integration.Runtime.Orchestration.OrderProcess.StandardOf(partnerId);&#10;controlNumber = VanArsdel.Integration.Runtime.Interchanges.InterchangeRegistry.NextControlNumber(partnerId, "Interchange", 9);&#10;ackTimeout = VanArsdel.Integration.Runtime.Orchestration.OrderProcess.AckTimeout(partnerId);' />
                    <om:Property Name="ReportToAnalyst" Value="True" />
                    <om:Property Name="Name" Value="ReadPoKeys" />
                    <om:Property Name="Signal" Value="False" />
                </om:Element>
                <om:Element Type="Decision" OID="208a3ab4-373f-5cf8-a81a-72f859d7e20c" ParentLink="ServiceBody_Statement">
                    <om:Property Name="ReportToAnalyst" Value="True" />
