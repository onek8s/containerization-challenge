module VanArsdel.Integration.Orchestrations
{
    internal porttype PurchaseOrderIDocInType
    {
        oneway Receive
        {
            VanArsdel.Integration.Schemas.IDoc.ORDERS05
        };
    };
    internal porttype SupplierOrderOutType
    {
        oneway Send
        {
            System.Xml.XmlDocument
        };
    };
    internal porttype FunctionalAckInType
    {
        oneway Receive
        {
            VanArsdel.Integration.Schemas.Canonical.CanonicalFunctionalAck
        };
    };
    internal porttype NotifyType
    {
        oneway Send
        {
            System.Xml.XmlDocument
        };
    };
    internal correlationtype AckCorrelationType
    {
        VanArsdel.Integration.Schemas.PartnerId, VanArsdel.Integration.Schemas.AckControlNumber
    };
    [Microsoft.XLANGs.BaseTypes.BPELExportable(false)]
    internal service SupplierPurchaseOrder
    {
        [Microsoft.XLANGs.BaseTypes.DirectBinding()]
        port implements PurchaseOrderIDocInType PurchaseOrderIn;
        [Microsoft.XLANGs.BaseTypes.DirectBinding()]
        port uses SupplierOrderOutType SupplierOut;
        [Microsoft.XLANGs.BaseTypes.DirectBinding()]
        port implements FunctionalAckInType AckIn;
        [Microsoft.XLANGs.BaseTypes.PhysicalBinding(typeof(Microsoft.BizTalk.DefaultPipelines.PassThruTransmit))]
        port uses dynamic NotifyType Notify;
        correlation AckCorrelationType AckCorrelation;
        message System.Xml.XmlDocument NotifyMsg;
        message VanArsdel.Integration.Schemas.IDoc.ORDERS05 PoIDocMsg;
        message VanArsdel.Integration.Schemas.Canonical.CanonicalOrder PoMsg;
        message System.Xml.XmlDocument SupplierMsg;
        message VanArsdel.Integration.Schemas.Canonical.CanonicalFunctionalAck AckMsg;
        System.String partnerId;
        System.String documentNumber;
        System.String standard;
        System.String controlNumber;
        System.TimeSpan ackTimeout;
        body ()
        {
            [Microsoft.XLANGs.BaseTypes.DesignerPosition("0b40a21e-5c14-5c77-8e6e-e77a9e271674")]
            activate (VanArsdel.Integration.Schemas.MessageKind == "ORDERS" && VanArsdel.Integration.Schemas.SourceSystem == "ERP") receive (PurchaseOrderIn.Receive, PoIDocMsg);
            [Microsoft.XLANGs.BaseTypes.DesignerPosition("a3933112-3a85-53b9-83eb-a7aea1912d85")]
            construct PoMsg
            {
                [Microsoft.XLANGs.BaseTypes.DesignerPosition("bcbe6537-e01a-589a-b929-e0a677e132e9")]
                transform (PoMsg) = VanArsdel.Integration.Maps.IDoc_ORDERS05_to_Order (PoIDocMsg);
            }
            [Microsoft.XLANGs.BaseTypes.DesignerPosition("bb94fa5f-962b-5cac-95ea-abc5d416fff5")]
            partnerId = PoMsg(VanArsdel.Integration.Schemas.PartnerId);
            documentNumber = PoMsg(VanArsdel.Integration.Schemas.OrderNumber);
            standard = VanArsdel.Integration.Runtime.Orchestration.OrderProcess.StandardOf(partnerId);
            controlNumber = VanArsdel.Integration.Runtime.Interchanges.InterchangeRegistry.NextControlNumber(partnerId, "Interchange", 9);
            ackTimeout = VanArsdel.Integration.Runtime.Orchestration.OrderProcess.AckTimeout(partnerId);
            [Microsoft.XLANGs.BaseTypes.DesignerPosition("208a3ab4-373f-5cf8-a81a-72f859d7e20c")]
            if (standard == "Edifact")
            {
                [Microsoft.XLANGs.BaseTypes.DesignerPosition("ae6112e3-bc77-524e-a12c-5fe3c10eb045")]
                construct SupplierMsg
                {
                    [Microsoft.XLANGs.BaseTypes.DesignerPosition("873214df-721d-5e12-b80e-dc53e788381a")]
                    transform (SupplierMsg) = VanArsdel.Integration.Maps.Order_to_EFACT_D96A_ORDERS (PoMsg);
                }
                [Microsoft.XLANGs.BaseTypes.DesignerPosition("cd37215d-fb61-564c-8bfa-a776d17af264")]
                construct SupplierMsg
                {
                    [Microsoft.XLANGs.BaseTypes.DesignerPosition("841b983a-5bcd-5fcd-a7ae-e5e10661b9c2")]
                    SupplierMsg = SupplierMsg;
                    SupplierMsg(EDIOverride.OverrideEDIHeader) = true;
                    SupplierMsg(EDIOverride.UNB5) = controlNumber;
                    SupplierMsg(VanArsdel.Integration.Schemas.PartnerId) = partnerId;
                    SupplierMsg(VanArsdel.Integration.Schemas.AckControlNumber) = controlNumber;
                    SupplierMsg(VanArsdel.Integration.Schemas.Endpoint) = VanArsdel.Integration.Runtime.Orchestration.OrderProcess.EndpointFor(partnerId, "PurchaseOrder");
                }
            }
            else
            {
                [Microsoft.XLANGs.BaseTypes.DesignerPosition("f8ab441a-92ea-5c89-866f-d6ad89e3bbf6")]
                construct SupplierMsg
                {
                    [Microsoft.XLANGs.BaseTypes.DesignerPosition("e7df477b-bc78-5166-9ebd-ff34e2f86edd")]
                    transform (SupplierMsg) = VanArsdel.Integration.Maps.Order_to_X12_00401_850 (PoMsg);
                }
                [Microsoft.XLANGs.BaseTypes.DesignerPosition("de6b5451-7f89-503f-8333-d9715b4f3996")]
                construct SupplierMsg
                {
                    [Microsoft.XLANGs.BaseTypes.DesignerPosition("48c393c3-97dd-5d1c-b751-d68b917bb283")]
                    SupplierMsg = SupplierMsg;
                    SupplierMsg(EDIOverride.OverrideEDIHeader) = true;
                    SupplierMsg(EDIOverride.ISA13) = controlNumber;
                    SupplierMsg(EDIOverride.GS06) = System.Convert.ToString(System.Convert.ToInt64(controlNumber));
                    SupplierMsg(VanArsdel.Integration.Schemas.PartnerId) = partnerId;
                    SupplierMsg(VanArsdel.Integration.Schemas.AckControlNumber) = System.Convert.ToString(System.Convert.ToInt64(controlNumber));
                    SupplierMsg(VanArsdel.Integration.Schemas.Endpoint) = VanArsdel.Integration.Runtime.Orchestration.OrderProcess.EndpointFor(partnerId, "PurchaseOrder");
                }
            }
            [Microsoft.XLANGs.BaseTypes.DesignerPosition("39071a65-9ea9-534e-9b32-3d3744becdb2")]
            send (SupplierOut.Send, SupplierMsg, AckCorrelation);
            [Microsoft.XLANGs.BaseTypes.DesignerPosition("d79305ba-a88a-508a-92b7-04d6dd34a6c0")]
            VanArsdel.Integration.Runtime.Interchanges.InterchangeRegistry.RegisterOutbound(partnerId, VanArsdel.Integration.Domain.Orders.DocumentKind.PurchaseOrder, controlNumber, controlNumber, 1, "", System.DateTime.UtcNow);
            [Microsoft.XLANGs.BaseTypes.DesignerPosition("c191d9b2-ebe4-5d7b-a587-247cfb62954f")]
            listen
            {
                until [Microsoft.XLANGs.BaseTypes.DesignerPosition("25d9f3de-f9ae-54a2-abe7-b1b7e8d12f18")] receive (AckIn.Receive, AckMsg, AckCorrelation)
                {
                    [Microsoft.XLANGs.BaseTypes.DesignerPosition("29a25341-b0b6-581d-956e-800064ab2447")]
                    VanArsdel.Integration.Runtime.Interchanges.InterchangeRegistry.ApplyAck(partnerId, AckMsg(VanArsdel.Integration.Schemas.AckControlNumber), xpath(AckMsg, "string(/*[local-name()='FunctionalAck']/*[local-name()='Status'])"), System.DateTime.UtcNow);
                }
                timeout ackTimeout
                {
                    [Microsoft.XLANGs.BaseTypes.DesignerPosition("e9d0a596-587e-50d4-9b91-0a72fc82bfa7")]
                    construct NotifyMsg
                    {
                        [Microsoft.XLANGs.BaseTypes.DesignerPosition("c75b1082-ad6b-5284-a85a-b12a4c2dfc03")]
                        NotifyMsg = new System.Xml.XmlDocument();
                        NotifyMsg.LoadXml("<Notice/>");
                        NotifyMsg.DocumentElement.InnerText = "No 997/CONTRL received for purchase order " + documentNumber + " (control number " + controlNumber + ") within " + ackTimeout.ToString();
                        NotifyMsg(SMTP.Subject) = VanArsdel.Integration.Runtime.Orchestration.OrderProcess.Subject("Missing acknowledgement", partnerId, documentNumber);
                    }
                    [Microsoft.XLANGs.BaseTypes.DesignerPosition("d48c1adf-b126-55fe-9262-9a030f954d22")]
                    Notify(Microsoft.XLANGs.BaseTypes.Address) = VanArsdel.Integration.Runtime.Orchestration.OrderProcess.MailTo("Purchasing");
                    [Microsoft.XLANGs.BaseTypes.DesignerPosition("02961008-3f03-5cc4-9824-33ad91254304")]
                    send (Notify.Send, NotifyMsg);
                }
            }
        }
    }
}
