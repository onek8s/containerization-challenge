                        </om:Element>
                        <om:Element Type="Construct" OID="cd37215d-fb61-564c-8bfa-a776d17af264" ParentLink="ComplexStatement_Statement">
                            <om:Property Name="ReportToAnalyst" Value="True" />
                            <om:Property Name="Name" Value="OverrideUnb" />
                            <om:Property Name="Signal" Value="False" />
                            <om:Element Type="MessageAssignment" OID="e0e8f358-b801-5c5a-844a-46f844106641" ParentLink="ComplexStatement_Statement">
                                <om:Property Name="Expression" Value='SupplierMsg = SupplierMsg;&#10;SupplierMsg(EDIOverride.OverrideEDIHeader) = true;&#10;SupplierMsg(EDIOverride.UNB5) = controlNumber;&#10;SupplierMsg(VanArsdel.Integration.Schemas.PartnerId) = partnerId;&#10;SupplierMsg(VanArsdel.Integration.Schemas.AckControlNumber) = controlNumber;&#10;SupplierMsg(VanArsdel.Integration.Schemas.Endpoint) = VanArsdel.Integration.Runtime.Orchestration.OrderProcess.EndpointFor(partnerId, "PurchaseOrder");' />
                                <om:Property Name="ReportToAnalyst" Value="False" />
