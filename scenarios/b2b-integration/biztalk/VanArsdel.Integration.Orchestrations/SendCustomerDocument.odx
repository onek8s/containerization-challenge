module VanArsdel.Integration.Orchestrations
{
    internal porttype CanonicalDespatchInType
    {
        oneway Receive
        {
            VanArsdel.Integration.Schemas.Canonical.CanonicalDespatch
        };
    };
    internal porttype PartnerDocumentOutType
    {
        oneway Send
        {
            System.Xml.XmlDocument
        };
    };
    [Microsoft.XLANGs.BaseTypes.BPELExportable(false)]
    internal service SendCustomerDocument
    {
        [Microsoft.XLANGs.BaseTypes.DirectBinding()]
        port implements CanonicalDespatchInType DespatchIn;
        [Microsoft.XLANGs.BaseTypes.DirectBinding()]
        port uses PartnerDocumentOutType PartnerOut;
        message VanArsdel.Integration.Schemas.Canonical.CanonicalDespatch DespatchMsg;
        message System.Xml.XmlDocument PartnerMsg;
        System.String partnerId;
        System.String documentNumber;
        System.String erpOrderNumber;
        VanArsdel.Integration.Domain.Routing.RoutingSlip slip;
        System.Type mapType;
        System.String endpoint;
        body ()
        {
            [Microsoft.XLANGs.BaseTypes.DesignerPosition("dbee003b-6d89-5826-96ff-864511a62f3a")]
            activate (BTS.MessageType == "http://schemas.vanarsdel.com/integration/canonical/2014#Despatch") receive (DespatchIn.Receive, DespatchMsg);
            [Microsoft.XLANGs.BaseTypes.DesignerPosition("640bac90-a5b1-5ef3-8e81-6b6c1992eed6")]
            partnerId = DespatchMsg(VanArsdel.Integration.Schemas.PartnerId);
            documentNumber = xpath(DespatchMsg, "string(/*[local-name()='Despatch']/*[local-name()='Header']/*[local-name()='DespatchNumber'])");
            erpOrderNumber = xpath(DespatchMsg, "string(/*[local-name()='Despatch']/*[local-name()='Header']/*[local-name()='ErpOrderNumber'])");
            VanArsdel.Integration.Runtime.Tracking.OrderLifecycleTracker.ConfirmedByErp(partnerId, xpath(DespatchMsg, "string(/*[local-name()='Despatch']/*[local-name()='Header']/*[local-name()='OrderNumber'])"), erpOrderNumber, System.DateTime.UtcNow);
            VanArsdel.Integration.Runtime.Tracking.OrderLifecycleTracker.DespatchReceived(erpOrderNumber, documentNumber, System.DateTime.UtcNow);
            slip = VanArsdel.Integration.Domain.Routing.RoutingSlip.Parse(VanArsdel.Integration.Runtime.Orchestration.OrderProcess.RoutingSlipFor(partnerId, "Despatch"));
            [Microsoft.XLANGs.BaseTypes.DesignerPosition("52e46c1b-40c7-5c2b-b63b-e5cc135b779b")]
            while (!slip.IsComplete)
            {
                [Microsoft.XLANGs.BaseTypes.DesignerPosition("e993671f-f543-55f8-87e2-f4526992f682")]
                if (slip.Current.Kind == VanArsdel.Integration.Domain.Routing.RoutingStepKind.Transform)
                {
                    [Microsoft.XLANGs.BaseTypes.DesignerPosition("6937b113-e7f3-597b-ba8d-0932f089ccf0")]
                    mapType = System.Type.GetType("VanArsdel.Integration.Maps." + slip.Current.Target + ", VanArsdel.Integration.Maps, Version=4.0.0.0, Culture=neutral, PublicKeyToken=7cfedfd825850e71", true);
                    [Microsoft.XLANGs.BaseTypes.DesignerPosition("98dfc6f5-c70d-507f-bd6f-c53e452afdb7")]
                    construct PartnerMsg
                    {
                        [Microsoft.XLANGs.BaseTypes.DesignerPosition("5ed20455-ec35-5275-bd02-deadde8762aa")]
                        transform (PartnerMsg) = mapType (DespatchMsg);
                        PartnerMsg(VanArsdel.Integration.Schemas.PartnerId) = partnerId;
                        PartnerMsg(VanArsdel.Integration.Schemas.RoutingSlip) = slip.ToString();
                    }
                }
                else if (slip.Current.Kind == VanArsdel.Integration.Domain.Routing.RoutingStepKind.Send)
                {
                    [Microsoft.XLANGs.BaseTypes.DesignerPosition("8b84ee0d-5fb9-504c-a2a7-1c69115c291f")]
                    endpoint = slip.Current.Target;
                    [Microsoft.XLANGs.BaseTypes.DesignerPosition("00ebba4d-016e-56fe-9827-23e16bdcdfa4")]
                    construct PartnerMsg
                    {
                        [Microsoft.XLANGs.BaseTypes.DesignerPosition("0e8af084-5dfd-5131-9c6b-49a73a6b23a2")]
                        PartnerMsg = PartnerMsg;
                        PartnerMsg(VanArsdel.Integration.Schemas.Endpoint) = endpoint;
                        PartnerMsg(VanArsdel.Integration.Schemas.PartnerId) = partnerId;
                    }
                    [Microsoft.XLANGs.BaseTypes.DesignerPosition("b6515c99-0c3d-518b-b507-cb647cd55800")]
                    send (PartnerOut.Send, PartnerMsg);
                    [Microsoft.XLANGs.BaseTypes.DesignerPosition("7a2971e7-1deb-5275-88d4-b734853ccecd")]
                    VanArsdel.Integration.Runtime.Tracking.OrderLifecycleTracker.DespatchSent(erpOrderNumber, documentNumber, System.DateTime.UtcNow);
                }
                else
                {
                    [Microsoft.XLANGs.BaseTypes.DesignerPosition("8b003477-f942-5c8f-8a49-181b57d6f71e")]
                    System.Diagnostics.Trace.TraceInformation("Routing step " + slip.Current.ToString() + " handled by the send port");
                }
                [Microsoft.XLANGs.BaseTypes.DesignerPosition("999f2a24-4d77-58bf-b80a-293800f57957")]
                slip = slip.Advance();
            }
        }
    }
}
