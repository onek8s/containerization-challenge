<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="dataConfiguration" type="Microsoft.Practices.EnterpriseLibrary.Data.Configuration.DatabaseSettings, Microsoft.Practices.EnterpriseLibrary.Data" requirePermission="true" />
    <section name="log4net" type="log4net.Config.Log4NetConfigurationSectionHandler, log4net" />
  </configSections>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
  </startup>
  <dataConfiguration defaultDatabase="VanArsdelIntegration" />
  <connectionStrings>
    <!-- service account CORP\svc-b2bmonitor: db_datareader + monitoring procedures, BizTalk Operators (MessageBox read, WMI) -->
    <add name="VanArsdelIntegration" connectionString="Data Source=BTSSQL01;Initial Catalog=VanArsdelIntegration;Integrated Security=SSPI;Application Name=B2B.SlaMonitor" providerName="System.Data.SqlClient" />
    <add name="BAMPrimaryImport" connectionString="Data Source=BTSSQL01;Initial Catalog=BAMPrimaryImport;Integrated Security=SSPI;Application Name=B2B.SlaMonitor" providerName="System.Data.SqlClient" />
    <add name="BizTalkMsgBoxDb" connectionString="Data Source=BTSSQL01;Initial Catalog=BizTalkMsgBoxDb;Integrated Security=SSPI;Application Name=B2B.SlaMonitor;Connect Timeout=10" providerName="System.Data.SqlClient" />
  </connectionStrings>
  <appSettings>
    <add key="Monitor.Environment" value="PROD" />
    <add key="Monitor.IntervalMinutes" value="5" />
    <add key="Monitor.RepeatAfterMinutes" value="60" />
    <add key="Monitor.EscalateAfterRepeats" value="3" />
    <add key="Monitor.TimeZone" value="GMT Standard Time" />
    <add key="Monitor.BusinessOpen" value="07:00" />
    <add key="Monitor.BusinessClose" value="18:00" />
    <add key="Monitor.OpsPortalUrl" value="https://b2bops.corp.local/" />
    <add key="Monitor.FallbackRecipients" value="b2b-support@vanarsdel.com" />
    <add key="Monitor.HeartbeatFile" value="" />
    <add key="BizTalk.MgmtDbServer" value="BTSSQL01" />
    <add key="BizTalk.MgmtDbName" value="BizTalkMgmtDb" />
    <add key="BizTalk.WmiServer" value="BTSAPP01" />
  </appSettings>
  <system.net>
    <mailSettings>
      <smtp from="b2b-monitor@vanarsdel.com" deliveryMethod="Network">
        <network host="smtp.corp.local" port="25" defaultCredentials="false" />
      </smtp>
    </mailSettings>
  </system.net>
  <log4net>
    <appender name="File" type="log4net.Appender.RollingFileAppender">
      <file type="log4net.Util.PatternString" value="%env{B2B_LOG_ROOT}\SlaMonitor\slamonitor.log" />
      <appendToFile value="true" />
      <rollingStyle value="Date" />
      <datePattern value="'.'yyyyMMdd" />
      <maxSizeRollBackups value="60" />
      <layout type="log4net.Layout.PatternLayout">
        <conversionPattern value="%date [%thread] %-5level %logger - %message%newline%exception" />
      </layout>
    </appender>
    <appender name="EventLog" type="log4net.Appender.EventLogAppender">
      <applicationName value="VanArsdel B2B SLA Monitor" />
      <threshold value="ERROR" />
      <layout type="log4net.Layout.PatternLayout">
        <conversionPattern value="%logger - %message%newline%exception" />
      </layout>
    </appender>
    <root>
      <level value="INFO" />
      <appender-ref ref="File" />
      <appender-ref ref="EventLog" />
    </root>
  </log4net>
</configuration>
