<?xml version="1.0" encoding="utf-8"?>
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <connectionStrings>
    <add name="VanArsdelIntegration" connectionString="Data Source=LABSQL01;Initial Catalog=VanArsdelIntegration;Integrated Security=SSPI;Application Name=B2B.Gateway" xdt:Transform="SetAttributes" xdt:Locator="Match(name)" />
    <add name="BAMPrimaryImport" connectionString="Data Source=LABSQL01;Initial Catalog=BAMPrimaryImport;Integrated Security=SSPI;Application Name=B2B.Gateway" xdt:Transform="SetAttributes" xdt:Locator="Match(name)" />
  </connectionStrings>
  <system.serviceModel>
    <behaviors>
      <serviceBehaviors>
        <behavior name="partnerGateway" xdt:Locator="Match(name)">
          <serviceDebug includeExceptionDetailInFaults="true" xdt:Transform="SetAttributes" />
        </behavior>
      </serviceBehaviors>
    </behaviors>
  </system.serviceModel>
</configuration>
