<?xml version="1.0" encoding="utf-8"?>
<!--
  Generated by the BizTalk WCF Service Publishing Wizard (service endpoint only, adapter WCF-BasicHttp) and kept in
  source control. The service is hosted by the BizTalk isolated host BizTalkIsolatedGateway; the receive location
  rl_Gateway_Orders_WCF of receive port rp_Gateway_Orders must be enabled for the .svc to activate.
-->
<configuration>
  <configSections>
    <section name="bizTalkSettings" type="Microsoft.BizTalk.Adapter.Wcf.Runtime.BizTalkSettingsSectionHandler, Microsoft.BizTalk.Adapter.Wcf.Runtime, Version=3.0.1.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" />
  </configSections>
  <bizTalkSettings>
    <mexServiceHostFactory debug="false">
      <receiveLocationMapping>
        <add markupFileName="PartnerOrders.svc" receiveLocationName="rl_Gateway_Orders_WCF" publicBaseAddress="" />
      </receiveLocationMapping>
    </mexServiceHostFactory>
    <webServiceHostFactory debug="false" />
    <isolatedReceiver disable="false" />
    <btsWsdlExporter disable="false" />
  </bizTalkSettings>
  <system.web>
    <authentication mode="Windows" />
    <authorization>
      <allow users="CORP\svc-b2bgateway" />
      <deny users="*" />
    </authorization>
  </system.web>
  <system.webServer>
    <security>
      <authentication>
        <anonymousAuthentication enabled="false" />
        <windowsAuthentication enabled="true" />
      </authentication>
    </security>
  </system.webServer>
</configuration>
