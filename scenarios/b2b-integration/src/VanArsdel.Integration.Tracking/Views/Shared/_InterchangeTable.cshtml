@model IList<VanArsdel.Integration.Domain.Orders.InterchangeRecord>
@{ var now = DateTime.UtcNow; }
<table class="table table-condensed">
    <thead><tr><th>Created</th><th>Partner</th><th>Direction</th><th>Type</th><th>Control #</th><th>Group #</th><th class="text-right">Sets</th><th>Ack</th><th>Ack received / due</th><th>File</th></tr></thead>
    <tbody>
        @foreach (var i in Model)
        {
            <tr>
                <td>@i.CreatedUtc.ToString("yyyy-MM-dd HH:mm")</td>
                <td>@i.PartnerId</td>
                <td>@i.Direction</td>
                <td>@i.TransactionType</td>
                <td>@i.ControlNumber</td>
                <td>@i.GroupControlNumber</td>
                <td class="text-right">@i.TransactionCount</td>
                <td class="@(i.IsAckOverdue(now) ? "overdue" : "")">@(i.IsAckOverdue(now) ? "Overdue" : i.AckStatus.ToString())</td>
                <td>@(i.AckReceivedUtc.HasValue ? i.AckReceivedUtc.Value.ToString("yyyy-MM-dd HH:mm") : i.AckDueUtc.HasValue ? "due " + i.AckDueUtc.Value.ToString("yyyy-MM-dd HH:mm") : "")</td>
                <td><small>@i.FileName</small></td>
            </tr>
        }
        @if (Model.Count == 0) { <tr><td colspan="10" class="text-muted">No interchanges.</td></tr> }
    </tbody>
</table>
