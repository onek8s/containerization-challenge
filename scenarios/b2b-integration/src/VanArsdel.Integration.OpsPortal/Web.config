<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="dataConfiguration" type="Microsoft.Practices.EnterpriseLibrary.Data.Configuration.DatabaseSettings, Microsoft.Practices.EnterpriseLibrary.Data" requirePermission="true" />
    <section name="log4net" type="log4net.Config.Log4NetConfigurationSectionHandler, log4net" />
  </configSections>
  <dataConfiguration defaultDatabase="VanArsdelIntegration" />
  <connectionStrings>
    <!-- the app pool runs as CORP\svc-b2bportal (member of BizTalk Operators); every database is reached with that identity -->
    <add name="VanArsdelIntegration" connectionString="Data Source=BTSSQL01;Initial Catalog=VanArsdelIntegration;Integrated Security=SSPI;Application Name=B2B.OpsPortal" providerName="System.Data.SqlClient" />
    <add name="BizTalkMsgBoxDb" connectionString="Data Source=BTSSQL01;Initial Catalog=BizTalkMsgBoxDb;Integrated Security=SSPI;Application Name=B2B.OpsPortal;Connect Timeout=10" providerName="System.Data.SqlClient" />
  </connectionStrings>
  <appSettings>
    <add key="Portal.Environment" value="PROD" />
    <add key="Portal.TrackingUrl" value="https://b2btracking.corp.local/" />
    <add key="Portal.ApplicationPrefix" value="VanArsdel." />
    <add key="Portal.Group.Viewers" value="CORP\B2B-Viewers" />
    <add key="Portal.Group.Operators" value="CORP\BizTalk Operators" />
    <add key="Portal.Group.Admins" value="CORP\B2B-IntegrationAdmins" />
    <add key="BizTalk.MgmtDbServer" value="BTSSQL01" />
    <add key="BizTalk.MgmtDbName" value="BizTalkMgmtDb" />
    <add key="BizTalk.WmiServer" value="BTSAPP01" />
    <add key="Resubmit.DefaultFolder" value="\\b2bfs01\b2b$\resubmit\default" />
    <add key="Resubmit.Folder.rp_Customer_EDI_AS2" value="\\b2bfs01\b2b$\resubmit\customer-edi" />
    <add key="Resubmit.Folder.rp_Customer_EDI_FILE" value="\\b2bfs01\b2b$\resubmit\customer-edi" />
    <add key="Resubmit.Folder.rp_Supplier_EDI" value="\\b2bfs01\b2b$\resubmit\supplier-edi" />
    <add key="Resubmit.Folder.rp_Gateway_Orders" value="\\b2bfs01\b2b$\resubmit\gateway" />
    <add key="Resubmit.Folder.rp_Erp_IDoc" value="\\b2bfs01\b2b$\resubmit\idoc" />
  </appSettings>
  <system.web>
    <compilation debug="false" targetFramework="4.7.2">
      <assemblies>
        <add assembly="Microsoft.BizTalk.Operations, Version=3.0.1.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" />
        <add assembly="Microsoft.BizTalk.ExplorerOM, Version=3.0.1.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" />
      </assemblies>
    </compilation>
    <httpRuntime targetFramework="4.7.2" enableVersionHeader="false" requestValidationMode="4.5" maxRequestLength="16384" />
    <authentication mode="Windows" />
    <authorization>
      <deny users="?" />
    </authorization>
    <roleManager enabled="true" defaultProvider="AspNetWindowsTokenRoleProvider" />
    <sessionState mode="InProc" timeout="60" cookieSameSite="Lax" />
    <pages controlRenderingCompatibilityVersion="4.0" clientIDMode="AutoID" viewStateEncryptionMode="Always">
      <namespaces>
        <add namespace="System.Linq" />
        <add namespace="VanArsdel.Integration.OpsPortal.Models" />
      </namespaces>
    </pages>
    <customErrors mode="RemoteOnly" defaultRedirect="~/Error.html">
      <error statusCode="403" redirect="~/Forbidden.html" />
    </customErrors>
    <globalization culture="en-GB" uiCulture="en-GB" />
  </system.web>
  <system.webServer>
    <security>
      <authentication>
        <anonymousAuthentication enabled="false" />
        <windowsAuthentication enabled="true" />
      </authentication>
    </security>
    <modules runAllManagedModulesForAllRequests="false" />
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
  <log4net>
    <appender name="File" type="log4net.Appender.RollingFileAppender">
      <!-- B2B_LOG_ROOT is a machine environment variable set by the deployment (Set-B2BEnvironment.ps1) -->
      <file type="log4net.Util.PatternString" value="%env{B2B_LOG_ROOT}\OpsPortal\opsportal.log" />
      <appendToFile value="true" />
      <rollingStyle value="Date" />
      <datePattern value="'.'yyyyMMdd" />
      <maxSizeRollBackups value="60" />
      <layout type="log4net.Layout.PatternLayout">
        <conversionPattern value="%date [%thread] %-5level %logger [%aspnet-request{AUTH_USER}] - %message%newline%exception" />
      </layout>
    </appender>
    <root>
      <level value="INFO" />
      <appender-ref ref="File" />
    </root>
  </log4net>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="Microsoft.Practices.Unity" publicKeyToken="6d32ff45e0ccc69f" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-4.0.0.0" newVersion="4.0.0.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
</configuration>
