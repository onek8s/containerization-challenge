<?xml version="1.0" encoding="utf-8"?>
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <connectionStrings>
    <add name="VanArsdelIntegration" connectionString="Data Source=LABSQL01;Initial Catalog=VanArsdelIntegration;Integrated Security=SSPI;Application Name=B2B.OpsPortal" xdt:Transform="SetAttributes" xdt:Locator="Match(name)" />
    <add name="BizTalkMsgBoxDb" connectionString="Data Source=LABSQL01;Initial Catalog=BizTalkMsgBoxDb;Integrated Security=SSPI;Application Name=B2B.OpsPortal;Connect Timeout=10" xdt:Transform="SetAttributes" xdt:Locator="Match(name)" />
  </connectionStrings>
  <appSettings>
    <add key="Portal.Environment" value="LAB" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
    <add key="Portal.TrackingUrl" value="https://b2btracking.lab.corp.local/" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
    <add key="BizTalk.MgmtDbServer" value="LABSQL01" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
    <add key="BizTalk.WmiServer" value="LABBTS01" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
  </appSettings>
  <system.web>
    <customErrors mode="Off" xdt:Transform="SetAttributes" />
  </system.web>
</configuration>
