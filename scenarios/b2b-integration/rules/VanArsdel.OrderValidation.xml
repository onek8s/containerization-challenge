      <maxexecutionloopdepth>65536</maxexecutionloopdepth>
      <translationduration>3600000</translationduration>
    </configuration>
    <bindings>
      <class ref="OrderFacts" type="VanArsdel.Integration.Rules.OrderFacts" assembly="VanArsdel.Integration.Rules, Version=4.0.0.0, Culture=neutral, PublicKeyToken=7cfedfd825850e71" instance="0" instances="16" selectivity="1" isStatic="False" />
      <class ref="PartnerFacts" type="VanArsdel.Integration.Rules.PartnerFacts" assembly="VanArsdel.Integration.Rules, Version=4.0.0.0, Culture=neutral, PublicKeyToken=7cfedfd825850e71" instance="0" instances="16" selectivity="1" isStatic="False" />
