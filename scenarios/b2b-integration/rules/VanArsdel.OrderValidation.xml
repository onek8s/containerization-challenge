      <then>
        <function><classmember classref="RuleOutcome" member="SetPriority" sideeffects="true"><argument><constant><int>1</int></constant></argument></classmember></function>
        <function><classmember classref="RuleOutcome" member="RuleFired" sideeffects="true"><argument><constant><string>RushOrderType</string></constant></argument></classmember></function>
