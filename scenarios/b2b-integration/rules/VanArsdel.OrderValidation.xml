    <rule name="AfterCutOff" priority="10" active="true">
      <if>
        <compare operator="equal"><lhs><function><classmember classref="CalendarFacts" member="IsAfterCutOff" sideeffects="true" /></function></lhs><rhs><constant><boolean>true</boolean></constant></rhs></compare>
      </if>
      <then>
        <function><classmember classref="RuleOutcome" member="AddNote" sideeffects="true"><argument><constant><string>Received after cut-off, ships next business day</string></constant></argument></classmember></function>
        <function><classmember classref="RuleOutcome" member="RuleFired" sideeffects="true"><argument><constant><string>AfterCutOff</string></constant></argument></classmember></function>
