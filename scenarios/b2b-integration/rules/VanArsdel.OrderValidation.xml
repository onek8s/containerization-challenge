        <function><classmember classref="RuleOutcome" member="RuleFired" sideeffects="true"><argument><constant><string>UnknownShipTo</string></constant></argument></classmember></function>
      </then>
    </rule>
    <rule name="UnknownItem" priority="80" active="true">
      <if>
        <compare operator="equal"><lhs><function><classmember classref="OrderFacts" member="HasUnresolvedItem" sideeffects="true" /></function></lhs><rhs><constant><boolean>true</boolean></constant></rhs></compare>
      </if>
      <then>
        <function><classmember classref="RuleOutcome" member="RequireManualReview" sideeffects="true"><argument><function><classmember classref="OrderFacts" member="UnresolvedItems" sideeffects="true" /></function></argument></classmember></function>
        <function><classmember classref="RuleOutcome" member="RuleFired" sideeffects="true"><argument><constant><string>UnknownItem</string></constant></argument></classmember></function>
      </then>
    </rule>
    <rule name="DefaultShipVia" priority="50" active="true">
      <if>
        <compare operator="not equal"><lhs><function><classmember classref="PartnerFacts" member="get_DefaultShipVia" sideeffects="false" /></function></lhs><rhs><constant><string></string></constant></rhs></compare>
      </if>
      <then>
        <function><classmember classref="RuleOutcome" member="SetShipVia" sideeffects="true"><argument><function><classmember classref="PartnerFacts" member="get_DefaultShipVia" sideeffects="false" /></function></argument></classmember></function>
        <function><classmember classref="RuleOutcome" member="RuleFired" sideeffects="true"><argument><constant><string>DefaultShipVia</string></constant></argument></classmember></function>
      </then>
    </rule>
    <rule name="CreditCheckAboveThreshold" priority="40" active="true">
      <if>
        <and><compare operator="greater than"><lhs><function><classmember classref="PartnerFacts" member="get_CreditCheckThreshold" sideeffects="false" /></function></lhs><rhs><constant><decimal>0</decimal></constant></rhs></compare><compare operator="greater than"><lhs><function><classmember classref="OrderFacts" member="GetOrderValue" sideeffects="true" /></function></lhs><rhs><function><classmember classref="PartnerFacts" member="get_CreditCheckThreshold" sideeffects="false" /></function></rhs></compare></and>
      </if>
      <then>
        <function><classmember classref="RuleOutcome" member="RequireCreditCheck" sideeffects="true" /></function>
        <function><classmember classref="RuleOutcome" member="RuleFired" sideeffects="true"><argument><constant><string>CreditCheckAboveThreshold</string></constant></argument></classmember></function>
      </then>
    </rule>
    <rule name="CableDrum" priority="30" active="true">
      <if>
        <compare operator="equal"><lhs><function><classmember classref="OrderFacts" member="ContainsCableDrum" sideeffects="true" /></function></lhs><rhs><constant><boolean>true</boolean></constant></rhs></compare>
      </if>
      <then>
        <function><classmember classref="RuleOutcome" member="AddNote" sideeffects="true"><argument><constant><string>Cable over 500 m: cut and drum at the cable centre</string></constant></argument></classmember></function>
        <function><classmember classref="RuleOutcome" member="SetPriority" sideeffects="true"><argument><constant><int>2</int></constant></argument></classmember></function>
        <function><classmember classref="RuleOutcome" member="RuleFired" sideeffects="true"><argument><constant><string>CableDrum</string></constant></argument></classmember></function>
      </then>
    </rule>
    <rule name="HazardousGoodsGround" priority="20" active="true">
      <if>
        <compare operator="equal"><lhs><function><classmember classref="OrderFacts" member="ContainsHazardousGoods" sideeffects="true" /></function></lhs><rhs><constant><boolean>true</boolean></constant></rhs></compare>
      </if>
      <then>
        <function><classmember classref="RuleOutcome" member="SetShipVia" sideeffects="true"><argument><constant><string>HAZGND</string></constant></argument></classmember></function>
        <function><classmember classref="RuleOutcome" member="AddNote" sideeffects="true"><argument><constant><string>Hazardous goods: ground transport only</string></constant></argument></classmember></function>
        <function><classmember classref="RuleOutcome" member="RuleFired" sideeffects="true"><argument><constant><string>HazardousGoodsGround</string></constant></argument></classmember></function>
      </then>
    </rule>
    <rule name="HazardousGoodsExport" priority="20" active="true">
      <if>
        <and><compare operator="equal"><lhs><function><classmember classref="OrderFacts" member="ContainsHazardousGoods" sideeffects="true" /></function></lhs><rhs><constant><boolean>true</boolean></constant></rhs></compare><compare operator="equal"><lhs><function><classmember classref="PartnerFacts" member="IsInternational" sideeffects="true" /></function></lhs><rhs><constant><boolean>true</boolean></constant></rhs></compare></and>
      </if>
      <then>
