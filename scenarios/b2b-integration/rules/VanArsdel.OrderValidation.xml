    </bindings>
    <rule name="PartnerInactive" priority="100" active="true">
      <if>
        <compare operator="equal"><lhs><function><classmember classref="PartnerFacts" member="get_Active" sideeffects="false" /></function></lhs><rhs><constant><boolean>false</boolean></constant></rhs></compare>
      </if>
      <then>
        <function><classmember classref="RuleOutcome" member="Reject" sideeffects="true"><argument><constant><string>PARTNER_INACTIVE</string></constant></argument><argument><constant><string>The trading partner is not active.</string></constant></argument></classmember></function>
        <function><classmember classref="RuleOutcome" member="RuleFired" sideeffects="true"><argument><constant><string>PartnerInactive</string></constant></argument></classmember></function>
      </then>
    </rule>
    <rule name="ZeroQuantity" priority="90" active="true">
      <if>
        <compare operator="equal"><lhs><function><classmember classref="OrderFacts" member="HasZeroQuantityLine" sideeffects="true" /></function></lhs><rhs><constant><boolean>true</boolean></constant></rhs></compare>
      </if>
      <then>
        <function><classmember classref="RuleOutcome" member="RejectLine" sideeffects="true"><argument><constant><string>QTY_ZERO</string></constant></argument><argument><constant><string>Line quantity is zero.</string></constant></argument><argument><function><classmember classref="OrderFacts" member="FirstZeroQuantityLine" sideeffects="true" /></function></argument></classmember></function>
        <function><classmember classref="RuleOutcome" member="RuleFired" sideeffects="true"><argument><constant><string>ZeroQuantity</string></constant></argument></classmember></function>
      </then>
    </rule>
    <rule name="DuplicateLineNumbers" priority="90" active="true">
      <if>
        <compare operator="equal"><lhs><function><classmember classref="OrderFacts" member="HasDuplicateLineNumbers" sideeffects="true" /></function></lhs><rhs><constant><boolean>true</boolean></constant></rhs></compare>
      </if>
      <then>
        <function><classmember classref="RuleOutcome" member="Reject" sideeffects="true"><argument><constant><string>LINE_DUPLICATE</string></constant></argument><argument><constant><string>Line numbers are not unique.</string></constant></argument></classmember></function>
        <function><classmember classref="RuleOutcome" member="RuleFired" sideeffects="true"><argument><constant><string>DuplicateLineNumbers</string></constant></argument></classmember></function>
      </then>
    </rule>
    <rule name="UnknownShipTo" priority="80" active="true">
      <if>
        <compare operator="equal"><lhs><function><classmember classref="OrderFacts" member="HasUnresolvedShipTo" sideeffects="true" /></function></lhs><rhs><constant><boolean>true</boolean></constant></rhs></compare>
      </if>
      <then>
