<Project>

  <PropertyGroup>
    <LangVersion>7.3</LangVersion>
    <Company>VanArsdel Distribution</Company>
    <Product>VanArsdel Integration Platform</Product>
    <Version>4.6.2</Version>
    <!-- Bindings, maps' extension XML and BRE vocabularies reference the strong name, so the assembly version stays fixed -->
    <AssemblyVersion>4.0.0.0</AssemblyVersion>
    <FileVersion>4.6.2.0</FileVersion>
    <Copyright>Copyright © VanArsdel Distribution 2012-2019</Copyright>
    <Deterministic>true</Deterministic>
    <!-- BizTalk loads pipeline components, orchestration helpers and maps' external assemblies from the GAC -->
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>$(MSBuildThisFileDirectory)VanArsdel.snk</AssemblyOriginatorKeyFile>
    <NoWarn>$(NoWarn);CS1591;NU1901;NU1902;NU1903;NU1904</NoWarn>
  </PropertyGroup>

  <ItemGroup Condition="$(TargetFramework.StartsWith('net4'))">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

</Project>
