<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="entityFramework" type="System.Data.Entity.Internal.ConfigFile.EntityFrameworkSection, EntityFramework, Version=6.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
  </configSections>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
  </startup>
  <appSettings>
    <add key="HubUrl" value="https://projects.corp.local/sites/hub" />
    <add key="ServiceLogin" value="i:0#.w|corp\svc-ps-sync" />
    <add key="TimesheetWeeks" value="12" />

    <!-- High-trust app principal of the sync service (Register-HighTrustAddIn.ps1 -Name LucerneProjectSync) -->
    <add key="ClientId" value="2e9d4b71-6a3c-4f58-b0e2-7d1c9a5f3b84" />
    <add key="IssuerId" value="a3f1c9e7-5b2d-4f60-8e1a-9c7b5d3e1f20" />
    <add key="Realm" value="" />
    <add key="SigningCertificateThumbprint" value="" />

    <add key="Erp.Endpoint" value="https://erp01.corp.local/ProjectAccounting/ProjectService.svc" />
    <add key="Erp.UserName" value="svc-ps-erp" />
    <add key="Erp.Password" value="" />
    <add key="Hr.BaseUrl" value="https://hr01.corp.local/hrapi" />
    <add key="Hr.ApiKey" value="" />
    <add key="DocControl.BaseUrl" value="https://doccontrol.corp.local" />
    <add key="DocControl.ClientId" value="project-sites" />
    <add key="DocControl.ClientSecret" value="" />

    <add key="SmtpHost" value="smtp.corp.local" />
    <add key="MailFrom" value="project-sites@lucerne-eng.example" />
    <add key="DashboardsUrl" value="https://dashboards.corp.local" />

    <!-- Minutes between runs, 0 = off -->
    <add key="Interval.StaffSync" value="60" />
    <add key="Interval.ProjectSync" value="15" />
    <add key="Interval.TimesheetSync" value="120" />
    <add key="Interval.ApprovalPublish" value="10" />
    <add key="Interval.KpiSnapshot" value="1440" />
    <add key="Interval.StatusDigest" value="1440" />
  </appSettings>
  <connectionStrings>
    <add name="ProjectSitesHub" connectionString="Data Source=sql01.corp.local;Initial Catalog=ProjectSitesHub;User ID=ps_sync;Password=;Encrypt=True;TrustServerCertificate=True;Application Name=Lucerne Project Sync" providerName="System.Data.SqlClient" />
  </connectionStrings>
  <system.net>
    <defaultProxy enabled="false" />
    <connectionManagement>
      <add address="*" maxconnection="12" />
    </connectionManagement>
  </system.net>
  <entityFramework>
    <providers>
      <provider invariantName="System.Data.SqlClient" type="System.Data.Entity.SqlServer.SqlProviderServices, EntityFramework.SqlServer" />
    </providers>
  </entityFramework>
</configuration>
