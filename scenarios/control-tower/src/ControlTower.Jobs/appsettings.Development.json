    "InvoiceExportFolder": "../../.devdata/export/invoices",
    "FuelImportFolder": "../../.devdata/import/fuel",
    "MailCustomerReports": false
  },
  "Smtp": {
    "Host": "localhost"
  },
  "Documents": {
    "Store": "Folder",
    "FolderPath": "../../.devdata/documents"
  }
}
