<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <RootNamespace>Proseware.ControlTower.Events</RootNamespace>
    <AssemblyName>ControlTower.Events</AssemblyName>
    <UserSecretsId>proseware-controltower-events</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="6.0.2" />
    <PackageReference Include="NLog.Extensions.Hosting" Version="1.7.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ControlTower.Domain\ControlTower.Domain.csproj" />
    <ProjectReference Include="..\ControlTower.Data\ControlTower.Data.csproj" />
    <ProjectReference Include="..\ControlTower.Integration\ControlTower.Integration.csproj" />
    <ProjectReference Include="..\ControlTower.Rules\ControlTower.Rules.csproj" />
    <ProjectReference Include="..\ControlTower.Routing\ControlTower.Routing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="nlog.config" CopyToOutputDirectory="PreserveNewest" />
    <None Update="nlog.config" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
