{
  "ConnectionStrings": {
    "Identity": "Server=sql01.corp.local;Database=ControlTowerIdentity;User ID=ct_identity;Password=;Encrypt=True;TrustServerCertificate=False;Application Name=ControlTower.Identity"
  },
  "Database": {
    "Provider": "SqlServer"
  },
  "IdentityServer": {
    "IssuerUri": "https://login.corp.local",
    "SigningCertificateThumbprint": "",
    "RequireStaffTwoFactor": true,
    "ApiScopes": [
      { "Name": "tower.api", "DisplayName": "Control Tower operations API", "UserClaims": [ "role" ] },
      { "Name": "scan.api", "DisplayName": "Terminal scanning API" },
      { "Name": "booking.api", "DisplayName": "Booking API", "UserClaims": [ "role" ] }
    ],
    "ApiResources": [
      { "Name": "tower.api", "Scopes": [ "tower.api" ], "UserClaims": [ "role", "name" ] },
      { "Name": "scan.api", "Scopes": [ "scan.api" ] },
      { "Name": "booking.api", "Scopes": [ "booking.api" ], "UserClaims": [ "role" ] }
    ],
    "Clients": [
      {
        "ClientId": "booking",
        "ClientName": "Booking",
        "AllowedGrantTypes": [ "authorization_code" ],
        "RequirePkce": true,
        "RequireConsent": false,
        "ClientSecrets": [ { "Value": "" } ],
        "RedirectUris": [ "https://booking.corp.local/signin-oidc" ],
        "PostLogoutRedirectUris": [ "https://booking.corp.local/signout-callback-oidc" ],
        "FrontChannelLogoutUri": "https://booking.corp.local/signout-oidc",
        "AllowedScopes": [ "openid", "profile", "email", "roles", "booking.api" ],
        "AllowOfflineAccess": false,
        "AlwaysIncludeUserClaimsInIdToken": true
      },
      {
        "ClientId": "portal",
        "ClientName": "Customer portal",
        "AllowedGrantTypes": [ "authorization_code" ],
        "RequirePkce": true,
        "RequireConsent": false,
        "ClientSecrets": [ { "Value": "" } ],
        "RedirectUris": [ "https://track.corp.local/signin-oidc" ],
        "PostLogoutRedirectUris": [ "https://track.corp.local/signout-callback-oidc" ],
        "FrontChannelLogoutUri": "https://track.corp.local/signout-oidc",
        "AllowedScopes": [ "openid", "profile", "email", "roles", "customer" ],
        "AlwaysIncludeUserClaimsInIdToken": true
      },
      {
        "ClientId": "tower-spa",
        "ClientName": "Control Tower",
        "AllowedGrantTypes": [ "authorization_code" ],
        "RequirePkce": true,
        "RequireClientSecret": false,
        "RequireConsent": false,
        "RedirectUris": [ "https://tower.corp.local/app/callback", "https://tower.corp.local/app/silent-renew.html" ],
        "PostLogoutRedirectUris": [ "https://tower.corp.local/app/" ],
        "AllowedCorsOrigins": [ "https://tower.corp.local" ],
        "AllowedScopes": [ "openid", "profile", "roles", "tower.api" ],
        "AccessTokenLifetime": 3600
      },
      {
        "ClientId": "scanner",
        "ClientName": "Terminal handhelds",
        "AllowedGrantTypes": [ "client_credentials" ],
        "ClientSecrets": [ { "Value": "" } ],
        "AllowedScopes": [ "scan.api" ],
        "AccessTokenLifetime": 28800
      },
      {
        "ClientId": "jobs",
        "ClientName": "Scheduled jobs",
        "AllowedGrantTypes": [ "client_credentials" ],
        "ClientSecrets": [ { "Value": "" } ],
        "AllowedScopes": [ "tower.api", "booking.api" ]
      },
      {
        "ClientId": "carrier-gateway",
        "ClientName": "Carrier gateway",
        "AllowedGrantTypes": [ "client_credentials" ],
        "ClientSecrets": [ { "Value": "" } ],
        "AllowedScopes": [ "tower.api" ]
      }
    ]
  },
  "Smtp": {
    "Host": "smtp.corp.local",
    "Port": 25,
    "From": "Proseware Control Tower <no-reply@proseware-freight.example>"
  },
  "DataProtection": {
    "KeyPath": "D:\\ControlTower\\Keys\\login"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "IdentityServer4": "Information"
    }
  },
  "AllowedHosts": "*"
}
