@page
@model ChangePasswordModel
@{ ViewData["Title"] = "Change password"; }
<div class="login-card">
    <h1 class="h4">Change password</h1>
    @if (Model.Changed) { <div class="alert alert-success">Password changed.</div> }
    <form method="post">
        <div asp-validation-summary="All" class="text-danger small"></div>
        <div class="mb-3"><label asp-for="OldPassword" class="form-label">Current password</label><input asp-for="OldPassword" class="form-control" /></div>
        <div class="mb-3"><label asp-for="NewPassword" class="form-label">New password</label><input asp-for="NewPassword" class="form-control" /></div>
        <div class="mb-3"><label asp-for="ConfirmPassword" class="form-label">Repeat new password</label><input asp-for="ConfirmPassword" class="form-control" /></div>
        <button class="btn btn-primary">Change password</button>
    </form>
</div>
