@page
@model EnableAuthenticatorModel
@{ ViewData["Title"] = "Authenticator app"; }
<h1 class="h4">Set up an authenticator app</h1>
@if (Model.Required)
{
    <div class="alert alert-warning">Staff accounts need an authenticator app. Set it up to continue.</div>
}
@if (Model.RecoveryCodes is not null)
{
    <div class="alert alert-success">Authenticator app is set up. Store these recovery codes in a safe place:</div>
    <div class="row">
        @foreach (var code in Model.RecoveryCodes) { <div class="col-md-3 recovery-code">@code</div> }
    </div>
    @if (Model.ReturnUrl is not null) { <a class="btn btn-primary mt-3" href="@Model.ReturnUrl">Continue</a> }
}
else
{
    <ol>
        <li>Install Microsoft Authenticator or Google Authenticator on your phone.</li>
        <li>Scan the QR code or enter the key <kbd>@Model.SharedKey</kbd>.</li>
        <li>Enter the code shown by the app.</li>
    </ol>
    <img src="@Model.QrCodeDataUri" width="200" height="200" alt="QR code" />
    <form method="post" class="mt-3" style="max-width:300px">
        <input type="hidden" asp-for="ReturnUrl" />
        <input type="hidden" asp-for="Required" />
        <div asp-validation-summary="All" class="text-danger small"></div>
        <input asp-for="Code" class="form-control mb-2" autocomplete="one-time-code" inputmode="numeric" />
        <button class="btn btn-primary">Verify</button>
    </form>
}
