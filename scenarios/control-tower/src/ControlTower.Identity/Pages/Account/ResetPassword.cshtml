@page
@model ResetPasswordModel
@{ ViewData["Title"] = "Choose a new password"; }
<div class="login-card card shadow-sm">
    <div class="card-body">
        <h1 class="h4">Choose a new password</h1>
        @if (Model.Done)
        {
            <p>Your password has been changed. You can now sign in.</p>
        }
        else
        {
            <form method="post">
                <input type="hidden" asp-for="UserId" />
                <input type="hidden" asp-for="Code" />
                <div asp-validation-summary="All" class="text-danger small"></div>
                <div class="mb-3">
                    <label asp-for="Password" class="form-label">New password</label>
                    <input asp-for="Password" class="form-control" autocomplete="new-password" />
                </div>
                <div class="mb-3">
                    <label asp-for="ConfirmPassword" class="form-label">Repeat new password</label>
                    <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                </div>
                <button class="btn btn-primary">Change password</button>
            </form>
        }
    </div>
</div>
