<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net7.0</TargetFramework>
    <RootNamespace>Proseware.ControlTower.Telematics</RootNamespace>
    <AssemblyName>ControlTower.Telematics</AssemblyName>
    <UserSecretsId>proseware-controltower-telematics</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="7.0.1" />
    <PackageReference Include="NLog.Extensions.Hosting" Version="1.7.5" />
    <PackageReference Include="MQTTnet" Version="3.1.2" />
    <PackageReference Include="MQTTnet.Extensions.ManagedClient" Version="3.1.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ControlTower.Domain\ControlTower.Domain.csproj" />
    <ProjectReference Include="..\ControlTower.Data\ControlTower.Data.csproj" />
    <ProjectReference Include="..\ControlTower.Integration\ControlTower.Integration.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="nlog.config" CopyToOutputDirectory="PreserveNewest" />
    <None Update="nlog.config" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
