<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      internalLogLevel="Off"
>

  <variable name="logDir" value="${environment:CONTROLTOWER_LOG_DIR:whenEmpty=D\:/ControlTower/Logs}" />

  <extensions>
    <add assembly="NLog.Extensions.Hosting" />
  </extensions>

  <targets async="true">
    <target xsi:type="File" name="file"
            fileName="${var:logDir}/telematics-${shortdate}.log"
            archiveAboveSize="52428800"
            maxArchiveDays="30"
            layout="${longdate}|${level:uppercase=true}|${logger}|${message}${onexception:inner=|${exception:format=tostring}}" />
    <target xsi:type="Console" name="console" layout="${time} ${level:uppercase=true:padding=-5} ${logger:shortName=true}: ${message} ${exception}" />
  </targets>

  <rules>
    <logger name="Microsoft.*" maxlevel="Info" final="true" />
    <logger name="System.Net.Http.*" maxlevel="Info" final="true" />
    <logger name="*" minlevel="Info" writeTo="file" />
    <logger name="*" minlevel="Info" writeTo="console">
      <filters defaultAction="Log">
        <when condition="'${environment:DOTNET_ENVIRONMENT}' != 'Development' and '${environment:ASPNETCORE_ENVIRONMENT}' != 'Development'" action="Ignore" />
      </filters>
    </logger>
  </rules>
</nlog>
