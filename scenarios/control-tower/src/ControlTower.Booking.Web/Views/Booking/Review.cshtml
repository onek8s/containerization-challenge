@model BookingStepViewModel
@{ ViewData["Title"] = "New booking - confirm"; var d = Model.Draft; }
<partial name="_Steps" model="3" />
<div class="row">
    <div class="col-md-5">
        <dl class="row small">
            <dt class="col-4">Customer</dt><dd class="col-8">@Model.CustomerName @d.CustomerReference</dd>
            <dt class="col-4">Route</dt><dd class="col-8">@Model.OriginText &rarr; @Model.DestinationText</dd>
            <dt class="col-4">Mode / terms</dt><dd class="col-8">@d.Mode, @d.IncotermCode</dd>
            <dt class="col-4">Pickup</dt><dd class="col-8">@d.PickupDate.ToString("yyyy-MM-dd") @d.PickupTime.ToString(@"hh\:mm") (local)</dd>
            <dt class="col-4">Goods</dt><dd class="col-8">@d.GoodsDescription</dd>
            <dt class="col-4">Packages</dt><dd class="col-8">@d.Packages.Sum(p => p.Quantity) pcs, @d.Packages.Sum(p => p.WeightKg * p.Quantity).ToString("0.0") kg@(d.Packages.Any(p => p.HasDangerousGoods) ? ", dangerous goods" : "")</dd>
            @if (d.IsReefer) { <dt class="col-4">Temperature</dt><dd class="col-8">@d.TemperatureMin … @d.TemperatureMax °C</dd> }
        </dl>
    </div>
    <div class="col-md-7">
        <form method="post">
            @if (Model.Quotes.Count == 0)
            {
                <div class="alert alert-warning">No rate card matches this lane. The shipment is booked without charges; pricing adds them later.</div>
            }
            @for (var i = 0; i < Model.Quotes.Count; i++)
            {
                var q = Model.Quotes[i];
                <div class="card mb-2"><div class="card-body py-2">
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="rateCardId" value="@q.RateCardId" id="q@i" @(i == 0 ? "checked" : "") />
                        <label class="form-check-label" for="q@i"><strong>@q.Carrier</strong> &middot; @q.TransitDays days &middot; @q.ChargeableKg kg chargeable &middot; <strong>@q.Total.ToString("N2") @q.Currency</strong></label>
                    </div>
                    <table class="table table-sm small mb-0">@foreach (var l in q.Lines) { <tr><td>@l.Code</td><td>@l.Description</td><td class="text-end">@l.Amount.ToString("N2")</td></tr> }</table>
                </div></div>
            }
            <button class="btn btn-success">Book shipment</button>
        </form>
    </div>
</div>
