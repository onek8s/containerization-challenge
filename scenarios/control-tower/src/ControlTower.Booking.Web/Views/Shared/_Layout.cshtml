<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Booking</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/5.1.3/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <nav class="navbar navbar-expand navbar-dark bg-ct mb-3">
        <div class="container-fluid">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">Proseware Booking</a>
            <ul class="navbar-nav me-auto">
                <li class="nav-item"><a class="nav-link" asp-controller="Shipments" asp-action="Index">Shipments</a></li>
                @if (User.IsInRole("booking") || User.IsInRole("admin"))
                {
                    <li class="nav-item"><a class="nav-link" asp-controller="Booking" asp-action="New">New booking</a></li>
                }
                @if (User.IsInRole("admin"))
                {
                    <li class="nav-item"><a class="nav-link" asp-controller="Customers" asp-action="Index">Customers</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="RateCards" asp-action="Index">Rate cards</a></li>
                }
            </ul>
            <form class="d-flex me-3" method="get" asp-controller="Shipments" asp-action="Index">
                <input class="form-control form-control-sm" name="q" placeholder="Number, reference, SSCC" />
            </form>
            <span class="navbar-text text-white small">@User.Identity?.Name &middot; <a class="text-white" asp-controller="Account" asp-action="SignOutAll">Sign out</a></span>
        </div>
    </nav>
    <main class="container-fluid">
        @if (TempData["Message"] is string message)
        {
            <div class="alert alert-info">@message</div>
        }
        @RenderBody()
    </main>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/5.1.3/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
