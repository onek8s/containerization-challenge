{
  "ConnectionStrings": {
    "ControlTower": "Data Source=../../.devdata/controltower.db"
  },
  "Database": {
    "Provider": "Sqlite"
  },
  "Messaging": {
    "Transport": "InMemory",
    "Environment": "dev"
  },
  "Gateway": {
    "WorkFolder": "../../.devdata/edi",
    "EdiPollSeconds": 15,
    "TrackingPollSeconds": 60,
    "WebhookUrls": "http://localhost:8085"
  },
  "Carriers": {
    "Sftp": {
      "NRDL": { "LocalFolder": "../../.devdata/partners/NRDL", "PrivateKeyFile": null },
      "VNRL": { "LocalFolder": "../../.devdata/partners/VNRL" },
      "OCNX": { "LocalFolder": "../../.devdata/partners/OCNX", "PrivateKeyFile": null },
      "NSFL": { "LocalFolder": "../../.devdata/partners/NSFL" }
    },
    "Api": {
      "BALX": { "Mode": "Simulator" },
      "AFX": { "Mode": "Simulator" },
      "PRCL": { "Mode": "Simulator", "WebhookSecret": "dev-webhook-secret" }
    }
  },
  "Customs": {
    "Mode": "Simulator",
    "StatusPollSeconds": 20,
    "SimulatorReleaseMinutes": 1
  }
}
