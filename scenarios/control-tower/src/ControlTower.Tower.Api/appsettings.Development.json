{
  "ConnectionStrings": {
    "ControlTower": "Data Source=../../.devdata/controltower.db"
  },
  "Database": {
    "Provider": "Sqlite"
  },
  "Messaging": {
    "Transport": "InMemory",
    "Environment": "dev"
  },
  "Authentication": {
    "UseDevelopmentUser": true
  },
  "DataProtection": {
    "KeyFolder": ""
  },
  "Cors": {
    "Origins": [ "http://localhost:5173", "http://localhost:3000" ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  }
}
