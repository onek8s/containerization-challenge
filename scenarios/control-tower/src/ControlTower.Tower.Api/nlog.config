<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      internalLogLevel="Off"
>

  <extensions>
    <add assembly="NLog.Web.AspNetCore" />
  </extensions>

  <variable name="logDirectory" value="${environment:CONTROLTOWER_LOG_DIR:whenEmpty=D\:/ControlTower/Logs}" />

  <targets async="true">
    <target xsi:type="File" name="file"
            fileName="${logDirectory}/tower-${shortdate}.log"
            archiveAboveSize="52428800"
            maxArchiveFiles="30"
            layout="${longdate}|${uppercase:${level}}|${logger:shortName=true}|${aspnet-traceidentifier}|${aspnet-user-identity}|${message} ${exception:format=tostring}" />
    <target xsi:type="Console" name="console" layout="${time}|${level:uppercase=true}|${logger:shortName=true}|${message} ${exception:format=message}" />
  </targets>

  <rules>
    <logger name="Microsoft.*" maxlevel="Info" final="true" />
    <logger name="System.Net.Http.*" maxlevel="Info" final="true" />
    <logger name="*" minlevel="Info" writeTo="file" />
    <logger name="*" minlevel="Info" writeTo="console" />
  </rules>
</nlog>
