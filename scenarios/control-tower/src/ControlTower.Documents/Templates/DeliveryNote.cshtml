@inherits RazorLight.TemplatePage<Proseware.ControlTower.Documents.ShipmentDocumentModel>
@{ var s = Model.Shipment; }
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@Model.Title @s.Number</title>
    @{ await IncludeAsync("_Styles", Model); }
</head>
<body>
    @{ await IncludeAsync("_Header", Model); }
    <table class="grid">
        <tr>
            <td style="width:50%"><span class="box-label">Deliver to</span><strong>@s.ConsigneeName</strong><br />@s.Destination?.DisplayAddress<br />@s.NotifyPhone</td>
            <td><span class="box-label">Customer / reference</span>@s.Customer?.Name<br />@s.CustomerReference</td>
        </tr>
        <tr>
            <td><span class="box-label">Planned delivery</span>@Model.Local(s.PlannedDelivery, s.Destination?.TimeZoneId)</td>
            <td><span class="box-label">Opening hours</span>@s.Destination?.OpensAt.ToString(@"hh\:mm") - @s.Destination?.ClosesAt.ToString(@"hh\:mm")</td>
        </tr>
    </table>
    @{ await IncludeAsync("_Packages", Model); }
    <table class="grid" style="margin-top:10px">
        <tr>
            <td style="width:33%"><span class="box-label">Received in good order (name)</span><div class="signature">@s.PodSignedBy</div></td>
            <td style="width:33%"><span class="box-label">Signature</span><div class="signature"></div></td>
            <td><span class="box-label">Date and time</span><div class="signature">@Model.Local(s.ActualDelivery, s.Destination?.TimeZoneId)</div></td>
        </tr>
    </table>
</body>
</html>
