<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Proseware Freight</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/5.1.3/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.7.1/leaflet.min.css" />
    <link rel="stylesheet" href="~/css/portal.css" asp-append-version="true" />
</head>
<body>
    <nav class="navbar navbar-expand navbar-dark bg-ct mb-3">
        <div class="container">
            <a class="navbar-brand" asp-page="/Index">Proseware Freight</a>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <ul class="navbar-nav me-auto">
                    <li class="nav-item"><a class="nav-link" asp-page="/Index">My shipments</a></li>
                    <li class="nav-item"><a class="nav-link" asp-page="/Book">Book a pickup</a></li>
                </ul>
                <span class="navbar-text text-white small">@User.Identity.Name &middot; <a class="text-white" asp-page="/SignOut">Sign out</a></span>
            }
            else
            {
                <ul class="navbar-nav me-auto"><li class="nav-item"><a class="nav-link" asp-page="/Track">Track a shipment</a></li></ul>
                <a class="btn btn-sm btn-light" asp-page="/Index">Sign in</a>
            }
        </div>
    </nav>
    <main class="container">
        @if (TempData["Message"] is string message) { <div class="alert alert-info">@message</div> }
        @RenderBody()
    </main>
    <footer class="container mt-5 mb-3 small text-muted">Proseware Freight Oy &middot; customer service +358 9 4242 0000</footer>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.7.1/leaflet.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/6.0.1/signalr.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
